<!-- Custom CSS for Sidebar -->
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #f5f7fb;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .sidebar {
        width: 350px;
        height: 100vh;
        background: white;
        box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
        position: fixed;
        left: 0;
        top: 0;
        overflow-y: auto;
        padding: 0;
        margin-top: 80px;
    }

    /* Scrollbar */
    .sidebar::-webkit-scrollbar {
        width: 4px;
    }

    .sidebar::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .sidebar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    /* Logo Section */
    .logo-section {
        padding: 20px 20px 15px 20px;
        background: white;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .logo i {
        color: #4361ee;
        font-size: 24px;
    }

    .logo span {
        font-size: 22px;
        font-weight: 700;
        color: #1e293b;
        letter-spacing: -0.5px;
    }

    /* Search Section */
    .search-section {
        padding: 0 20px 20px 20px;
    }

    .search-box {
        background: #f8fafd;
        border: 1px solid #eef2f6;
        border-radius: 8px;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .search-box i {
        color: #94a3b8;
        font-size: 16px;
    }

    .search-box input {
        border: none;
        background: transparent;
        width: 100%;
        font-size: 14px;
        outline: none;
        color: #1e293b;
    }

    .search-box input::placeholder {
        color: #94a3b8;
    }

    /* Menu Items */
    .menu-items {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .nav-main-item {
        list-style: none;
    }

    .nav-main-link {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        color: #64748b;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.2s;
        position: relative;
        border-left: 3px solid transparent;
        cursor: pointer;
    }

    .nav-main-link i {
        width: 22px;
        font-size: 18px;
        margin-right: 12px;
        color: #94a3b8;
    }

    .nav-main-link:hover {
        background: #f8fafd;
        color: #4361ee;
        border-left-color: #4361ee;
    }

    .nav-main-link:hover i {
        color: #4361ee;
    }

    /* Active State */
    .nav-main-link.active {
        color: #4361ee;
        border-left-color: #4361ee;
    }

    .nav-main-link.active i {
        color: #4361ee;
    }

    /* Submenu */
    .submenu-wrapper {
        background: #f8fafd;
    }

    .nav-sub-item {
        list-style: none;
    }

    .nav-sub-link {
        display: flex;
        align-items: center;
        padding: 10px 20px 10px 54px;
        color: #64748b;
        text-decoration: none;
        font-size: 13px;
        transition: all 0.2s;
        border-left: 3px solid transparent;
        cursor: pointer;
    }

    .nav-sub-link i {
        font-size: 14px;
        width: 18px;
        margin-right: 12px;
        color: #94a3b8;
    }

    .nav-sub-link:hover {
        background: #eef2f6;
        color: #4361ee;
        border-left-color: #4361ee;
    }

    .nav-sub-link:hover i {
        color: #4361ee;
    }

    .nav-sub-link.active {
        color: #4361ee;
        border-left-color: #4361ee;
    }

    .nav-sub-link.active i {
        color: #4361ee;
    }

    /* Chevron Icon - Simple rotation */
    .chevron-icon {
        margin-left: auto;
        font-size: 14px !important;
        width: auto !important;
        transition: transform 0.3s;
    }

    .rotate-chevron {
        transform: rotate(90deg);
    }

    /* Divider */
    .menu-divider, .sidebar-divider {
        height: 1px;
        background: #eef2f6;
        margin: 15px 20px;
        list-style: none;
    }

    /* Badge - hide */
    .menu-badge {
        display: none;
    }

    /* Footer */
    .sidebar-footer {
        border-top: 1px solid #eef2f6;
        padding: 15px 20px;
        margin-top: 10px;
        font-size: 12px;
        color: #94a3b8;
    }

    .sidebar-footer i {
        color: #4361ee;
    }

    /* User Info Card - hide */
    .user-info-card {
        display: none;
    }

    /* Prevent link default behavior */
    .nav-sub-link, .nav-main-link[href] {
        cursor: pointer;
    }

    /* Dark mode styles for sidebar */
    [data-theme="dark"] .sidebar {
        background: #111a2e !important;
        box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3) !important;
    }

    [data-theme="dark"] .logo-section {
        background: #111a2e !important;
    }

    [data-theme="dark"] .logo span {
        color: #e5e7eb !important;
    }

    [data-theme="dark"] .search-box {
        background: #16233d !important;
        border-color: #2a3c61 !important;
    }

    [data-theme="dark"] .search-box input {
        color: #e5e7eb !important;
    }

    [data-theme="dark"] .search-box input::placeholder {
        color: #8ea3c2 !important;
    }

    [data-theme="dark"] .nav-main-link {
        color: #c7d2fe !important;
    }

    [data-theme="dark"] .nav-main-link i {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .nav-main-link:hover {
        background: #16233d !important;
        color: #3b82f6 !important;
        border-left-color: #3b82f6 !important;
    }

    [data-theme="dark"] .nav-main-link:hover i {
        color: #3b82f6 !important;
    }

    [data-theme="dark"] .nav-main-link.active {
        color: #3b82f6 !important;
        border-left-color: #3b82f6 !important;
    }

    [data-theme="dark"] .nav-main-link.active i {
        color: #3b82f6 !important;
    }

    [data-theme="dark"] .submenu-wrapper {
        background: #0d1427 !important;
    }

    [data-theme="dark"] .nav-sub-link {
        color: #c7d2fe !important;
    }

    [data-theme="dark"] .nav-sub-link i {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .nav-sub-link:hover {
        background: #16233d !important;
        color: #3b82f6 !important;
        border-left-color: #3b82f6 !important;
    }

    [data-theme="dark"] .nav-sub-link:hover i {
        color: #3b82f6 !important;
    }

    [data-theme="dark"] .nav-sub-link.active {
        color: #3b82f6 !important;
        border-left-color: #3b82f6 !important;
    }

    [data-theme="dark"] .nav-sub-link.active i {
        color: #3b82f6 !important;
    }

    [data-theme="dark"] .menu-divider,
    [data-theme="dark"] .sidebar-divider {
        background: #253454 !important;
    }

    [data-theme="dark"] .sidebar-footer {
        border-top-color: #253454 !important;
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .sidebar-footer i {
        color: #3b82f6 !important;
    }

    [data-theme="dark"] .sidebar::-webkit-scrollbar-track {
        background: #0d1427 !important;
    }

    [data-theme="dark"] .sidebar::-webkit-scrollbar-thumb {
        background: #253454 !important;
    }
</style>

<!-- Sidebar HTML -->
<div class="sidebar">
    <%
        const perms = (typeof modulePermissions !== 'undefined' && modulePermissions)
            ? modulePermissions
            : {};
        const currentRole = (typeof currentUserRole !== 'undefined' && currentUserRole) ? currentUserRole : 'User';
        const roleKey = String(currentRole || '').trim().toLowerCase();
        const isSuperAdmin = roleKey === 'superadmin';
        const hasAnyPermission = (moduleKey, actions) => {
            const actionList = Array.isArray(actions) && actions.length ? actions : ['view', 'add', 'edit', 'delete'];
            if (typeof canAccessAny === 'function') {
                return canAccessAny(moduleKey, actionList);
            }
            if (isSuperAdmin) return true;
            return actionList.some((action) => Boolean(perms[moduleKey] && perms[moduleKey][action]));
        };
        const hasModuleAccess = (moduleKey) => {
            return hasAnyPermission(moduleKey);
        };
        const hasAccess = (typeof canAccess === 'function')
            ? canAccess
            : ((moduleKey, action) => {
                if (isSuperAdmin) return Boolean(perms[moduleKey] && perms[moduleKey][action || 'view']);
                return Boolean(perms[moduleKey] && perms[moduleKey][action || 'view']);
            });
    %>
