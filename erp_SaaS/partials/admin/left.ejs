<!-- Custom CSS for Sidebar -->
<style>
    :root {
        --sidebar-bg: linear-gradient(180deg, #0a0f1c 0%, #030614 100%);
        --sidebar-hover: rgba(99, 102, 241, 0.15);
        --sidebar-active: linear-gradient(90deg, rgba(99, 102, 241, 0.2) 0%, rgba(99, 102, 241, 0.05) 100%);
        --text-primary: #ffffff;
        --text-secondary: rgba(255, 255, 255, 0.7);
        --accent-color: #6366f1;
        --accent-glow: rgba(99, 102, 241, 0.5);
        --border-color: rgba(255, 255, 255, 0.05);
    }

    body {
        background: #f4f7fc;
        margin: 0;
        padding: 0;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    .sidebar-wrapper {
        height: 100vh;
        background: var(--sidebar-bg);
        border-right: 1px solid rgba(255, 255, 255, 0.03);
        padding: 0;
        position: fixed;
        top: 0;
        left: 0;
        width: 280px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--accent-color) rgba(255, 255, 255, 0.02);
        box-shadow: 10px 0 30px rgba(0, 0, 0, 0.3);
        z-index: 1000;
        transition: all 0.3s ease;
    }

    /* Custom Scrollbar */
    .sidebar-wrapper::-webkit-scrollbar {
        width: 4px;
    }

    .sidebar-wrapper::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.02);
    }

    .sidebar-wrapper::-webkit-scrollbar-thumb {
        background: var(--accent-color);
        border-radius: 10px;
    }

    /* Logo Section - Premium Look */
    .sidebar-logo {
        padding: 25px 20px 20px;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 15px;
        background: rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(10px);
    }

    .sidebar-logo h4 {
        color: #ffffff;
        font-weight: 700;
        font-size: 1.5rem;
        letter-spacing: 0.5px;
        position: relative;
        display: inline-block;
        margin: 0;
        background: linear-gradient(135deg, #ffffff 0%, #a5b4fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .sidebar-logo h4::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 40px;
        height: 3px;
        background: var(--accent-color);
        border-radius: 2px;
        box-shadow: 0 0 10px var(--accent-glow);
    }

    /* User Info Card */
    .user-info-card {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 12px;
        padding: 12px;
        margin-top: 15px;
        backdrop-filter: blur(5px);
    }

    .user-avatar {
        background: linear-gradient(135deg, var(--accent-color), #8b5cf6);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px var(--accent-glow);
    }

    /* Navigation Items */
    .nav-main-item {
        margin-bottom: 2px;
        list-style: none;
    }

    .nav-main-link {
        color: var(--text-secondary) !important;
        padding: 12px 20px !important;
        border-radius: 0;
        margin: 0;
        transition: all 0.3s ease;
        font-weight: 500;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        text-decoration: none;
        cursor: pointer;
        border-left: 3px solid transparent;
        background: transparent;
    }

    .nav-main-link:hover {
        background: var(--sidebar-hover);
        color: #ffffff !important;
        border-left-color: var(--accent-color);
    }

    .nav-main-link i {
        font-size: 1.2rem;
        margin-right: 12px;
        color: var(--accent-color);
        transition: all 0.3s ease;
    }

    .nav-main-link:hover i {
        transform: scale(1.1);
        filter: brightness(1.2);
    }

    /* Submenu */
    .submenu-wrapper {
        padding-left: 0;
        background: rgba(0, 0, 0, 0.2);
    }

    .nav-sub-item {
        margin: 0;
        list-style: none;
    }

    .nav-sub-link {
        color: var(--text-secondary) !important;
        padding: 10px 20px 10px 52px !important;
        border-radius: 0;
        margin: 0;
        transition: all 0.2s ease;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        position: relative;
        text-decoration: none;
        border-left: 3px solid transparent;
    }

    .nav-sub-link::before {
        content: '';
        position: absolute;
        left: 30px;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--text-secondary);
        transition: all 0.2s ease;
    }

    .nav-sub-link:hover {
        background: var(--sidebar-hover);
        color: #ffffff !important;
        border-left-color: var(--accent-color);
    }

    .nav-sub-link:hover::before {
        background: var(--accent-color);
        width: 6px;
        height: 6px;
        box-shadow: 0 0 8px var(--accent-glow);
    }

    .nav-sub-link i {
        font-size: 1rem;
        margin-right: 12px;
        color: var(--accent-color);
        opacity: 0.9;
        width: 20px;
        text-align: center;
    }

    /* Active State */
    .nav-sub-link.active {
        background: var(--sidebar-active);
        color: #ffffff !important;
        border-left: 3px solid var(--accent-color);
        position: relative;
    }

    .nav-sub-link.active::before {
        background: var(--accent-color);
        box-shadow: 0 0 8px var(--accent-glow);
    }

    .nav-sub-link.active i {
        color: #ffffff;
    }

    /* Section Divider */
    .sidebar-divider {
        margin: 15px 20px;
        border-top: 1px solid var(--border-color);
        list-style: none;
        position: relative;
    }

    .sidebar-divider::before {
        content: '●';
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: var(--sidebar-bg);
        color: var(--accent-color);
        font-size: 8px;
        padding: 0 10px;
    }

    /* Collapse Toggle Icon */
    .nav-main-link[data-bs-toggle="collapse"] {
        position: relative;
    }

    .nav-main-link[data-bs-toggle="collapse"]::after {
        content: '\F282';
        font-family: 'bootstrap-icons';
        position: absolute;
        right: 20px;
        font-size: 0.8rem;
        transition: transform 0.3s ease;
        color: var(--text-secondary);
        opacity: 0.7;
    }

    .nav-main-link[data-bs-toggle="collapse"][aria-expanded="true"]::after {
        transform: rotate(180deg);
        color: var(--accent-color);
        opacity: 1;
    }

    /* Badge for notification */
    .menu-badge {
        background: linear-gradient(135deg, var(--accent-color), #8b5cf6);
        color: white;
        font-size: 0.65rem;
        padding: 3px 8px;
        border-radius: 20px;
        margin-left: auto;
        font-weight: 600;
        letter-spacing: 0.3px;
        box-shadow: 0 2px 5px rgba(99, 102, 241, 0.3);
    }

    /* Text colors */
    .text-white-50 {
        color: var(--text-secondary) !important;
    }

    .fw-semibold {
        color: #ffffff !important;
        font-weight: 600;
    }

    /* Footer */
    .sidebar-footer {
        border-top: 1px solid var(--border-color);
        padding: 15px;
        text-align: center;
        margin-top: 20px;
        background: rgba(0, 0, 0, 0.2);
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .sidebar-footer i {
        color: var(--accent-color);
        margin-right: 4px;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .sidebar-wrapper {
            width: 100%;
            height: auto;
            min-height: auto;
            position: relative;
            margin-bottom: 20px;
        }

        .nav-main-link {
            padding: 10px 15px !important;
        }

        .nav-sub-link {
            padding: 8px 15px 8px 45px !important;
        }

        .sidebar-logo {
            padding: 15px 15px 10px;
        }

        .sidebar-logo h4 {
            font-size: 1.2rem;
        }
    }
</style>

