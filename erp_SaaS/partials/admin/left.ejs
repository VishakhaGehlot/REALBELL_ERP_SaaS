<!-- Perfect JavaScript - Dropdown stays open on submenu clicks -->
<script>
    function normalizePath(path) {
        if (!path) return '/';
        var cleanPath = path.split('?')[0].split('#')[0];
        cleanPath = cleanPath.replace(/\/+$/, '');
        return cleanPath === '' ? '/' : cleanPath.toLowerCase();
    }

    function openParentSubmenu(submenuLink) {
        if (!submenuLink) return;
        var submenuWrapper = submenuLink.closest('.submenu-wrapper');
        if (!submenuWrapper) return;

        submenuWrapper.style.display = 'block';
        var parentMainLink = submenuWrapper.previousElementSibling;
        if (parentMainLink) {
            parentMainLink.classList.add('active');
            var chevron = parentMainLink.querySelector('.chevron-icon');
            if (chevron) {
                chevron.classList.add('rotate-chevron');
            }
        }
    }

    // Toggle submenu function - prevents event bubbling
    function toggleSubmenu(event, element) {
        // Stop event propagation to prevent any unwanted closing
        if (event) {
            event.stopPropagation();
        }
        
        // Find the submenu wrapper (next sibling)
        var submenu = element.nextElementSibling;
        
        // Find the chevron icon inside the clicked element
        var chevron = element.querySelector('.chevron-icon');
        
        // Toggle submenu display
        if (submenu.style.display === 'none' || submenu.style.display === '') {
            submenu.style.display = 'block';
            if (chevron) {
                chevron.classList.add('rotate-chevron');
            }
        } else {
            submenu.style.display = 'none';
            if (chevron) {
                chevron.classList.remove('rotate-chevron');
            }
        }
    }
    
    // Handle submenu link clicks - prevents dropdown from closing
    function handleSubmenuClick(event, element) {
        // Stop event from bubbling up to parent elements
        event.stopPropagation();
        
        // Remove active class from all submenu items
        document.querySelectorAll('.nav-sub-link').forEach(link => {
            link.classList.remove('active');
        });
        
        // Add active class to clicked item
        element.classList.add('active');

        // Ensure parent submenu remains open on this page before navigation
        openParentSubmenu(element);
        
        // Here you can add your navigation logic
        // For example: window.location.href = element.getAttribute('href');
        // The link will naturally navigate, but we prevent the dropdown from closing
        console.log('Navigating to:', element.getAttribute('href'));
        
        // Allow the link to work normally
        return true;
    }
    
    // Handle direct links (non-dropdown items)
    function handleDirectLink(event, element) {
        event.stopPropagation();
        
        // Remove active class from all main links
        document.querySelectorAll('.nav-main-link').forEach(link => {
            link.classList.remove('active');
        });
        
        // Add active class to clicked link
        element.classList.add('active');
        
        console.log('Navigating to:', element.getAttribute('href'));
        return true;
    }
    
    // Optional: Close other dropdowns when opening a new one
    function closeOtherDropdowns(currentElement) {
        var allSubmenus = document.querySelectorAll('.submenu-wrapper');
        var currentSubmenu = currentElement.nextElementSibling;
        
        allSubmenus.forEach(function(submenu) {
            if (submenu !== currentSubmenu && submenu.style.display === 'block') {
                submenu.style.display = 'none';
                // Also rotate back the chevron of the parent
                var parentLink = submenu.previousElementSibling;
                if (parentLink) {
                    var chevron = parentLink.querySelector('.chevron-icon');
                    if (chevron) {
                        chevron.classList.remove('rotate-chevron');
                    }
                }
            }
        });
    }
    
    // Enhanced toggle function with auto-close other dropdowns
    window.toggleSubmenuEnhanced = function(event, element) {
        event.stopPropagation();
        closeOtherDropdowns(element);
        toggleSubmenu(event, element);
    };
    
    // Optional: Keep dropdowns open when clicking inside them
    document.addEventListener('click', function(event) {
        // If click is inside a submenu, don't close it
        if (event.target.closest('.submenu-wrapper')) {
            return;
        }
        // If click is on a main nav link, don't auto-close (handled by toggle)
        if (event.target.closest('.nav-main-link')) {
            return;
        }
    });
    
    // Initialize - ensure all submenus are closed by default
    document.querySelectorAll('.submenu-wrapper').forEach(function(submenu) {
        submenu.style.display = 'none';
    });
    
    // Remove any remaining rotate classes from chevrons
    document.querySelectorAll('.chevron-icon').forEach(function(chevron) {
        chevron.classList.remove('rotate-chevron');
    });

    // Keep current page's parent menu open after navigation/reload
    var currentPath = normalizePath(window.location.pathname);
    var matchedLink = null;
    var matchedLength = -1;

    document.querySelectorAll('.nav-sub-link[href]').forEach(function(link) {
        var linkPath = normalizePath(link.getAttribute('href'));
        var isMatch = currentPath === linkPath || (linkPath !== '/' && currentPath.indexOf(linkPath + '/') === 0);

        if (isMatch && linkPath.length > matchedLength) {
            matchedLink = link;
            matchedLength = linkPath.length;
        }
    });

    if (matchedLink) {
        matchedLink.classList.add('active');
        openParentSubmenu(matchedLink);
    }
</script>
