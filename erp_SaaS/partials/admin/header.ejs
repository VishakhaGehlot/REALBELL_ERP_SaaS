<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | REAL ERP SaaS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: #f4f6f9;
            font-family: 'Inter', sans-serif;
        }

        /* Header Styles */
        .erp-header {
            background: linear-gradient(135deg, #0a1428 0%, #1a2b45 100%);
            padding: 0;
            border-bottom: 4px solid #f0b90b;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-container {
            padding: 12px 30px;
        }

        /* Logo Area */
        .logo-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #f0b90b 0%, #d4a017 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(240, 185, 11, 0.3);
            transform: rotate(-5deg);
            transition: transform 0.3s ease;
        }

        .logo-icon:hover {
            transform: rotate(0deg) scale(1.05);
        }

        .logo-icon i {
            font-size: 24px;
            color: #0a1428;
        }

        .logo-text {
            display: flex;
            flex-direction: column;
        }

        .logo-main {
            font-size: 1.8rem;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.5px;
        }

        .logo-main .real {
            color: #ffffff;
        }

        .logo-main .erp {
            color: #f0b90b;
            position: relative;
            display: inline-block;
        }

        .logo-main .erp::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, #f0b90b, transparent);
        }

        .logo-tagline {
            color: #8a9bb5;
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 1px;
            margin-top: 2px;
        }

        /* Badge */
        .admin-badge {
            background: rgba(240, 185, 11, 0.15);
            color: #f0b90b;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            border: 1px solid rgba(240, 185, 11, 0.3);
            margin-left: 15px;
        }

        /* Right Section */
        .header-right {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 25px;
        }

        /* Notification Icon */
        .notification-icon {
            position: relative;
            cursor: pointer;
        }

        .notification-icon i {
            font-size: 1.3rem;
            color: #8a9bb5;
            transition: color 0.3s ease;
        }

        .notification-icon:hover i {
            color: #f0b90b;
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #f0b90b;
            color: #0a1428;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 5px;
            border-radius: 20px;
            min-width: 18px;
            text-align: center;
            border: 2px solid #1a2b45;
        }

        /* User Profile */
        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255,255,255,0.05);
            padding: 6px 15px 6px 6px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .user-profile:hover {
            background: rgba(255,255,255,0.1);
            border-color: rgba(240, 185, 11, 0.3);
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #2a3b55, #1a2b45);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #f0b90b;
        }

        .user-avatar i {
            font-size: 1.2rem;
            color: #f0b90b;
        }

        .user-info {
            display: flex;
            flex-direction: column;
        }

        .user-name {
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
            line-height: 1.3;
        }

        .user-role {
            color: #f0b90b;
            font-size: 0.7rem;
            font-weight: 500;
        }

        /* Logout Button */
        .logout-btn {
            background: transparent;
            border: 1.5px solid rgba(240, 185, 11, 0.3);
            color: #f0b90b;
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .logout-btn:hover {
            background: #f0b90b;
            color: #0a1428;
            border-color: #f0b90b;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(240, 185, 11, 0.3);
        }

        .logout-btn i {
            font-size: 1rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header-container {
                padding: 12px 15px;
            }

            .logo-main {
                font-size: 1.3rem;
            }

            .logo-icon {
                width: 35px;
                height: 35px;
            }

            .logo-icon i {
                font-size: 18px;
            }

            .admin-badge {
                display: none;
            }

            .user-info {
                display: none;
            }

            .user-profile {
                padding: 6px;
            }

            .notification-icon {
                display: none;
            }
        }

        @media (max-width: 480px) {
            .logout-btn span {
                display: none;
            }

            .logout-btn {
                padding: 8px 12px;
            }
        }
    </style>
</head>
<body>

<!-- Enhanced Header Section -->
<section class="erp-header">
    <div class="container-fluid header-container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="logo-wrapper">
                    <div class="logo-icon">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <div class="logo-text">
                        <div class="logo-main">
                            <span class="real">REAL</span>
                            <span class="erp"> ERP</span>
                        </div>
                        <div class="logo-tagline">
                            ENTERPRISE RESOURCE PLANNING
                        </div>
                    </div>
                    <span class="admin-badge">
                        <i class="bi bi-shield-check me-1"></i> ADMIN
                    </span>

                      <span class="admin-badge">
                        <i class="bi bi-shield-check me-1"></i> <%=loginname%>
                    </span>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="header-right">
                    <!-- Notification Bell -->
                    <div class="notification-icon">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge">3</span>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="user-profile" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="user-info">
                            <span class="user-name">John Doe</span>
                            <span class="user-role">Super Admin</span>
                        </div>
                        <i class="bi bi-chevron-down" style="color: #8a9bb5; font-size: 0.8rem;"></i>
                    </div>
                    
                    <!-- Dropdown Menu -->
                    <ul class="dropdown-menu dropdown-menu-end" style="background: #1a2b45; border: 1px solid rgba(240,185,11,0.2);">
                        <li>
                            <a class="dropdown-item" href="/profile" style="color: white; padding: 8px 20px;">
                                <i class="bi bi-person me-2" style="color: #f0b90b;"></i> My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/settings" style="color: white; padding: 8px 20px;">
                                <i class="bi bi-gear me-2" style="color: #f0b90b;"></i> Settings
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/activity" style="color: white; padding: 8px 20px;">
                                <i class="bi bi-activity me-2" style="color: #f0b90b;"></i> Activity Log
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);"></li>
                        <li>
                            <a class="dropdown-item" href="/logout" style="color: #ff6b6b; padding: 8px 20px;">
                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                            </a>
                        </li>
                    </ul>

                    <!-- Logout Button (visible on mobile) -->
                    <a href="/logout" class="logout-btn d-md-none">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                    
                  
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Bootstrap JS (for dropdown) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Your main content will go here -->
<div class="container-fluid px-4 py-4">
    <!-- Page content -->
</div>

</body>
</html>