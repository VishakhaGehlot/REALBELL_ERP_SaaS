<body>

<!-- Enhanced Header Section - White Background -->
<section class="erp-header">
    <div class="header-container">
        <!-- Left Side - Logo Section -->
        <div class="logo-wrapper">
            <div class="logo-icon">
                <i class="bi bi-cpu"></i>
            </div>
            <div class="logo-text">
                <div class="logo-main">
                    <span class="real">REAL</span>
                    <span class="erp"> ERP</span>
                </div>
                <div class="logo-tagline">
                    ENTERPRISE RESOURCE PLANNING
                </div>
            </div>
        </div>
        
        <!-- Right Side - Profile Icon Only (Dynamic) -->
        <div class="header-right">
            <button type="button" class="theme-toggle" id="themeToggle" title="Toggle dark/light mode">
                <i class="bi bi-moon-stars"></i>
            </button>
            <div class="profile-container" style="position: relative;">
                <div class="user-profile" id="profileTrigger">
                    <div class="user-avatar">
                        <div class="avatar-placeholder">
                            <%= userInitial ? userInitial : 'U' %>
                        </div>
                    </div>
                </div>
                
                <!-- Dropdown Menu - Dynamic User Details -->
                <div class="profile-dropdown" id="profileDropdown">
                    <!-- Profile Header with dynamic user details -->
                    <div class="dropdown-profile-header">
                        <div class="dropdown-avatar">
                            <div class="avatar-placeholder">
                                <%= userInitials ? userInitials : 'U' %>
                            </div>
                        </div>
                        <div class="dropdown-user-info">
                            <h6><%= userName ? userName : 'User' %></h6>
                            <p><%= userRole ? userRole : 'User' %></p>
                            <span class="user-email"><%= userEmail ? userEmail : 'user@realerp.com' %></span>
                        </div>
                    </div>
                    
                    <div class="dropdown-items">
                        <a class="dropdown-item" href="/profile">
                            <i class="bi bi-person-circle"></i> My Profile
                        </a>
                        <a class="dropdown-item" href="/change-password">
                            <i class="bi bi-key"></i> Change Password
                        </a>
                       
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item logout-item" href="/logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </div>
                </div>
            </div>

            <!-- Logout Button (visible only on mobile) -->
            <a href="/logout" class="logout-btn d-md-none">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>
        </div>
    </div>
</section>

<!-- Overlay for closing dropdown -->
<div class="dropdown-overlay" id="dropdownOverlay"></div>

<script>
    // Dark / light mode
    const savedTheme = localStorage.getItem("erp-theme") || "light";
    document.documentElement.setAttribute("data-theme", savedTheme);

    const themeToggle = document.getElementById("themeToggle");
    const setThemeIcon = () => {
        const currentTheme = document.documentElement.getAttribute("data-theme") || "light";
        if (themeToggle) {
            themeToggle.innerHTML = currentTheme === "dark"
                ? '<i class="bi bi-sun"></i>'
                : '<i class="bi bi-moon-stars"></i>';
        }
    };
    setThemeIcon();
    if (themeToggle) {
        themeToggle.addEventListener("click", () => {
            const currentTheme = document.documentElement.getAttribute("data-theme") || "light";
            const nextTheme = currentTheme === "dark" ? "light" : "dark";
            document.documentElement.setAttribute("data-theme", nextTheme);
            localStorage.setItem("erp-theme", nextTheme);
            setThemeIcon();
        });
    }

    // Dropdown functionality
    const profileTrigger = document.getElementById('profileTrigger');
    const profileDropdown = document.getElementById('profileDropdown');
    const dropdownOverlay = document.getElementById('dropdownOverlay');
    
    function openDropdown() {
        profileDropdown.classList.add('show');
        dropdownOverlay.classList.add('show');
    }
    
    function closeDropdown() {
        profileDropdown.classList.remove('show');
        dropdownOverlay.classList.remove('show');
    }
    
    // Toggle dropdown on click
    profileTrigger.addEventListener('click', function(e) {
        e.stopPropagation();
        if (profileDropdown.classList.contains('show')) {
            closeDropdown();
        } else {
            openDropdown();
        }
    });
    
    // Close dropdown when clicking outside
    dropdownOverlay.addEventListener('click', function() {
        closeDropdown();
    });
    
    // Prevent dropdown from closing when clicking inside dropdown
    profileDropdown.addEventListener('click', function(e) {
        e.stopPropagation();
    });
    
    // Close dropdown when clicking on any dropdown item
    document.querySelectorAll('.dropdown-item').forEach(item => {
        item.addEventListener('click', function() {
            closeDropdown();
        });
    });

    // Permission-aware UI trimming so hidden actions do not keep showing on old templates.
    document.addEventListener('DOMContentLoaded', function() {
        const currentRole = <%- JSON.stringify(currentUserRole || '') %>;
        if (String(currentRole).toLowerCase() === 'superadmin') {
            return;
        }

        const permissions = <%- JSON.stringify(modulePermissions || {}) %>;
        const path = String(window.location.pathname || '').toLowerCase();

        const moduleMatchers = [
            { key: 'subscription', test: /^\/(plan|addplan|editplan|deleteplan|planstatus|paymentstatus|payment-history|pricingform)(\/|$)/ },
            { key: 'subscription', test: /^\/subscription(\/|$)/ },
            { key: 'crm', test: /^\/addcontact/ },
            { key: 'hrm', test: /^\/(employees|attendance|leave|payroll|addnewemployee|addattendence|addleave|addpayroll)(\/|$)/ },
            { key: 'queryManagement', test: /^\/query/ },
            { key: 'frontendManagement', test: /^\/(faq|account|manage|leadstable|leadsform|leadsedit|leadsstatus|leadsdelete|solution|finance|premium|premiums|feature|swiper|footer)(\/|$)/ },
            { key: 'productManagement', test: /^\/(producttable|addproduct|editproduct|updatestatus|deleteproduct)(\/|$)/ }
        ];

        const moduleKey = (moduleMatchers.find((entry) => entry.test.test(path)) || {}).key;
        if (!moduleKey || !permissions[moduleKey]) {
            return;
        }

        const modulePermissions = permissions[moduleKey] || {};
        const can = (action) => Boolean(modulePermissions[action]);
        const hideElement = (element) => {
            if (!element) return;
            element.style.display = 'none';
            element.setAttribute('data-permission-hidden', '1');
        };

        if (!can('add')) {
            document.querySelectorAll('a[href], button').forEach((element) => {
                const href = String(element.getAttribute('href') || '').toLowerCase();
                const classes = String(element.className || '').toLowerCase();
                const onclick = String(element.getAttribute('onclick') || '').toLowerCase();
                if (
                    href.includes('/add') ||
                    href.includes('form') ||
                    href.includes('new') ||
                    href.includes('action=add') ||
                    classes.includes('btn-add') ||
                    classes.includes('add-btn') ||
                    classes.includes('add-product-btn') ||
                    onclick.includes('action=add')
                ) {
                    hideElement(element);
                }
            });
        }

        if (!can('edit')) {
            document.querySelectorAll('a[href], button, select').forEach((element) => {
                const href = String(element.getAttribute('href') || '').toLowerCase();
                const classes = String(element.className || '').toLowerCase();
                const onclick = String(element.getAttribute('onclick') || '').toLowerCase();

                if (
                    classes.includes('reply-btn') ||
                    classes.includes('action-btn edit') ||
                    classes.includes('btn-edit') ||
                    classes.includes('active-status-select') ||
                    href.includes('edit') ||
                    href.includes('status') ||
                    href.includes('update') ||
                    href.includes('reply') ||
                    href.includes('send') ||
                    onclick.includes('reply') ||
                    onclick.includes('update')
                ) {
                    hideElement(element);
                }
            });

            document.querySelectorAll('a[href*="status"]').forEach((element) => {
                element.removeAttribute('href');
                element.style.pointerEvents = 'none';
                element.style.cursor = 'default';
            });
        }

        if (!can('delete')) {
            document.querySelectorAll('a[href], button, form').forEach((element) => {
                const href = String(element.getAttribute('href') || '').toLowerCase();
                const action = String(element.getAttribute('action') || '').toLowerCase();
                const classes = String(element.className || '').toLowerCase();
                const onclick = String(element.getAttribute('onclick') || '').toLowerCase();

                if (
                    classes.includes('delete') ||
                    href.includes('delete') ||
                    action.includes('delete') ||
                    onclick.includes('delete')
                ) {
                    hideElement(element);
                }
            });
        }

        if (!can('view')) {
            document.querySelectorAll('button').forEach((element) => {
                const onclick = String(element.getAttribute('onclick') || '').toLowerCase();
                const classes = String(element.className || '').toLowerCase();
                if (classes.includes('btn-view') || onclick.includes('view')) {
                    hideElement(element);
                }
            });

            document.querySelectorAll('a[href]').forEach((element) => {
                const href = String(element.getAttribute('href') || '').toLowerCase();
                if (href.includes('export')) {
                    hideElement(element);
                }
            });
        }
    });
</script>

</body>
</html>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
