<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">>

<title>Pricing Plans</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>

body{
    font-family: 'Poppins', sans-serif;
    background: #f5f7fb;
    margin:0;
    padding:0;
    text-align:center;
}

h1{
    margin-top:50px;
    font-size:36px;
    color:#1e3a8a;
}

.container{
    display:flex;
    justify-content:center;
    gap:30px;
    margin:60px auto;
    flex-wrap:wrap;
}

.card{
    background:white;
    padding:30px 25px;
    width:280px;
    border-radius:15px;
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
    transition:all 0.3s ease;
    position:relative;
}

.card:hover{
    transform:translateY(-10px) scale(1.03);
    box-shadow:0 15px 35px rgba(0,0,0,0.15);
}

.card h2{
    color:#1e3a8a;
    margin-bottom:10px;
}

.price{
    font-size:34px;
    font-weight:700;
    color:#2563eb;
    margin:15px 0;
}

ul{
    list-style:none;
    padding:0;
    margin:20px 0;
}

ul li{
    padding:10px 0;
    color:#374151;
    border-bottom:1px solid #eee;
}

button{
    margin-top:20px;
    padding:12px 25px;
    border:none;
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    color:white;
    border-radius:25px;
    cursor:pointer;
    font-weight:500;
    transition:0.3s;
}

button:hover{
    transform:scale(1.05);
    box-shadow:0 5px 15px rgba(37,99,235,0.4);
}

/* Highlight middle card */
.card:nth-child(2){
    border:2px solid #2563eb;
    transform:scale(1.05);
}

.card:nth-child(2)::before{
    content:"Most Popular";
    position:absolute;
    top:-12px;
    right:20px;
    background:#2563eb;
    color:white;
    padding:5px 12px;
    border-radius:20px;
    font-size:12px;
}

</style>
</head>

<body>

<h1>Simple & Transparent Pricing</h1>

<div class="container">

<% Data.forEach((val,k)=>{ %>

<div class="card">

<h2><%= val.title %></h2>

<p class="price">₹<%= val.price %></p>

<ul>
<% val.features.forEach(function(f){ %>
<li>✔ <%= f %></li>
<% }) %>
</ul>

<!-- 🔥 FIXED BUTTON -->
<a href="/pricingForm?planId=<%= val._id %>">Select Plan</a>

</div>

<% }) %>

</div>

</body>
</html>