<%- include('../../partials/admin/header.ejs')%>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f5f7fb;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
        width: 100%;
    }

    .main-wrapper {
        display: flex;
        width: 100%;
        min-height: 100vh;
        position: relative;
        background: #f5f7fb;
    }

    .content-wrapper {
        flex: 1;
        margin-left: 280px;
        width: calc(100% - 280px);
        min-height: 100vh;
        background: #f5f7fb;
        padding: 25px;
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

    .mid-content {
        max-width: 1200px;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .content-wrapper {
            margin-left: 0;
            width: 100%;
            padding: 15px;
        }
    }

    .container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
        padding: 40px;
        animation: fadeIn 0.5s ease;
    }
    
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    h1 {
        color: #333;
        margin-bottom: 30px;
        text-align: center;
        font-size: 2.5em;
        border-bottom: 3px solid #3b82f6;
        padding-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }
    
    .feature-badge {
        background: #3b82f6;
        color: white;
        padding: 5px 15px;
        border-radius: 30px;
        font-size: 0.5em;
        display: inline-block;
        font-weight: normal;
    }
    
    .smtp-info {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 30px;
        border-left: 5px solid #3b82f6;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }
    
    .smtp-info p {
        color: #555;
        margin: 8px 0;
        font-size: 0.95em;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .smtp-info strong {
        color: #333;
        min-width: 100px;
        display: inline-block;
    }
    
    .smtp-info i {
        color: #3b82f6;
        width: 25px;
    }
    
    .form-group {
        margin-bottom: 25px;
    }
    
    label {
        display: block;
        margin-bottom: 10px;
        color: #555;
        font-weight: 600;
        font-size: 0.95em;
    }
    
    label i {
        color: #3b82f6;
        margin-right: 8px;
    }
    
    input, textarea {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 1em;
        transition: all 0.3s ease;
        font-family: inherit;
    }
    
    input:focus, textarea:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    textarea {
        min-height: 150px;
        resize: vertical;
    }
    
    button {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 15px 30px;
        font-size: 1.1em;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        width: 100%;
        transition: all 0.3s ease;
        margin-top: 10px;
    }
    
    button:hover {
        background: #2563eb;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4);
    }
    
    button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }
    
    .btn-back {
        background: #6c757d;
        margin-top: 15px;
    }
    
    .btn-back:hover {
        background: #5a6268;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(108, 117, 125, 0.4);
    }
    
    .alert {
        padding: 15px 20px;
        border-radius: 10px;
        margin-bottom: 25px;
        animation: slideIn 0.5s ease;
        font-weight: 500;
    }
    
    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-left: 5px solid #3b82f6;
    }
    
    .alert-error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-left: 5px solid #3b82f6;
    }
    
    @keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    .server-status {
        text-align: center;
        margin-top: 20px;
        padding: 12px;
        border-radius: 10px;
        font-size: 0.9em;
        background: #f8f9fa;
        transition: all 0.3s ease;
    }
    
    .server-status.success {
        background: #d4edda;
        color: #155724;
    }
    
    .server-status.error {
        background: #f8d7da;
        color: #721c24;
    }
    
    .input-hint {
        font-size: 0.85em;
        color: #999;
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .input-hint i {
        color: #3b82f6;
    }
    
    .recipient-example {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 12px;
        margin-top: 10px;
        font-size: 0.85em;
        color: #666;
        border-left: 3px solid #3b82f6;
    }
    
    .recipient-example code {
        background: white;
        padding: 3px 8px;
        border-radius: 5px;
        color: #3b82f6;
        font-weight: 600;
        font-family: monospace;
    }
    
    .counter {
        display: inline-block;
        background: #3b82f6;
        color: white;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.8em;
        margin-left: 10px;
        transition: all 0.3s ease;
    }
    
    .loading {
        opacity: 0.7;
        cursor: not-allowed;
    }
    
    .char-count {
        text-align: right;
        font-size: 0.8em;
        color: #999;
        margin-top: 5px;
    }
    
    /* Menu Styles */
    .menu {
        display: flex;
        gap: 15px;
        border-bottom: 2px solid #eef2f6;
        padding-bottom: 5px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .menu a {
        text-decoration: none;
        color: #64748b;
        font-weight: 600;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        transition: all 0.3s ease;
        position: relative;
        white-space: nowrap;
    }

    .menu a:hover {
        color: #3b82f6;
        background: #fef9e6;
        border-radius: 12px 12px 0 0;
    }

    .menu a.active {
        color: #3b82f6;
        border-bottom: 3px solid #3b82f6;
        background: #fef9e6;
        border-radius: 12px 12px 0 0;
    }

    .menu a i {
        font-size: 16px;
    }

    /* Dark Mode */
    [data-theme="dark"] .container {
        background: #111a2e;
        border: 1px solid #253454;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
    }

    [data-theme="dark"] h1 {
        color: #e5e7eb !important;
        border-bottom-color: #253454;
    }

    [data-theme="dark"] .smtp-info {
        background: linear-gradient(135deg, #0d1427 0%, #16233d 100%);
        border-left-color: #3b82f6;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    }

    [data-theme="dark"] .smtp-info p {
        color: #cbd5e1 !important;
    }

    [data-theme="dark"] .smtp-info strong {
        color: #f8fafc;
    }

    [data-theme="dark"] label {
        color: #e5e7eb !important;
    }

    [data-theme="dark"] input,
    [data-theme="dark"] textarea {
        background: #16233d !important;
        border-color: #2a3c61 !important;
        color: #e5e7eb !important;
    }

    [data-theme="dark"] input::placeholder,
    [data-theme="dark"] textarea::placeholder {
        color: #8ea3c2 !important;
    }

    [data-theme="dark"] .input-hint,
    [data-theme="dark"] .char-count {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .recipient-example {
        background: #0d1427;
        border-left-color: #3b82f6;
        color: #cbd5e1 !important;
    }

    [data-theme="dark"] .recipient-example code {
        background: #16233d;
        color: #93c5fd;
    }

    [data-theme="dark"] .menu {
        border-bottom-color: #253454;
    }

    [data-theme="dark"] .menu a {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .menu a:hover,
    [data-theme="dark"] .menu a.active {
        color: #60a5fa !important;
        background: #16233d;
    }

    [data-theme="dark"] .alert-success {
        background: rgba(34, 197, 94, 0.14);
        color: #86efac;
        border-color: rgba(34, 197, 94, 0.28);
    }

    [data-theme="dark"] .alert-error {
        background: rgba(239, 68, 68, 0.14);
        color: #fca5a5;
        border-color: rgba(239, 68, 68, 0.28);
    }

    [data-theme="dark"] .server-status {
        background: #0d1427;
        color: #cbd5e1;
        border: 1px solid #253454;
    }

    [data-theme="dark"] .server-status.success {
        background: rgba(34, 197, 94, 0.14);
        color: #86efac;
        border-color: rgba(34, 197, 94, 0.28);
    }

    [data-theme="dark"] .server-status.error {
        background: rgba(239, 68, 68, 0.14);
        color: #fca5a5;
        border-color: rgba(239, 68, 68, 0.28);
    }

    @media (max-width: 576px) {
        .menu {
            flex-direction: column;
            border-bottom: none;
            gap: 5px;
        }
        
        .menu a {
            width: 100%;
            justify-content: center;
            border-radius: 12px !important;
            white-space: normal;
            text-align: center;
        }
        
        .menu a.active {
            border-bottom: none;
            background: #3b82f6;
            color: white;
        }
    }
</style>

<div class="main-wrapper">
    <%- include('../../partials/admin/left.ejs')%>

    <div class="content-wrapper">
        <div class="mid-content">
            <div class="container">
                <h1>
                    📧 Bulk Email Sender
                    <span class="feature-badge">Multiple Recipients</span>
                </h1>
                
                <div id="alertMessage"></div>
                
                <!-- Menu -->
                <div class="menu">
                    <a href="/smtp">
                        <i class="fas fa-envelope"></i>
                        SMTP Settings
                    </a>
                    <a href="/send-email" class="active">
                        <i class="fas fa-paper-plane"></i>
                        Send Email
                    </a>
                </div>
                
                <div class="smtp-info">
                    <p><i>📡</i> <strong>SMTP Server:</strong> <%= config.host %></p>
                    <p><i>🔌</i> <strong>Port:</strong> <%= config.port %></p>
                    <p><i>👤</i> <strong>Account:</strong> <%= config.username %></p>
                    <p><i>✨</i> <strong>Feature:</strong> Send to multiple recipients at once</p>
                </div>
                
                <form id="emailForm">
                    <div class="form-group">
                        <label for="to">
                            <i>📧</i> To Email Address(es):
                            <span class="counter" id="emailCount">0</span>
                        </label>
                        <input type="text" 
                               id="to" 
                               name="to" 
                               placeholder="email1@example.com, email2@example.com, email3@example.com" 
                               required>
                        <div class="input-hint">
                            <i>💡</i> Tip: Separate multiple emails with commas (,) or new lines
                        </div>
                        <div class="recipient-example">
                            <strong>📝 Examples:</strong><br>
                            • Single: <code>user@example.com</code><br>
                            • Multiple: <code>user1@example.com, user2@example.com, user3@example.com</code><br>
                            • Mixed: <code>boss@company.com, team@domain.com, client@gmail.com</code>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="subject">
                            <i>📝</i> Subject:
                        </label>
                        <input type="text" 
                               id="subject" 
                               name="subject" 
                               placeholder="Enter email subject" 
                               required>
                    </div>
                    
                    <div class="form-group">
                        <label for="message">
                            <i>💬</i> Message:
                        </label>
                        <textarea id="message" name="message" placeholder="Type your message here..." required></textarea>
                        <div class="char-count" id="charCount">0 characters</div>
                    </div>
                    
                    <button type="submit" id="submitBtn">
                        ✈️ Send Email to Multiple Recipients
                    </button>
                    <button type="button" class="btn-back" onclick="window.location.href='/smtp'">
                        ⚙️ Back to SMTP Settings
                    </button>
                </form>
                
                <div class="server-status" id="serverStatus">
                    ⚡ Checking SMTP Server Status...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
    const toInput = document.getElementById('to');
    const emailCount = document.getElementById('emailCount');
    const submitBtn = document.getElementById('submitBtn');
    const emailForm = document.getElementById('emailForm');
    const alertDiv = document.getElementById('alertMessage');
    const messageTextarea = document.getElementById('message');
    const charCount = document.getElementById('charCount');
    
    // Update email count
    function updateEmailCount() {
        const emails = toInput.value
            .split(/[,\n;]/)
            .map(email => email.trim())
            .filter(email => email && email.includes('@'));
        
        const count = emails.length;
        emailCount.textContent = count;
        
        if (count > 1) {
            emailCount.style.background = '#3b82f6';
            submitBtn.innerHTML = `✈️ Send Email to ${count} Recipients`;
        } else if (count === 1) {
            emailCount.style.background = '#3b82f6';
            submitBtn.innerHTML = '✈️ Send Email to 1 Recipient';
        } else {
            emailCount.style.background = '#3b82f6';
            submitBtn.innerHTML = '✈️ Send Email to Multiple Recipients';
        }
    }
    
    // Update character count
    function updateCharCount() {
        const count = messageTextarea.value.length;
        charCount.textContent = `${count} characters`;
        if (count > 1000) {
            charCount.style.color = '#dc3545';
        } else if (count > 500) {
            charCount.style.color = '#3b82f6';
        } else {
            charCount.style.color = '#999';
        }
    }
    
    // Show alert message
    function showAlert(message, type) {
        alertDiv.innerHTML = `
            <div class="alert alert-${type}">
                ${type === 'success' ? '✅' : '❌'} ${message}
            </div>
        `;
        setTimeout(() => {
            alertDiv.innerHTML = '';
        }, 5000);
    }
    
    toInput.addEventListener('input', updateEmailCount);
    messageTextarea.addEventListener('input', updateCharCount);
    updateEmailCount();
    updateCharCount();
    
    // Check server status
    fetch('/status')
        .then(response => response.json())
        .then(data => {
            const statusDiv = document.getElementById('serverStatus');
            if (data.status === 'connected') {
                statusDiv.innerHTML = '✅ SMTP Server is connected and ready to send emails';
                statusDiv.className = 'server-status success';
            } else {
                statusDiv.innerHTML = '❌ SMTP Server not connected. Please configure SMTP settings first.';
                statusDiv.className = 'server-status error';
            }
        })
        .catch(() => {
            const statusDiv = document.getElementById('serverStatus');
            statusDiv.innerHTML = '❌ Unable to check server status';
            statusDiv.className = 'server-status error';
        });
    
    // Handle form submission
    emailForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = {
            to: document.getElementById('to').value,
            subject: document.getElementById('subject').value,
            message: document.getElementById('message').value
        };
        
        if (!formData.to || !formData.subject || !formData.message) {
            showAlert('Please fill in all fields', 'error');
            return;
        }
        
        // Validate email addresses
        const emails = formData.to.split(/[,\n;]/).map(e => e.trim()).filter(e => e);
        const invalidEmails = emails.filter(email => !email.includes('@'));
        if (invalidEmails.length > 0) {
            showAlert(`Invalid email address(es): ${invalidEmails.join(', ')}`, 'error');
            return;
        }
        
        submitBtn.classList.add('loading');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ Sending Email... Please wait';
        
        try {
            const response = await fetch('/send-email', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });
            
            const result = await response.json();
            
            if (result.success) {
                showAlert(result.message, 'success');
                emailForm.reset();
                updateEmailCount();
                updateCharCount();
            } else {
                showAlert(result.message, 'error');
            }
        } catch (error) {
            showAlert('Failed to send email: ' + error.message, 'error');
        } finally {
            submitBtn.classList.remove('loading');
            submitBtn.disabled = false;
            updateEmailCount();
        }
    });
    
    // Keyboard shortcut: Ctrl+Enter to send
    messageTextarea.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            e.preventDefault();
            emailForm.dispatchEvent(new Event('submit'));
        }
    });
    
    // Add placeholder animation
    const inputs = document.querySelectorAll('input, textarea');
    inputs.forEach(input => {
        input.addEventListener('focus', function() {
            this.parentElement.style.transform = 'translateX(5px)';
            setTimeout(() => {
                this.parentElement.style.transform = 'translateX(0)';
            }, 200);
        });
    });
</script>
