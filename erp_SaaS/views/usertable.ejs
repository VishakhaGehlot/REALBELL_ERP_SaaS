<%- include('../partials/admin/header.ejs')%>

    <section>
        <div class="container-fluid">
            <div class="row">
                <%- include('../partials/admin/left.ejs')%>
                <div class="col-md-9">
                    <h1>user Table</h1>
                  <a href="/userform"><button class="btn btn-dark">Add  role</button></a>
                 <table class="table table-hover">
              <tr>
               <th>SR. No.</th>
               <th>firstName</th>
               <th>lastName</th>
               <th>Email</th>
                
                <th>role</th>
                <th>update</th>

              </tr>

                 <% userdata.forEach((val,k)=>{ %>
                     <tr>
                  <td><%= k+1 %></td>
                <td><%= val.firstName %></td>
                  <td><%= val.lastName %></td>
                  <td><%= val.email %></td>

                 

                  <td>
                      <form method="POST" action="/userrole/<%= val._id %>">
                          <select name="role" class="form-control">
                <option value="User" <%= val.role=="User"?"selected":"" %>>User</option>
                <option value="Admin" <%= val.role=="Admin"?"selected":"" %>>Admin</option>
                <option value="SuperAdmin" <%= val.role=="SuperAdmin"?"selected":"" %>>SuperAdmin</option>
                <option value="teacher" <%= val.role=="teacher"?"selected":"" %>>Teacher</option>
            </select>
                </td>
        
                   <td>
                      <button class="btn btn-primary btn-sm mt-1">Update</button>
              </form>
                  </td>

                 </tr>
              <% }) %>
                   </table>
                </div>

            </div>
        </div>
    </section>
</body>
</html>