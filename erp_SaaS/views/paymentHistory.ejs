<%- include('../partials/admin/header.ejs') %>
<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f5f7fb;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    overflow-x: hidden;
    width: 100%;
}

.main-wrapper {
    display: flex;
    width: 100%;
    min-height: 100vh;
    position: relative;
}

.main-wrapper .sidebar {
    width: 280px;
    height: 100vh;
    background: white;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
    position: fixed;
    left: 0;
    top: 0;
    overflow-y: auto;
    padding: 0;
    z-index: 100;
}

.content-wrapper {
    flex: 1;
    margin-left: 280px;
    width: calc(100% - 280px);
    min-height: 100vh;
    background: #f5f7fb;
    padding: 25px;
    box-sizing: border-box;
}

.page-shell {
    max-width: 1360px;
    margin: 0 auto;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 14px;
}

.page-title h2 {
    color: #1e293b;
    font-weight: 800;
    margin: 0;
    font-size: 30px;
    display: flex;
    align-items: center;
    gap: 11px;
}

.page-title h2 i {
    color: #2563eb;
    font-size: 32px;
}

.page-title p {
    color: #64748b;
    font-size: 14px;
    margin: 6px 0 0;
}

.btn-nav {
    background: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    padding: 10px 16px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.btn-nav:hover {
    border-color: #2563eb;
    color: #2563eb;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 20px;
}

.stat-card,
.card-panel {
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
}

.stat-card {
    padding: 14px;
    border-left: 4px solid transparent;
}

.stat-card.total { border-left-color: #8b5cf6; }
.stat-card.shown { border-left-color: #0f766e; }
.stat-card.paid { border-left-color: #10b981; }
.stat-card.pending { border-left-color: #f59e0b; }
.stat-card.failed { border-left-color: #ef4444; }
.stat-card.collected { border-left-color: #2563eb; }

.stat-label {
    color: #64748b;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    margin: 0;
}

.stat-value {
    margin: 8px 0 0;
    color: #1e293b;
    font-size: 24px;
    font-weight: 800;
}

.stat-note {
    margin-top: 5px;
    color: #64748b;
    font-size: 11px;
}

.filter-panel {
    margin-bottom: 20px;
}

.filter-body {
    padding: 18px;
}

.filter-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr auto;
    gap: 12px;
    align-items: end;
}

.form-label {
    display: block;
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    margin-bottom: 7px;
}

.form-control,
.form-select {
    width: 100%;
    min-height: 44px;
    border-radius: 10px;
    border: 1px solid #dbe3ee;
    box-shadow: none !important;
    font-size: 14px;
}

.form-control:focus,
.form-select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
}

.filter-actions {
    display: flex;
    gap: 8px;
}

.filter-actions .btn {
    min-height: 44px;
    border-radius: 10px;
    font-weight: 700;
}

.table-head {
    padding: 18px 20px;
    border-bottom: 1px solid #e2e8f0;
    background: #f8fafc;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.table-head .title {
    color: #1e293b;
    font-size: 16px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 9px;
}

.table-head .title i {
    color: #2563eb;
}

.table-wrap {
    overflow: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1260px;
}

.data-table th {
    background: #f8fafc;
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

.data-table td {
    padding: 14px;
    border-bottom: 1px solid #eef2f7;
    color: #1e293b;
    font-size: 14px;
    vertical-align: top;
}

.txn-id {
    font-weight: 800;
    color: #0f172a;
}

.meta-sub {
    display: block;
    margin-top: 4px;
    color: #64748b;
    font-size: 12px;
}

.amount-text {
    font-weight: 800;
}

.badge-soft {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
}

.badge-paid { background: #dcfce7; color: #166534; }
.badge-pending { background: #fef3c7; color: #92400e; }
.badge-failed { background: #fee2e2; color: #991b1b; }
.badge-active { background: #dcfce7; color: #166534; }
.badge-cancelled { background: #fee2e2; color: #991b1b; }
.badge-subpending { background: #fef3c7; color: #92400e; }

.inline-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 700;
    color: #2563eb;
}

.inline-link:hover {
    color: #1d4ed8;
}

.empty-state {
    text-align: center;
    padding: 52px 20px;
    color: #64748b;
}

.empty-state i {
    font-size: 46px;
    display: block;
    margin-bottom: 12px;
    opacity: 0.45;
}

@media (max-width: 1300px) {
    .stats-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 992px) {
    .main-wrapper {
        flex-direction: column;
    }

    .main-wrapper .sidebar {
        width: 100%;
        height: auto;
        position: relative;
    }

    .content-wrapper {
        margin-left: 0;
        width: 100%;
        padding: 16px;
    }

    .filter-grid {
        grid-template-columns: 1fr;
    }

    .filter-actions {
        width: 100%;
    }

    .filter-actions .btn {
        flex: 1;
    }
}

@media (max-width: 680px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="main-wrapper">
    <%- include('../partials/admin/left.ejs') %>

    <main class="content-wrapper">
        <div class="page-shell">
            <div class="page-header">
                <div class="page-title">
                    <h2><i class="bi bi-clock-history"></i> Payment History</h2>
                    <p>Track all payment attempts, statuses, methods, and subscription state in one professional register.</p>
                </div>
                <a href="/invoices" class="btn-nav"><i class="bi bi-receipt"></i> Invoice Center</a>
            </div>

            <div class="stats-grid">
                <div class="stat-card total"><p class="stat-label">Transactions</p><h3 class="stat-value"><%= stats.totalTransactions %></h3></div>
                <div class="stat-card shown"><p class="stat-label">Showing</p><h3 class="stat-value"><%= stats.shownTransactions %></h3></div>
                <div class="stat-card paid"><p class="stat-label">Paid</p><h3 class="stat-value"><%= stats.paidCount %></h3></div>
                <div class="stat-card pending"><p class="stat-label">Pending</p><h3 class="stat-value"><%= stats.pendingCount %></h3></div>
                <div class="stat-card failed"><p class="stat-label">Failed</p><h3 class="stat-value"><%= stats.failedCount %></h3></div>
                <div class="stat-card collected"><p class="stat-label">Collected</p><h3 class="stat-value">Rs. <%= Number(stats.totalCollected || 0).toFixed(2) %></h3><p class="stat-note">Pending Rs. <%= Number(stats.pendingAmount || 0).toFixed(2) %></p></div>
            </div>

            <section class="card-panel filter-panel">
                <div class="filter-body">
                    <form method="GET" action="/payment-history" class="filter-grid">
                        <div>
                            <label class="form-label">Search</label>
                            <input type="text" class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Txn ID, customer, plan, method">
                        </div>
                        <div>
                            <label class="form-label">Payment Status</label>
                            <select class="form-select" name="status">
                                <option value="">All Status</option>
                                <% (statusOptions || []).forEach(function(status) { %>
                                    <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Payment Method</label>
                            <select class="form-select" name="method">
                                <option value="">All Methods</option>
                                <% (methodOptions || []).forEach(function(method) { %>
                                    <option value="<%= method %>" <%= filters.method === method ? 'selected' : '' %>><%= method %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="filter-actions">
                            <button class="btn btn-primary" type="submit">Apply</button>
                            <a href="/payment-history" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </form>
                </div>
            </section>

            <section class="card-panel">
                <div class="table-head">
                    <span class="title"><i class="bi bi-table"></i> Transaction Register</span>
                    <small class="text-muted">All payment statuses included</small>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction ID</th>
                                <th>Customer</th>
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Payment</th>
                                <th>Subscription</th>
                                <th>Invoice</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (paymentHistory.length) { %>
                                <% paymentHistory.forEach(function(record) { %>
                                    <tr>
                                        <td><%= new Date(record.transactionAt).toLocaleDateString('en-IN') %></td>
                                        <td>
                                            <span class="txn-id"><%= record.transactionId %></span>
                                            <span class="meta-sub">Order: <%= record.razorpayOrderId || 'N/A' %></span>
                                        </td>
                                        <td>
                                            <strong><%= record.customerName %></strong>
                                            <span class="meta-sub"><%= record.customerEmail || 'No email' %></span>
                                        </td>
                                        <td>
                                            <strong><%= record.planName || 'N/A' %></strong>
                                            <span class="meta-sub">Plan Price Source</span>
                                        </td>
                                        <td class="amount-text">Rs. <%= Number(record.amount || 0).toFixed(2) %></td>
                                        <td><%= record.paymentMethod %></td>
                                        <td>
                                            <span class="badge-soft <%= record.paymentStatus === 'Paid' ? 'badge-paid' : (record.paymentStatus === 'Failed' ? 'badge-failed' : 'badge-pending') %>">
                                                <i class="bi <%= record.paymentStatus === 'Paid' ? 'bi-check-circle' : (record.paymentStatus === 'Failed' ? 'bi-x-circle' : 'bi-hourglass-split') %>"></i>
                                                <%= record.paymentStatus %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge-soft <%= record.subscriptionStatus === 'Active' ? 'badge-active' : (record.subscriptionStatus === 'Cancelled' ? 'badge-cancelled' : 'badge-subpending') %>">
                                                <i class="bi <%= record.subscriptionStatus === 'Active' ? 'bi-check-circle' : (record.subscriptionStatus === 'Cancelled' ? 'bi-x-circle' : 'bi-hourglass-split') %>"></i>
                                                <%= record.subscriptionStatus || 'Pending' %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (record.paymentStatus === 'Paid') { %>
                                                <a class="inline-link" href="/invoices?q=<%= encodeURIComponent(record.transactionId) %>"><i class="bi bi-receipt"></i>View</a>
                                            <% } else { %>
                                                <span class="text-muted">Not generated</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="9">
                                        <div class="empty-state">
                                            <i class="bi bi-clock-history"></i>
                                            <h5>No payment records found</h5>
                                            <p>Try changing filters or complete a payment to populate history.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
</div>