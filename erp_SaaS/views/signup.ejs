<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign Up | REAL ERP</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
background: linear-gradient(135deg,#2753a0 0%,#1a2b4a 100%);
height:100vh;
overflow:hidden;
display:flex;
align-items:center;
justify-content:center;
font-family:'Poppins','Segoe UI',sans-serif;
padding:15px;
}

.login-wrapper{
width:100%;
max-width:1200px;
height:calc(100vh - 30px);
background:white;
border-radius:30px;
box-shadow:0 30px 60px rgba(0,0,0,0.3);
overflow:hidden;
}

.row{
margin:0;
height:100%;
}

.welcome-section,
.login-section{
height:100%;
}

/* LEFT SAME */
.welcome-section{
background: linear-gradient(145deg,#0f1c33,#1e3a5f);
padding:60px 40px;
color:white;
display:flex;
flex-direction:column;
justify-content:center;
position:relative;
overflow:hidden;
}

.welcome-section::before{
content:'';
position:absolute;
top:-50%;
right:-50%;
width:200%;
height:200%;
background: radial-gradient(circle,rgba(212,160,23,0.1) 0%,transparent 70%);
animation: rotate 20s linear infinite;
}

@keyframes rotate{
from{transform:rotate(0deg);}
to{transform:rotate(360deg);}
}

.welcome-content{position:relative;z-index:1;}

.welcome-badge{
background:rgba(212,160,23,0.2);
color:#d4a017;
padding:8px 16px;
border-radius:30px;
font-size:14px;
font-weight:600;
display:inline-block;
margin-bottom:25px;
border:1px solid rgba(212,160,23,0.3);
}

.welcome-section h1{
font-size:48px;
font-weight:700;
margin-bottom:20px;
}

.welcome-section h1 span{
color:#d4a017;
display:block;
font-size:36px;
margin-top:10px;
}

.welcome-section p{
color:#cbd5e0;
margin-bottom:30px;
}

.feature-list{list-style:none;}

.feature-list li{
display:flex;
gap:15px;
margin-bottom:20px;
}

.feature-list i{
width:30px;height:30px;
background:rgba(212,160,23,0.2);
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
color:#d4a017;
}

/* RIGHT CENTER FIX */
.login-section{
padding:50px;
display:flex;
flex-direction:column;
justify-content:center;   /* ✅ vertical center */
align-items:center;       /* ✅ horizontal center */
}

/* limit width so center looks clean */
.login-section form,
.brand,
.login-header,
.signup-link{
width:100%;
max-width:380px;
}

/* TEXT */
.brand h2{font-size:28px;font-weight:700;}
.brand span{color:#d4a017;}
.brand p{font-size:12px;letter-spacing:2px;}

.login-header{margin-bottom:20px;}

.form-group{margin-bottom:18px;}

.input-group{position:relative;}

.input-icon{
position:absolute;
left:15px;
top:50%;
transform:translateY(-50%);
color:#d4a017;
}

.form-control{
padding:12px 15px 12px 40px;
border:2px solid #e2e8f0;
border-radius:12px;
}

.btn-login{
width:100%;
background:#d4a017;
border:none;
padding:14px;
border-radius:12px;
font-weight:700;
display:flex;
justify-content:center;
gap:10px;
}

.signup-link{
text-align:center;
margin-top:15px;
}

.signup-link a{
color:#d4a017;
text-decoration:none;
font-weight:600;
}

/* MOBILE */
@media(max-width:768px){
body{overflow:auto;height:auto;}
.login-wrapper{height:auto;}
}
</style>
</head>

<body>

<div class="login-wrapper">
<div class="row g-0">

<!-- LEFT SAME -->
<div class="col-md-6">
<div class="welcome-section">
<div class="welcome-content">

<div class="welcome-badge">
<i class="bi bi-stars me-2"></i>WELCOME TO REAL ERP
</div>

<h1>Create a new account<span>Sign Up</span></h1>

<p>Welcome to your dashboard! Manage your tasks efficiently and explore all features in one place.</p>

<ul class="feature-list">
<li><i class="bi bi-check-lg"></i> Manage your business operations with ease</li>
<li><i class="bi bi-check-lg"></i> Access real-time insights</li>
<li><i class="bi bi-check-lg"></i> Secure & scalable platform</li>
</ul>

</div>
</div>
</div>

<!-- RIGHT -->
<div class="col-md-6">
<div class="login-section">

<div class="brand">
<h2><span>REAL</span> ERP</h2>
<p>SAAS PLATFORM</p>
</div>

<div class="login-header">
<h3>Create Account</h3>
<p>Register to get started</p>
</div>

<form method="post" action="/register">

<div class="form-group">
<div class="input-group">
<i class="bi bi-person input-icon"></i>
<input type="text" class="form-control" name="firstname" placeholder="First Name" required>
</div>
</div>

<div class="form-group">
<div class="input-group">
<i class="bi bi-person input-icon"></i>
<input type="text" class="form-control" name="lastname" placeholder="Last Name" required>
</div>
</div>

<div class="form-group">
<div class="input-group">
<i class="bi bi-envelope-fill input-icon"></i>
<input type="email" class="form-control" name="email" placeholder="Email Address" required>
</div>
</div>

<div class="form-group">
<div class="input-group">
<i class="bi bi-lock-fill input-icon"></i>
<input type="password" class="form-control" name="password" placeholder="Password" required>
</div>
</div>

<button type="submit" class="btn-login">
<i class="bi bi-person-plus"></i> SIGN UP
</button>

</form>

<div class="signup-link">
Already have an account?
<a href="/login">Login</a>
</div>

</div>
</div>

</div>
</div>

</body>
</html>