<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
      <link rel="stylesheet" href="css/style.css">
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">

</head>
<body>
    <section id="register">
        <div class="container">
            <div class="row">
                <div class="col-md-4"></div>

                <div class="col-md-4">
                    <h1 class="text-center mb-4">Sign Up Here!!</h1>
                    <p><%=mess%></p>
                    <form method="post">
                        <label>First Name</label>
                        <input type="text" class="form-control mb-2" name="firstname" placeholder="Enter first name" />
                        <label>Last Name</label>
                        <input type="text" class="form-control mb-2" name="lastname" placeholder="Enter last name" />

                        <label>Email</label>
                        <input type="email" class="form-control mb-2" name="email" placeholder="Enter email" />
                        <label>Password</label>
                        <input type="password" class="form-control mb-2" name="password" placeholder="Enter password" />

                        <button type="submit" class="form-control btn btn-primary">
                            Register
                        </button>
                    </form>

                    <p class="text-center mt-3">
                        Already have an account?
                        <a href="/login">Login Here</a>

                    </p>
                </div>

                <div class="col-md-4"></div>
            </div>
        </div>
    </section>
</body>


</html>