<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Account</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <section class="mt-5">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-4"></div>

                <div class="col-md-4">
                    <h2 class="mb-3">Change Password</h2>
             <!--                         //Agar mess empty hoga toh blank space aayega. Aur styling bhi nahi hai. -->
             <% if (mess) { %>  
             <div class="alert alert-danger text-center">
                  <%= mess %>
                 </div>
             <% } %>
                   <form method="post">
                     <label class="form-label">Password</label>
                    <input type="password" class="form-control" name="newpassword" required/>
                    <label class="form-label">confirm Password</label>
                    <input type="password" class="form-control" name="conpassword" required/>
                    <button type="submit" class="form-control btn btn-primary mt-3">Password Change</button>
                   </form>

                </div>

                <div class="col-md-4"></div>
            </div>
        </div>
    </section>
</body>
</html>