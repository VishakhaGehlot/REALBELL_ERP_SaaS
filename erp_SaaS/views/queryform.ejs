<%- include('../partials/admin/header.ejs')%>

    <section>
        <div class="container-fluid">
            <div class="row">
                <%- include('../partials/admin/left.ejs')%>
                <div class="col-md-9">
                    <h1>Query Form</h1>
                    <form method="post">
                        <label>From</label>
                        <input type="text" class="form-control" name="from" value="<%=email%>"/>
                        <label>To</label>
                        <input type="text" class="form-control" name="to" value="swatis8102@gmail.com"/>
                        <label>Subject</label>
                        <input type="text" class="form-control" name="subject" value="<%=message%>"/>
                        <label>Message</label>
                        <input type="text" class="form-control" name="message"/>
                        <button class="form-control btn btn-primary mt-2">+ Add query</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</body>
</html>