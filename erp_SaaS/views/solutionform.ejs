<%- include('../partials/admin/header.ejs')%>

    <section>
        <div class="container-fluid">
            <div class="row">
                <%- include('../partials/admin/left.ejs')%>
                <div class="col-md-9">
                    <h1>Manage solution form</h1>
                    <form method="post" enctype="multipart/form-data">
                        <label>Title</label>
                        <input type="text" class="form-control" name="title"/>
                        <label>Description</label>
                        <input type="text" class="form-control" name="desc"/>
                        <label>More Description</label>
                        <input type="text" class="form-control" name="mdesc"/>
                        <label for="">Image</label>
                        <input type="file" name="img" id="" class="form-control mt-3">
                        <button class="form-control btn btn-primary mt-2">+ Add solution</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</body>
</html>