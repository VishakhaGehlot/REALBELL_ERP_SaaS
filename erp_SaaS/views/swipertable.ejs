<%- include('../partials/admin/header.ejs')%>

    <section>
        <div class="container-fluid">
            <div class="row">
                <%- include('../partials/admin/left.ejs')%>
                <div class="col-md-9">
                    <h1>Manage leads and deals Table</h1>
                    <a href="/swiperform"><button class="btn btn-dark">Add image</button></a>
                    <table class="table table-hover">
                        <tr>
                            <th>SR. No.</th>
                           
                            <th>Image</th>
                            <th>Status</th>
                            <th>Delete</th>
                        </tr>
                        <%swiperdata.forEach((val,k)=>{%>
                            <tr>
                        <td><%=k+1%></td>
                       
                        <td><img src="/upload/<%=val.img%>" alt="" width="100px"></td>
                        <td ><a href="/swiperstatus/<%=val.id%>/<%=val.status%>"><button class="btn btn-success"><%=val.status%></button></a></td>
                        <td><a href="/swiperdelete/<%=val.id%>"><button class="btn btn-danger">Delete</button></a></td>
                       </tr>
                       <% })%>
                      
                    </table>
                </div>

            </div>
        </div>
    </section>
</body>
</html>