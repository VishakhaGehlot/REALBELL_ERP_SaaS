<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SMTP Email Sender - Multiple Recipients</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 700px;
            padding: 40px;
            animation: fadeIn 0.5s ease;
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        h1 {
            color: #333;
            margin-bottom: 30px;
            text-align: center;
            font-size: 2.5em;
            border-bottom: 3px solid #667eea;
            padding-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }
        
        .feature-badge {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 5px 15px;
            border-radius: 30px;
            font-size: 0.5em;
            display: inline-block;
            font-weight: normal;
        }
        
        .smtp-info {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
            border-left: 5px solid #667eea;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        
        .smtp-info p {
            color: #555;
            margin: 8px 0;
            font-size: 0.95em;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .smtp-info strong {
            color: #333;
            min-width: 100px;
            display: inline-block;
        }
        
        .smtp-info i {
            color: #667eea;
            width: 25px;
        }
        
        .form-group {
            margin-bottom: 25px;
        }
        
        label {
            display: block;
            margin-bottom: 10px;
            color: #555;
            font-weight: 600;
            font-size: 0.95em;
        }
        
        label i {
            color: #667eea;
            margin-right: 8px;
        }
        
        input, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 1em;
            transition: all 0.3s ease;
            font-family: inherit;
        }
        
        input:focus, textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        textarea {
            min-height: 150px;
            resize: vertical;
        }
        
        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 1.1em;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            margin-top: 10px;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }
        
        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        
        .btn-back {
            background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
            margin-top: 15px;
        }
        
        .btn-back:hover {
            background: linear-gradient(135deg, #5a6268 0%, #495057 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(108, 117, 125, 0.4);
        }
        
        .alert {
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 25px;
            animation: slideIn 0.5s ease;
            font-weight: 500;
        }
        
        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            border-left: 5px solid #28a745;
        }
        
        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-left: 5px solid #dc3545;
        }
        
        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        
        .server-status {
            text-align: center;
            margin-top: 20px;
            padding: 12px;
            border-radius: 10px;
            font-size: 0.9em;
            background: #f8f9fa;
            transition: all 0.3s ease;
        }
        
        .server-status.success {
            background: #d4edda;
            color: #155724;
        }
        
        .server-status.error {
            background: #f8d7da;
            color: #721c24;
        }
        
        .input-hint {
            font-size: 0.85em;
            color: #999;
            margin-top: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .input-hint i {
            color: #667eea;
        }
        
        .recipient-example {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 12px;
            margin-top: 10px;
            font-size: 0.85em;
            color: #666;
            border-left: 3px solid #667eea;
        }
        
        .recipient-example code {
            background: white;
            padding: 3px 8px;
            border-radius: 5px;
            color: #667eea;
            font-weight: 600;
            font-family: monospace;
        }
        
        .counter {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.8em;
            margin-left: 10px;
            transition: all 0.3s ease;
        }
        
        .loading {
            opacity: 0.7;
            cursor: not-allowed;
        }
        
        .char-count {
            text-align: right;
            font-size: 0.8em;
            color: #999;
            margin-top: 5px;
        }
        
        @media (max-width: 768px) {
            .container {
                padding: 25px;
            }
            
            h1 {
                font-size: 1.8em;
            }
            
            .smtp-info p {
                flex-direction: column;
                align-items: flex-start;
                gap: 5px;
            }
            
            .smtp-info strong {
                min-width: auto;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>
            📧 Bulk Email Sender
            <span class="feature-badge">Multiple Recipients</span>
        </h1>
        
        <div id="alertMessage"></div>
        
        <div class="smtp-info">
            <p><i>📡</i> <strong>SMTP Server:</strong> <%= config.host %></p>
            <p><i>🔌</i> <strong>Port:</strong> <%= config.port %></p>
            <p><i>👤</i> <strong>Account:</strong> <%= config.username %></p>
            <p><i>✨</i> <strong>Feature:</strong> Send to multiple recipients at once</p>
        </div>
        
        <form id="emailForm">
            <div class="form-group">
                <label for="to">
                    <i>📧</i> To Email Address(es):
                    <span class="counter" id="emailCount">0</span>
                </label>
                <input type="text" 
                       id="to" 
                       name="to" 
                       placeholder="email1@example.com, email2@example.com, email3@example.com" 
                       required>
                <div class="input-hint">
                    <i>💡</i> Tip: Separate multiple emails with commas (,) or new lines
                </div>
                <div class="recipient-example">
                    <strong>📝 Examples:</strong><br>
                    • Single: <code>user@example.com</code><br>
                    • Multiple: <code>user1@example.com, user2@example.com, user3@example.com</code><br>
                    • Mixed: <code>boss@company.com, team@domain.com, client@gmail.com</code>
                </div>
            </div>
            
            <div class="form-group">
                <label for="subject">
                    <i>📝</i> Subject:
                </label>
                <input type="text" 
                       id="subject" 
                       name="subject" 
                       placeholder="Enter email subject" 
                       required>
            </div>
            
            <div class="form-group">
                <label for="message">
                    <i>💬</i> Message:
                </label>
                <textarea id="message" name="message" placeholder="Type your message here..." required></textarea>
                <div class="char-count" id="charCount">0 characters</div>
            </div>
            
            <button type="submit" id="submitBtn">
                ✈️ Send Email to Multiple Recipients
            </button>
            <button type="button" class="btn-back" onclick="window.location.href='/smtp'">
                ⚙️ Back to SMTP Settings
            </button>
        </form>
        
        <div class="server-status" id="serverStatus">
            ⚡ Checking SMTP Server Status...
        </div>
    </div>
    
    <script>
        const toInput = document.getElementById('to');
        const emailCount = document.getElementById('emailCount');
        const submitBtn = document.getElementById('submitBtn');
        const emailForm = document.getElementById('emailForm');
        const alertDiv = document.getElementById('alertMessage');
        const messageTextarea = document.getElementById('message');
        const charCount = document.getElementById('charCount');
        
        // Update email count
        function updateEmailCount() {
            const emails = toInput.value
                .split(/[,\n;]/)
                .map(email => email.trim())
                .filter(email => email && email.includes('@'));
            
            const count = emails.length;
            emailCount.textContent = count;
            
            if (count > 1) {
                emailCount.style.background = 'linear-gradient(135deg, #28a745 0%, #20c997 100%)';
                submitBtn.innerHTML = `✈️ Send Email to ${count} Recipients`;
            } else if (count === 1) {
                emailCount.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
                submitBtn.innerHTML = '✈️ Send Email to 1 Recipient';
            } else {
                emailCount.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
                submitBtn.innerHTML = '✈️ Send Email to Multiple Recipients';
            }
        }
        
        // Update character count
        function updateCharCount() {
            const count = messageTextarea.value.length;
            charCount.textContent = `${count} characters`;
            if (count > 1000) {
                charCount.style.color = '#dc3545';
            } else if (count > 500) {
                charCount.style.color = '#f59e0b';
            } else {
                charCount.style.color = '#999';
            }
        }
        
        // Show alert message
        function showAlert(message, type) {
            alertDiv.innerHTML = `
                <div class="alert alert-${type}">
                    ${type === 'success' ? '✅' : '❌'} ${message}
                </div>
            `;
            setTimeout(() => {
                alertDiv.innerHTML = '';
            }, 5000);
        }
        
        toInput.addEventListener('input', updateEmailCount);
        messageTextarea.addEventListener('input', updateCharCount);
        updateEmailCount();
        updateCharCount();
        
        // Check server status
        fetch('/status')
            .then(response => response.json())
            .then(data => {
                const statusDiv = document.getElementById('serverStatus');
                if (data.status === 'connected') {
                    statusDiv.innerHTML = '✅ SMTP Server is connected and ready to send emails';
                    statusDiv.className = 'server-status success';
                } else {
                    statusDiv.innerHTML = '❌ SMTP Server not connected. Please configure SMTP settings first.';
                    statusDiv.className = 'server-status error';
                }
            })
            .catch(() => {
                const statusDiv = document.getElementById('serverStatus');
                statusDiv.innerHTML = '❌ Unable to check server status';
                statusDiv.className = 'server-status error';
            });
        
        // Handle form submission
        emailForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = {
                to: document.getElementById('to').value,
                subject: document.getElementById('subject').value,
                message: document.getElementById('message').value
            };
            
            if (!formData.to || !formData.subject || !formData.message) {
                showAlert('Please fill in all fields', 'error');
                return;
            }
            
            // Validate email addresses
            const emails = formData.to.split(/[,\n;]/).map(e => e.trim()).filter(e => e);
            const invalidEmails = emails.filter(email => !email.includes('@'));
            if (invalidEmails.length > 0) {
                showAlert(`Invalid email address(es): ${invalidEmails.join(', ')}`, 'error');
                return;
            }
            
            submitBtn.classList.add('loading');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '⏳ Sending Email... Please wait';
            
            try {
                const response = await fetch('/send-email', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    emailForm.reset();
                    updateEmailCount();
                    updateCharCount();
                    
                    // Play success sound (optional)
                    // new Audio('https://www.soundjay.com/misc/success-1.mp3').play();
                } else {
                    showAlert(result.message, 'error');
                }
            } catch (error) {
                showAlert('Failed to send email: ' + error.message, 'error');
            } finally {
                submitBtn.classList.remove('loading');
                submitBtn.disabled = false;
                updateEmailCount();
            }
        });
        
        // Keyboard shortcut: Ctrl+Enter to send
        messageTextarea.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                emailForm.dispatchEvent(new Event('submit'));
            }
        });
        
        // Add placeholder animation
        const inputs = document.querySelectorAll('input, textarea');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.style.transform = 'translateX(5px)';
                setTimeout(() => {
                    this.parentElement.style.transform = 'translateX(0)';
                }, 200);
            });
        });
    </script>
</body>
</html>