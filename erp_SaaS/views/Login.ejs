<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
</head>
<body>
    <section id="login">
        <div class="container">
            <div class="row">
                <div class="col-md-4"></div>
                <div class="col-md-4">
                    <h1 class="text-center mb-4" >Login here</h1>
                    <form method="post" action="/login">

                       <% if (typeof mess !== "undefined" && mess !== "") { %>
                          <div class="alert alert-danger text-center">
                            <%= mess %>
                          </div>
                       <% } %>


                        <label>
                            Username/Email
                        </label>
                        <input type="email" class="form-control" name="email" required/>
                        <label>password</label>
                        <input type="password" class="form-control" name="password" required/>
                        <button type="submit" class="form-control btn btn-success mt-3" >Login</button>

                    </form>
                    <p class="para"><a href="/forgotpasswordform">Forgot Password ?</a></p>
                        <a href ="/register"><button type="submit" class="form-control btn btn-primary mt-3" >Click to Register</button></a>

                    <div>
                        <div class="col-md-4"></div>

                    </div>

                </div>
            
    </section>
</body>
</html>



    
                  