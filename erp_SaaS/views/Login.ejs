<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | REAL ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #2753a0 0%, #1a2b4a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            padding: 20px;
        }

        .login-wrapper {
            width: 100%;
            max-width: 1200px;
            background: white;
            border-radius: 30px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            animation: slideUp 0.6s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .row {
            margin: 0;
        }

        /* Left Side - Welcome Section */
        .welcome-section {
            background: linear-gradient(145deg, #0f1c33, #1e3a5f);
            padding: 60px 40px;
            color: white;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .welcome-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(212, 160, 23, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .welcome-content {
            position: relative;
            z-index: 1;
        }

        .welcome-badge {
            background: rgba(212, 160, 23, 0.2);
            color: #d4a017;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 25px;
            border: 1px solid rgba(212, 160, 23, 0.3);
        }

        .welcome-section h1 {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .welcome-section h1 span {
            color: #d4a017;
            display: block;
            font-size: 36px;
            font-weight: 400;
            margin-top: 10px;
        }

        .welcome-section p {
            color: #cbd5e0;
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 30px;
            max-width: 80%;
        }

        .feature-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .feature-list li {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            color: #e2e8f0;
        }

        .feature-list li i {
            width: 30px;
            height: 30px;
            background: rgba(212, 160, 23, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #d4a017;
            font-size: 14px;
        }

        /* Right Side - Login Section */
        .login-section {
            padding: 60px 50px;
            background: white;
        }

        .brand {
            margin-bottom: 40px;
        }

        .brand h2 {
            font-size: 28px;
            font-weight: 700;
            color: #0f1c33;
            margin: 0;
        }

        .brand span {
            color: #d4a017;
        }

        .brand p {
            color: #718096;
            font-size: 12px;
            letter-spacing: 2px;
            margin: 5px 0 0;
        }

        .login-header {
            margin-bottom: 30px;
        }

        .login-header h3 {
            color: #0f1c33;
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .login-header p {
            color: #718096;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            color: #4a5568;
            font-weight: 500;
            font-size: 14px;
            margin-bottom: 8px;
            display: block;
        }

        .input-group {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4a017;
            z-index: 1;
            font-size: 16px;
        }

        .form-control {
            width: 100%;
            padding: 15px 15px 15px 45px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: #f8fafc;
        }

        .form-control:focus {
            border-color: #d4a017;
            outline: none;
            background: white;
            box-shadow: 0 0 0 4px rgba(212, 160, 23, 0.1);
        }

        .form-control::placeholder {
            color: #a0aec0;
            font-size: 13px;
        }

        .forgot-link {
            text-align: right;
            margin: -10px 0 25px;
        }

        .forgot-link a {
            color: #d4a017;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: color 0.3s;
        }

        .forgot-link a:hover {
            color: #0f1c33;
            text-decoration: underline;
        }

        .btn-login {
            width: 100%;
            background: #d4a017;
            color: #0f1c33;
            border: none;
            padding: 16px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-login:hover {
            background: #f0c040;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(212, 160, 23, 0.3);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .divider {
            text-align: center;
            margin: 25px 0;
            position: relative;
        }

        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 45%;
            height: 1px;
            background: #e2e8f0;
        }

        .divider::after {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            width: 45%;
            height: 1px;
            background: #e2e8f0;
        }

        .divider span {
            background: white;
            padding: 0 15px;
            color: #718096;
            font-size: 13px;
        }

        .social-login {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }

        .social-btn {
            flex: 1;
            padding: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            background: white;
            color: #4a5568;
            font-weight: 500;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .social-btn:hover {
            border-color: #d4a017;
            background: #fef3e2;
            transform: translateY(-2px);
        }

        .social-btn i {
            font-size: 18px;
        }

        .social-btn .bi-google { color: #DB4437; }
        .social-btn .bi-facebook { color: #4267B2; }

        .signup-link {
            text-align: center;
            color: #718096;
            font-size: 14px;
        }

        .signup-link a {
            color: #d4a017;
            text-decoration: none;
            font-weight: 600;
            margin-left: 5px;
            transition: color 0.3s;
        }

        .signup-link a:hover {
            color: #0f1c33;
            text-decoration: underline;
        }

        .footer-text {
            text-align: center;
            margin-top: 30px;
            color: #a0aec0;
            font-size: 12px;
        }

        .footer-text a {
            color: #d4a017;
            text-decoration: none;
        }

        .footer-text a:hover {
            text-decoration: underline;
        }

        .message-alert {
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
        }

        .alert-danger {
            background: #fee;
            color: #c33;
            border: 1px solid #fcc;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .welcome-section {
                padding: 40px 30px;
            }
            
            .welcome-section h1 {
                font-size: 36px;
            }
            
            .login-section {
                padding: 40px 30px;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="row g-0">
            <!-- Left Side - Welcome Section -->
            <div class="col-md-6">
                <div class="welcome-section">
                    <div class="welcome-content">
                        <div class="welcome-badge">
                            <i class="bi bi-stars me-2"></i>WELCOME TO REAL ERP
                        </div>
                        
                        <h1>
                            Create a new account
                            <span>Log In</span>
                        </h1>
                        
                        <p>Welcome to your dashboard! Manage your tasks efficiently and explore all features in one place.</p>
                        
                        <ul class="feature-list">
                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Manage your business operations with ease and efficiency</span>
                            </li>
                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Access real-time data and insights for better decisions</span>
                            </li>
                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Secure, scalable, and user-friendly platform for growth</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Right Side - Login Section -->
            <div class="col-md-6">
                <div class="login-section">
                    <!-- Brand -->
                    <div class="brand">
                        <h2><span>REAL</span> ERP</h2>
                        <p>SAAS PLATFORM</p>
                    </div>

                    <!-- Login Header -->
                    <div class="login-header">
                        <h3>Welcome Back!</h3>
                        <p>Please login to your account</p>
                    </div>

                    <!-- Error Message -->
                    <% if (typeof mess !== "undefined" && mess) { %>
                        <div class="message-alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span><%= mess %></span>
                        </div>
                    <% } %>

                    <!-- Login Form -->
                    <form method="post" action="/login">
                        <!-- Email Field -->
                        <div class="form-group">
                            <label class="form-label">Email Address</label>
                            <div class="input-group">
                                <i class="bi bi-envelope-fill input-icon"></i>
                                <input type="email" class="form-control" 
                                       name="email" placeholder="Enter your email" required>
                            </div>
                        </div>

                        <!-- Password Field -->
                        <div class="form-group">
                            <label class="form-label">Password</label>
                            <div class="input-group">
                                <i class="bi bi-lock-fill input-icon"></i>
                                <input type="password" class="form-control" 
                                       name="password" placeholder="Enter your password" required>
                            </div>
                        </div>

                        <!-- Forgot Password - WORKING LINK -->
                        <div class="forgot-link">
                            <a href="/forgotpasswordform">Forgot Password?</a>
                        </div>

                        <!-- Sign In Button -->
                        <button type="submit" class="btn-login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            SIGN IN
                        </button>
                    </form>

                    <!-- Sign Up Link - WORKING LINK -->
                    <div class="signup-link">
                        Not a Member yet?
                        <a href="/register">Sign up now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>