<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RCS Gateway Settings</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #667eea;
            --primary-dark: #5a67d8;
            --primary-gradient: linear-gradient(135deg, #667eea, #764ba2);
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            --bg-body: #f8fafc;
            --bg-white: #ffffff;
            --bg-offwhite: #f1f5f9;
            --bg-card: #ffffff;
            --text: #334155;
            --text-light: #64748b;
            --text-muted: #94a3b8;
            --dark: #0f172a;
            --border: #eef2f6;
            --shadow: 0 8px 25px rgba(0,0,0,0.03);
            --shadow-lg: 0 15px 35px rgba(102,126,234,0.1);
            --header-height: 70px;
            --sidebar-width: 280px;
            --sidebar-mini-width: 80px;
        }

        body.dark {
            --bg-body: #0f172a;
            --bg-white: #1e293b;
            --bg-offwhite: #334155;
            --bg-card: #1e293b;
            --text: #e2e8f0;
            --text-light: #cbd5e1;
            --text-muted: #94a3b8;
            --dark: #f8fafc;
            --border: #334155;
            --shadow: 0 8px 25px rgba(0,0,0,0.2);
            --shadow-lg: 0 15px 35px rgba(102,126,234,0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden;
            background: var(--bg-body);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: var(--text);
            transition: background-color 0.3s, color 0.3s;
        }

        body.round-border .header-wrapper,
        body.round-border .sidebar,
        body.round-border .settings-card,
        body.round-border .form-control,
        body.round-border .note,
        body.round-border .btn-action,
        body.round-border .alert {
            border-radius: 20px !important;
        }

        body.no-radius .header-wrapper,
        body.no-radius .sidebar,
        body.no-radius .settings-card,
        body.no-radius .form-control,
        body.no-radius .note,
        body.no-radius .btn-action,
        body.no-radius .alert {
            border-radius: 0 !important;
        }

        .header-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            background: var(--bg-white);
            box-shadow: var(--shadow);
            border-bottom: 1px solid var(--border);
        }

        .main-wrapper {
            margin-top: 70px;
            display: flex;
            width: 100%;
            min-height: calc(100vh - 70px);
            position: relative;
        }

        .sidebar {
            width: var(--sidebar-width, 280px);
            background: var(--bg-white);
            border-right: 1px solid var(--border);
            height: calc(100vh - var(--header-height, 70px));
            position: fixed;
            left: 0;
            top: 70px;
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1020;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar.mini {
            width: var(--sidebar-mini-width, 80px);
        }

        .content-wrapper {
            flex: 1;
            margin-left: var(--sidebar-width, 280px);
            padding: 25px;
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--bg-body);
            min-height: calc(100vh - 70px);
            width: calc(100% - var(--sidebar-width, 280px));
        }

        .sidebar.mini ~ .content-wrapper {
            margin-left: var(--sidebar-mini-width, 80px);
            width: calc(100% - var(--sidebar-mini-width, 80px));
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                width: var(--sidebar-width, 280px) !important;
                transition: transform 0.3s ease;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar.mini {
                transform: translateX(-100%);
                width: var(--sidebar-width, 280px) !important;
            }

            .sidebar.mini.open {
                transform: translateX(0);
            }

            .content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                padding: 15px;
            }

            .sidebar.mini ~ .content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
            }
        }

        .settings-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .settings-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .card-head {
            background: var(--primary-gradient);
            color: #fff;
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .card-head h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .card-head small {
            font-size: 14px;
            opacity: 0.9;
            display: block;
            margin-top: 6px;
        }

        .head-actions a {
            border: 1px solid rgba(255,255,255,0.35);
            background: rgba(255,255,255,0.15);
            color: #fff;
            padding: 9px 14px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            gap: 7px;
            align-items: center;
            transition: all 0.2s ease;
        }

        .head-actions a:hover {
            background: rgba(255,255,255,0.25);
            transform: translateY(-1px);
            color: #fff;
        }

        .card-body {
            padding: 28px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-light);
        }

        .required::after {
            content: ' *';
            color: var(--danger);
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 14px;
            background: var(--bg-white);
            color: var(--text);
            transition: all 0.25s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(102,126,234,0.12);
        }

        .note {
            background: rgba(59, 130, 246, 0.08);
            border-left: 4px solid var(--info);
            border: 1px solid rgba(59, 130, 246, 0.2);
            padding: 12px;
            border-radius: 12px;
            margin-top: 10px;
            font-size: 13px;
            color: var(--text);
            line-height: 1.6;
        }

        .note b {
            color: var(--primary-dark);
        }

        .note.warning {
            background: rgba(245, 158, 11, 0.1);
            border-color: rgba(245, 158, 11, 0.25);
            border-left-color: var(--warning);
        }

        .info-badge {
            display: inline-block;
            margin-left: 8px;
            padding: 2px 8px;
            border-radius: 999px;
            background: var(--primary);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            vertical-align: middle;
        }

        .action-bar {
            border-top: 1px solid var(--border);
            background: var(--bg-offwhite);
            padding: 20px 24px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-action {
            border: none;
            border-radius: 12px;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-save {
            background: var(--primary-gradient);
            color: #fff;
        }

        .btn-test {
            background: var(--warning);
            color: #fff;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .alert {
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: none;
            font-size: 14px;
            border: 1px solid transparent;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            color: #065f46;
            border-color: rgba(16, 185, 129, 0.25);
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.1);
            color: #7f1d1d;
            border-color: rgba(239, 68, 68, 0.25);
        }

        .loading {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(15, 23, 42, 0.95);
            color: #fff;
            padding: 20px 32px;
            border-radius: 12px;
            z-index: 2000;
            font-size: 15px;
            text-align: center;
            box-shadow: 0 12px 28px rgba(0,0,0,0.3);
        }

        @media (max-width: 992px) {
            .card-body {
                padding: 20px;
            }

            .action-bar {
                padding: 16px;
            }

            .btn-action {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            const savedBorder = localStorage.getItem('border') || 'round-border';
            document.body.classList.add(savedTheme);
            document.body.classList.add(savedBorder);
        })();
    </script>

    <% const pageTitle = 'RCS Gateway Settings'; %>

    <div class="header-wrapper">
        <%- include('../../partials/admin/header.ejs')%>
    </div>

    <div class="main-wrapper">
            <%- include('../../partials/admin/left.ejs')%>


        <div class="content-wrapper" id="contentWrapper">
            <div class="settings-container">
                <div class="settings-card">
                    <div class="card-head">
                        <div>
                            <h1><i class="fas fa-gear"></i> SMS Gateway Settings</h1>
                            <small>Configure API credentials and DLT Template ID</small>
                        </div>
                        <div class="head-actions">
                            <a href="/rcscampaign"><i class="fas fa-paper-plane"></i> Open Campaign</a>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="alert" class="alert"></div>

                        <form id="settingsForm" onsubmit="return false;">
                            <div class="form-group">
                                <label class="required" for="apiUrl">API URL</label>
                                <input class="form-control" type="text" id="apiUrl" placeholder="https://msg.icloudsms.com/rest/services/sendSMS/sendGroupSms" required>
                                <div class="note">
                                    <b>Format options:</b><br>
                                    - Placeholder style: https://api.com/send?to=[app_number]&amp;msg=[app_message]&amp;template=[dlt_template_id]<br>
                                    - Standard style: https://msg.icloudsms.com/rest/services/sendSMS/sendGroupSms
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="required" for="apiKey">API Key / AUTH_KEY</label>
                                <input class="form-control" type="text" id="apiKey" placeholder="Enter your API authentication key" required>
                                <div class="note">Get this value from your SMS provider dashboard.</div>
                            </div>

                            <div class="form-group">
                                <label class="required" for="senderId">Default Sender ID</label>
                                <input class="form-control" type="text" id="senderId" maxlength="11" placeholder="6-11 character sender ID" required>
                            </div>

                            <div class="form-group">
                                <label for="routeId">Route ID <span class="info-badge">Important</span></label>
                                <select class="form-control" id="routeId">
                                    <option value="1">1 - Promotional (Bulk/Commercial)</option>
                                    <option value="2">2 - Transactional (OTP/Alerts)</option>
                                    <option value="4">4 - Transactional DND</option>
                                </select>
                                <div class="note warning">
                                    <b>Route ID affects DLT requirements:</b><br>
                                    - Route 1 (Promotional): Template ID optional<br>
                                    - Route 2/4 (Transactional): DLT Template ID is mandatory
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom:0;">
                                <label for="templateId">DLT Template ID <span class="info-badge">Required for Transactional</span></label>
                                <input class="form-control" type="text" id="templateId" placeholder="Enter 12-digit DLT Template ID">
                                <div class="note">
                                    <b>How to get DLT Template ID:</b><br>
                                    1. Login to your SMS provider panel<br>
                                    2. Open DLT Templates and Approved Templates section<br>
                                    3. Copy the approved Template ID and paste it here
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="action-bar">
                        <button class="btn-action btn-save" onclick="saveSettings()"><i class="fas fa-floppy-disk"></i> Save Settings</button>
                        <button class="btn-action btn-test" onclick="testConnection()"><i class="fas fa-plug"></i> Test Connection</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="loading" id="loading">
        <div><i class="fas fa-spinner fa-spin"></i> Processing request...</div>
    </div>

    <script>
        function isCompactMode() {
            return window.innerWidth <= 1024 && !document.body.classList.contains('desktop-mode-mobile');
        }

        function syncSidebarState() {
            const sidebar = document.getElementById('sidebar');
            const contentWrapper = document.getElementById('contentWrapper');
            if (!sidebar || !contentWrapper) return;

            if (isCompactMode()) {
                contentWrapper.style.marginLeft = '0';
                contentWrapper.style.width = '100%';
                return;
            }

            if (document.body.classList.contains('sidebar-collapsed')) {
                contentWrapper.style.marginLeft = '0';
                contentWrapper.style.width = '100%';
                return;
            }

            const isMini = sidebar.classList.contains('mini');
            contentWrapper.style.marginLeft = isMini
                ? 'var(--sidebar-mini-width, 80px)'
                : 'var(--sidebar-width, 280px)';
            contentWrapper.style.width = isMini
                ? 'calc(100% - var(--sidebar-mini-width, 80px))'
                : 'calc(100% - var(--sidebar-width, 280px))';
        }

        async function loadSettings() {
            try {
                const response = await fetch('/api/get-settings');
                const data = await response.json();

                if (data.apiUrl) document.getElementById('apiUrl').value = data.apiUrl;
                if (data.apiKey) document.getElementById('apiKey').value = data.apiKey;
                if (data.senderId) document.getElementById('senderId').value = data.senderId;
                if (data.templateId) document.getElementById('templateId').value = data.templateId;
                if (data.routeId) document.getElementById('routeId').value = data.routeId;
            } catch (error) {
                console.error('Error loading settings:', error);
            }
        }

        function showAlert(message, type) {
            const alert = document.getElementById('alert');
            alert.className = `alert alert-${type}`;
            alert.textContent = message;
            alert.style.display = 'block';

            setTimeout(() => {
                alert.style.display = 'none';
            }, 5000);
        }

        async function saveSettings() {
            const apiUrl = document.getElementById('apiUrl').value.trim();
            const apiKey = document.getElementById('apiKey').value.trim();
            const senderId = document.getElementById('senderId').value.trim();
            const templateId = document.getElementById('templateId').value.trim();
            const routeId = document.getElementById('routeId').value;

            if (!apiUrl) {
                showAlert('Please enter API URL.', 'error');
                return;
            }
            if (!apiKey) {
                showAlert('Please enter API key.', 'error');
                return;
            }
            if (!senderId) {
                showAlert('Please enter sender ID.', 'error');
                return;
            }

            if ((routeId === '2' || routeId === '4') && !templateId) {
                const confirmSave = confirm('Transactional route selected but DLT Template ID is empty. Messages may fail. Save anyway?');
                if (!confirmSave) return;
            }

            const loading = document.getElementById('loading');
            loading.style.display = 'block';

            try {
                const response = await fetch('/api/save-settings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        apiUrl,
                        apiKey,
                        senderId,
                        templateId,
                        routeId
                    })
                });

                const result = await response.json();

                if (result.success) {
                    showAlert(`Settings saved successfully. Template ID: ${templateId || 'Not set'}`, 'success');
                } else {
                    showAlert(result.message || 'Failed to save settings.', 'error');
                }
            } catch (error) {
                showAlert(`Error: ${error.message}`, 'error');
            } finally {
                loading.style.display = 'none';
            }
        }

        async function testConnection() {
            const apiUrl = document.getElementById('apiUrl').value.trim();
            const apiKey = document.getElementById('apiKey').value.trim();
            const templateId = document.getElementById('templateId').value.trim();

            if (!apiUrl) {
                showAlert('Please enter API URL first.', 'error');
                return;
            }
            if (!apiKey) {
                showAlert('Please enter API key first.', 'error');
                return;
            }

            const loading = document.getElementById('loading');
            loading.style.display = 'block';

            try {
                const response = await fetch('/api/test-connection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apiUrl, apiKey, templateId })
                });

                const result = await response.json();
                if (result.success) {
                    showAlert(result.message, 'success');
                } else {
                    showAlert(result.message || 'Connection test failed.', 'error');
                }
            } catch (error) {
                showAlert(`Connection failed: ${error.message}`, 'error');
            } finally {
                loading.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            window.addEventListener('storage', function(e) {
                if (e.key === 'sidebarMini' || e.key === 'sidebar-update-time' || e.key === 'sidebarDesktopCollapsed') {
                    const sidebar = document.getElementById('sidebar');
                    if (sidebar && !isCompactMode() && !document.body.classList.contains('desktop-mode-mobile')) {
                        const savedState = localStorage.getItem('sidebarMini') === 'true';
                        savedState ? sidebar.classList.add('mini') : sidebar.classList.remove('mini');
                    }
                    syncSidebarState();
                }
            });

            window.addEventListener('resize', syncSidebarState);

            const sidebar = document.getElementById('sidebar');
            if (sidebar) {
                const sidebarObserver = new MutationObserver(syncSidebarState);
                sidebarObserver.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
            }

            const bodyObserver = new MutationObserver(syncSidebarState);
            bodyObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });

            loadSettings();
            setTimeout(syncSidebarState, 120);
        });
    </script>
</body>
</html>