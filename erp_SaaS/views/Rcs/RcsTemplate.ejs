<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RCS Campaign - Send SMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #667eea;
            --primary-dark: #5a67d8;
            --primary-gradient: linear-gradient(135deg, #667eea, #764ba2);
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            --bg-body: #f8fafc;
            --bg-white: #ffffff;
            --bg-offwhite: #f1f5f9;
            --bg-card: #ffffff;
            --text: #334155;
            --text-light: #64748b;
            --text-muted: #94a3b8;
            --dark: #0f172a;
            --border: #eef2f6;
            --shadow: 0 8px 25px rgba(0,0,0,0.03);
            --shadow-lg: 0 15px 35px rgba(102,126,234,0.1);
            --header-height: 70px;
            --sidebar-width: 280px;
            --sidebar-mini-width: 80px;
        }

        body.dark {
            --bg-body: #0f172a;
            --bg-white: #1e293b;
            --bg-offwhite: #334155;
            --bg-card: #1e293b;
            --text: #e2e8f0;
            --text-light: #cbd5e1;
            --text-muted: #94a3b8;
            --dark: #f8fafc;
            --border: #334155;
            --shadow: 0 8px 25px rgba(0,0,0,0.2);
            --shadow-lg: 0 15px 35px rgba(102,126,234,0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden;
            background: var(--bg-body);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: var(--text);
            transition: background-color 0.3s, color 0.3s;
        }

        body.round-border .header-wrapper,
        body.round-border .sidebar,
        body.round-border .rcs-card,
        body.round-border .form-control,
        body.round-border .alert,
        body.round-border .toolbar,
        body.round-border .btn-action,
        body.round-border .helper-btn,
        body.round-border .template-info {
            border-radius: 20px !important;
        }

        body.no-radius .header-wrapper,
        body.no-radius .sidebar,
        body.no-radius .rcs-card,
        body.no-radius .form-control,
        body.no-radius .alert,
        body.no-radius .toolbar,
        body.no-radius .btn-action,
        body.no-radius .helper-btn,
        body.no-radius .template-info {
            border-radius: 0 !important;
        }

        .header-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            background: var(--bg-white);
            box-shadow: var(--shadow);
            border-bottom: 1px solid var(--border);
        }

        .main-wrapper {
            margin-top: 70px;
            display: flex;
            width: 100%;
            min-height: calc(100vh - 70px);
            position: relative;
        }

        .sidebar {
            width: var(--sidebar-width, 280px);
            background: var(--bg-white);
            border-right: 1px solid var(--border);
            height: calc(100vh - var(--header-height, 70px));
            position: fixed;
            left: 0;
            top: 70px;
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1020;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar.mini {
            width: var(--sidebar-mini-width, 80px);
        }

        .content-wrapper {
            flex: 1;
            margin-left: var(--sidebar-width, 280px);
            padding: 25px;
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--bg-body);
            min-height: calc(100vh - 70px);
            width: calc(100% - var(--sidebar-width, 280px));
        }

        .sidebar.mini ~ .content-wrapper {
            margin-left: var(--sidebar-mini-width, 80px);
            width: calc(100% - var(--sidebar-mini-width, 80px));
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                width: var(--sidebar-width, 280px) !important;
                transition: transform 0.3s ease;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar.mini {
                transform: translateX(-100%);
                width: var(--sidebar-width, 280px) !important;
            }

            .sidebar.mini.open {
                transform: translateX(0);
            }

            .content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
                padding: 15px;
            }

            .sidebar.mini ~ .content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
            }
        }

        .rcs-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .rcs-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .rcs-header {
            background: var(--primary-gradient);
            color: #fff;
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .rcs-title h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .rcs-title p {
            margin: 8px 0 0;
            opacity: 0.9;
            font-size: 14px;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-header-link {
            border: 1px solid rgba(255,255,255,0.35);
            background: rgba(255,255,255,0.15);
            color: #fff;
            padding: 9px 14px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .btn-header-link:hover {
            color: #fff;
            background: rgba(255,255,255,0.25);
            transform: translateY(-1px);
        }

        .rcs-body {
            padding: 28px;
        }

        .alert {
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: none;
            font-size: 14px;
            border: 1px solid transparent;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            color: #065f46;
            border-color: rgba(16, 185, 129, 0.25);
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.1);
            color: #7f1d1d;
            border-color: rgba(239, 68, 68, 0.25);
        }

        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-light);
        }

        .required::after {
            content: ' *';
            color: var(--danger);
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 14px;
            background: var(--bg-white);
            color: var(--text);
            transition: all 0.25s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(102,126,234,0.12);
        }

        textarea.form-control {
            min-height: 110px;
            resize: vertical;
        }

        .toolbar {
            margin-top: -1px;
            border: 1px solid var(--border);
            border-top: 0;
            border-radius: 0 0 12px 12px;
            padding: 10px;
            background: var(--bg-offwhite);
        }

        .toolbar button {
            background: var(--bg-white);
            border: 1px solid var(--border);
            color: var(--text);
            cursor: pointer;
            font-size: 14px;
            margin-right: 8px;
            padding: 6px 10px;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .toolbar button:hover {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

        .row-inline {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .helper-btn {
            border: 1px solid var(--border);
            background: var(--bg-offwhite);
            color: var(--text);
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .helper-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .helper-btn.import {
            background: var(--success);
            color: #fff;
            border-color: var(--success);
        }

        .helper-btn.import:hover {
            opacity: 0.9;
            color: #fff;
        }

        .counter {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 8px;
            text-align: right;
        }

        .radio-group {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .radio-group label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0;
            font-weight: 500;
            cursor: pointer;
        }

        .radio-group input[type='radio'] {
            width: auto;
            accent-color: var(--primary);
        }

        .template-info {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.2);
            border-left: 4px solid var(--success);
            border-radius: 12px;
            padding: 12px;
            font-size: 13px;
            color: var(--text);
            margin-top: 6px;
            display: none;
        }

        .template-info small {
            color: var(--text-muted);
        }

        .actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 24px;
        }

        .btn-action {
            flex: 1;
            min-width: 170px;
            border: none;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-send {
            background: var(--primary-gradient);
            color: #fff;
        }

        .btn-schedule {
            background: var(--warning);
            color: #fff;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .schedule-picker {
            margin-top: 18px;
            padding: 18px;
            background: var(--bg-offwhite);
            border: 1px solid var(--border);
            border-radius: 12px;
            display: none;
        }

        .schedule-picker.active {
            display: block;
        }

        .loading {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(15, 23, 42, 0.95);
            color: #fff;
            padding: 20px 32px;
            border-radius: 12px;
            z-index: 2000;
            font-size: 15px;
            text-align: center;
            box-shadow: 0 12px 28px rgba(0,0,0,0.3);
        }

        #fileInput {
            display: none;
        }

        @media (max-width: 992px) {
            .rcs-body {
                padding: 20px;
            }

            .actions {
                flex-direction: column;
            }

            .btn-action {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            const savedBorder = localStorage.getItem('border') || 'round-border';
            document.body.classList.add(savedTheme);
            document.body.classList.add(savedBorder);
        })();
    </script>

    <% const pageTitle = 'RCS Campaign'; %>
   <div class="header-wrapper">
        <%- include('../../partials/admin/header.ejs')%>
    </div>

    <div class="main-wrapper">
            <%- include('../../partials/admin/left.ejs')%>

        <div class="content-wrapper" id="contentWrapper">
            <div class="rcs-container">
                <div class="rcs-card">
                    <div class="rcs-header">
                        <div class="rcs-title">
                            <h1><i class="fas fa-paper-plane"></i> Bulk SMS Campaign</h1>
                            <p>Send messages with DLT Template ID support</p>
                        </div>
                        <div class="header-actions">
                            <a class="btn-header-link" href="/rcs/setting"><i class="fas fa-cog"></i> Gateway Settings</a>
                        </div>
                    </div>

                    <div class="rcs-body">
                        <div id="alert" class="alert"></div>

                        <form id="smsForm" onsubmit="return false;">
                            <div class="form-group">
                                <div class="row-inline">
                                    <select id="smsType" class="form-control" required>
                                        <option value="">Select SMS Type</option>
                                        <option value="promotional">Promotional - Route 1</option>
                                        <option value="transactional">Transactional - Route 2 (DLT Required)</option>
                                        <option value="otp">OTP Service - Route 2 (DLT Required)</option>
                                        <option value="dnd">Trans DND - Route 4 (DLT Required)</option>
                                    </select>
                                    <button type="button" class="helper-btn" onclick="showHelp()"><i class="fas fa-circle-info"></i> Help</button>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="required" for="senderId">Sender ID</label>
                                <input class="form-control" type="text" id="senderId" maxlength="11" placeholder="Enter 6-11 character Sender ID" required>
                            </div>

                            <div class="form-group">
                                <label class="required" for="mobileNumbers">Mobile Numbers</label>
                                <div class="row-inline" style="margin-bottom:10px;">
                                    <button type="button" class="helper-btn import" onclick="document.getElementById('fileInput').click()"><i class="fas fa-file-import"></i> Import CSV</button>
                                    <button type="button" class="helper-btn import" onclick="showExample()"><i class="fas fa-list-check"></i> Example</button>
                                </div>
                                <input type="file" id="fileInput" accept=".csv">
                                <textarea id="mobileNumbers" class="form-control" placeholder="Enter mobile numbers comma separated or one per line" required></textarea>
                                <div class="counter" id="numberCount">0 number(s) entered</div>
                            </div>

                            <div class="form-group">
                                <label class="required">Message Type</label>
                                <div class="radio-group">
                                    <label><input type="radio" name="messageType" value="text" checked> English</label>
                                    <label><input type="radio" name="messageType" value="unicode"> Unicode</label>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="required" for="message">Message</label>
                                <textarea id="message" class="form-control" placeholder="Type your message here..."></textarea>
                                <div class="toolbar">
                                    <button type="button" onclick="insertEmoji(':)')">:) </button>
                                    <button type="button" onclick="insertText('[NAME]')">[NAME]</button>
                                    <button type="button" onclick="insertText('[ORDER_ID]')">[ORDER_ID]</button>
                                    <button type="button" onclick="insertText('[OTP]')">[OTP]</button>
                                </div>
                                <div class="counter" id="charCount">0 characters / 1 credit</div>
                            </div>

                            <div id="templateInfo" class="template-info">
                                <strong>DLT Template ID in use:</strong> <span id="activeTemplateId">Loading...</span>
                                <br>
                                <small>This Template ID will be sent with your message as per TRAI guidelines.</small>
                            </div>

                            <div class="actions">
                                <button type="button" class="btn-action btn-send" onclick="sendSMS('now')"><i class="fas fa-paper-plane"></i> Send Now</button>
                                <button type="button" class="btn-action btn-schedule" onclick="showSchedule()"><i class="fas fa-calendar-days"></i> Schedule</button>
                            </div>

                            <div id="schedulePicker" class="schedule-picker">
                                <div class="form-group" style="margin-bottom:0;">
                                    <label for="scheduleTime">Schedule Date &amp; Time</label>
                                    <input class="form-control" type="datetime-local" id="scheduleTime">
                                    <button type="button" class="btn-action btn-schedule" onclick="sendSMS('schedule')" style="margin-top:12px; max-width:260px;">
                                        <i class="fas fa-check"></i> Confirm Schedule
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="loading" id="loading">
        <div><i class="fas fa-spinner fa-spin"></i> Processing request...</div>
    </div>

    <script>
        let currentSettings = {};

        function isCompactMode() {
            return window.innerWidth <= 1024 && !document.body.classList.contains('desktop-mode-mobile');
        }

        function syncSidebarState() {
            const sidebar = document.getElementById('sidebar');
            const contentWrapper = document.getElementById('contentWrapper');
            if (!sidebar || !contentWrapper) return;

            if (isCompactMode()) {
                contentWrapper.style.marginLeft = '0';
                contentWrapper.style.width = '100%';
                return;
            }

            if (document.body.classList.contains('sidebar-collapsed')) {
                contentWrapper.style.marginLeft = '0';
                contentWrapper.style.width = '100%';
                return;
            }

            const isMini = sidebar.classList.contains('mini');
            contentWrapper.style.marginLeft = isMini
                ? 'var(--sidebar-mini-width, 80px)'
                : 'var(--sidebar-width, 280px)';
            contentWrapper.style.width = isMini
                ? 'calc(100% - var(--sidebar-mini-width, 80px))'
                : 'calc(100% - var(--sidebar-width, 280px))';
        }

        async function loadSettings() {
            try {
                const response = await fetch('/api/get-settings');
                const data = await response.json();
                currentSettings = data || {};

                if (data.senderId) {
                    document.getElementById('senderId').value = data.senderId;
                }

                const templateInfo = document.getElementById('templateInfo');
                const activeTemplateId = document.getElementById('activeTemplateId');

                if (data.templateId) {
                    templateInfo.style.display = 'block';
                    activeTemplateId.textContent = data.templateId;
                } else {
                    templateInfo.style.display = 'block';
                    activeTemplateId.textContent = 'Not configured. Add in Gateway Settings.';
                }
            } catch (error) {
                console.error('Error loading settings:', error);
            }
        }

        function showAlert(message, type) {
            const alert = document.getElementById('alert');
            alert.className = `alert alert-${type}`;
            alert.textContent = message;
            alert.style.display = 'block';

            setTimeout(() => {
                alert.style.display = 'none';
            }, 5000);
        }

        function updateCounter() {
            const message = document.getElementById('message').value;
            const charCount = message.length;
            let credits = Math.ceil(charCount / 160);
            if (credits === 0) credits = 1;
            document.getElementById('charCount').textContent = `${charCount} characters / ${credits} credit(s)`;
        }

        function updateNumberCount() {
            const numbers = document.getElementById('mobileNumbers').value;
            let count = 0;

            if (numbers.includes('\n')) {
                count = numbers.split('\n').filter((n) => n.trim()).length;
            } else if (numbers.includes(',')) {
                count = numbers.split(',').filter((n) => n.trim()).length;
            } else if (numbers.trim()) {
                count = 1;
            }

            document.getElementById('numberCount').textContent = `${count} number(s) entered`;
        }

        function insertEmoji(emoji) {
            const textarea = document.getElementById('message');
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const text = textarea.value;
            textarea.value = text.substring(0, start) + emoji + text.substring(end);
            textarea.focus();
            updateCounter();
        }

        function insertText(text) {
            const textarea = document.getElementById('message');
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const currentText = textarea.value;
            textarea.value = currentText.substring(0, start) + text + currentText.substring(end);
            textarea.focus();
            updateCounter();
        }

        document.getElementById('fileInput').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/api/import-csv', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();
                if (data.success) {
                    document.getElementById('mobileNumbers').value = data.numbers;
                    updateNumberCount();
                    showAlert(`Imported successfully. ${data.count} numbers loaded.`, 'success');
                } else {
                    showAlert(data.message || 'CSV import failed.', 'error');
                }
            } catch (error) {
                showAlert('Error importing CSV', 'error');
            }

            e.target.value = '';
        });

        function showExample() {
            document.getElementById('mobileNumbers').value = '9999999999,8888888888,7777777777';
            updateNumberCount();
        }

        function showSchedule() {
            const picker = document.getElementById('schedulePicker');
            picker.classList.toggle('active');
        }

        async function sendSMS(type) {
            const senderId = document.getElementById('senderId').value.trim();
            const mobileNumbers = document.getElementById('mobileNumbers').value;
            const message = document.getElementById('message').value;
            const messageType = document.querySelector('input[name="messageType"]:checked').value;
            const smsType = document.getElementById('smsType').value;

            if (!smsType) {
                showAlert('Please select SMS type.', 'error');
                return;
            }

            if (!senderId) {
                showAlert('Please enter sender ID.', 'error');
                return;
            }

            if (!mobileNumbers.trim()) {
                showAlert('Please enter mobile numbers.', 'error');
                return;
            }

            if (!message.trim()) {
                showAlert('Please enter message text.', 'error');
                return;
            }

            const requiresDLT = smsType === 'transactional' || smsType === 'otp' || smsType === 'dnd';
            if (requiresDLT && !currentSettings.templateId) {
                showAlert(`DLT Template ID is required for ${smsType.toUpperCase()} messages. Please configure it in settings first.`, 'error');
                return;
            }

            const loading = document.getElementById('loading');
            loading.style.display = 'block';

            try {
                let url = '/api/send-sms';
                const data = {
                    senderId,
                    mobileNumbers,
                    message,
                    messageType,
                    templateId: currentSettings.templateId
                };

                if (type === 'schedule') {
                    const scheduleTime = document.getElementById('scheduleTime').value;
                    if (!scheduleTime) {
                        showAlert('Please select schedule time.', 'error');
                        loading.style.display = 'none';
                        return;
                    }
                    url = '/api/schedule-sms';
                    data.scheduleTime = scheduleTime;
                }

                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    showAlert(result.message, 'success');
                    if (type === 'now') {
                        document.getElementById('mobileNumbers').value = '';
                        document.getElementById('message').value = '';
                        updateCounter();
                        updateNumberCount();
                    } else {
                        document.getElementById('schedulePicker').classList.remove('active');
                        document.getElementById('scheduleTime').value = '';
                    }
                } else {
                    showAlert(result.message || 'Request failed.', 'error');
                }
            } catch (error) {
                showAlert(`Network error: ${error.message}`, 'error');
            } finally {
                loading.style.display = 'none';
            }
        }

        function showHelp() {
            alert(
                'SMS Type Guide:\n\n' +
                '- Promotional: Marketing or bulk messages (Route 1)\n' +
                '- Transactional: Alerts and notifications (Route 2, DLT required)\n' +
                '- OTP Service: OTP messages (Route 2, DLT required)\n' +
                '- Trans DND: DND numbers (Route 4, DLT required)\n\n' +
                'Note: 160 characters consume 1 SMS credit.'
            );
        }

        document.addEventListener('DOMContentLoaded', function() {
            window.addEventListener('storage', function(e) {
                if (e.key === 'sidebarMini' || e.key === 'sidebar-update-time' || e.key === 'sidebarDesktopCollapsed') {
                    const sidebar = document.getElementById('sidebar');
                    if (sidebar && !isCompactMode() && !document.body.classList.contains('desktop-mode-mobile')) {
                        const savedState = localStorage.getItem('sidebarMini') === 'true';
                        savedState ? sidebar.classList.add('mini') : sidebar.classList.remove('mini');
                    }
                    syncSidebarState();
                }
            });

            window.addEventListener('resize', syncSidebarState);

            const sidebar = document.getElementById('sidebar');
            if (sidebar) {
                const sidebarObserver = new MutationObserver(syncSidebarState);
                sidebarObserver.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
            }

            const bodyObserver = new MutationObserver(syncSidebarState);
            bodyObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });

            document.getElementById('message').addEventListener('input', updateCounter);
            document.getElementById('mobileNumbers').addEventListener('input', updateNumberCount);

            document.getElementById('smsType').addEventListener('change', function() {
                const requiresDLT = this.value === 'transactional' || this.value === 'otp' || this.value === 'dnd';
                if (requiresDLT && !currentSettings.templateId) {
                    showAlert('Warning: Selected route requires DLT Template ID. Please configure in Gateway Settings.', 'error');
                }
            });

            loadSettings();
            updateCounter();
            updateNumberCount();
            setTimeout(syncSidebarState, 120);
        });
    </script>
</body>
</html>