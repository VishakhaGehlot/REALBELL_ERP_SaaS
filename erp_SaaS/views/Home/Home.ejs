    </style>
</head>

<body>



<!-- TOP BAR -->
<div class="top-bar text-white py-2 px-5 d-flex justify-content-between align-items-center">
    <div class="fw-semibold" style="letter-spacing:0.5px;">
        <span class="highlight" style="font-size:15px;">REALBELL</span>
