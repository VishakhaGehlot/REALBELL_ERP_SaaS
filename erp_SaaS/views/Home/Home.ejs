<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Home | REAL ERP SaaS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --navy:         #1a2b4a;
            --navy-dark:    #0f1c33;
            --navy-mid:     #243354;
            --gold:         #d4a017;
            --gold-light:   #f0c040;
            --gold-pale:    #fef9e7;
            --text-dark:    #0f1c33;
            --text-muted:   #6b7280;
            --bg-light:     #f4f6f9;
            --white:        #ffffff;
        }
        * { box-sizing: border-box; }
        body { background: var(--bg-light); font-family: 'Segoe UI', sans-serif; margin: 0; padding: 0; overflow-x: hidden; }

        /* TOP BAR */
        .top-bar { background: var(--navy-dark); }
        .top-bar .highlight { color: var(--gold-light); }
        .top-bar .normal    { color: #ffffff; }

        /* NAVBAR */
        .navbar { border-bottom: 2px solid var(--gold); }
        .navbar .nav-link:hover { color: var(--gold) !important; }
        .btn-login { background-color: var(--navy) !important; border-radius: 10px; color: white !important; transition: 0.3s; }
        .btn-login:hover { background-color: var(--gold) !important; color: var(--navy) !important; }
        .badge-cart { background: var(--gold) !important; color: var(--navy) !important; }

        /* ANNOUNCEMENT TICKER */
        .announcement-bar { background: linear-gradient(to right, #0f1c33, #1a2b4a); color: white; display: flex; align-items: center; height: 40px; overflow: hidden; border-bottom: 2px solid #d4a017; }
        .announcement-label { background: #d4a017; color: #0f1c33; font-weight: 800; font-size: 12px; padding: 0 16px; height: 100%; display: flex; align-items: center; white-space: nowrap; flex-shrink: 0; letter-spacing: 0.5px; }
        .ticker-wrapper { flex: 1; overflow: hidden; position: relative; }
        .ticker-wrapper::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 30px; background: linear-gradient(to right, #0f1c33, transparent); z-index: 1; }
        .ticker-track { display: inline-flex; white-space: nowrap; animation: ticker-move 40s linear infinite; padding-left: 100%; }
        .ticker-item { font-size: 13px; color: #e2e8f0; margin-right: 20px; display: inline-flex; align-items: center; gap: 7px; }
        .ticker-sep { color: #d4a017; margin: 0 20px; font-size: 10px; }
        @keyframes ticker-move { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }

        /* MAIN SLIDER */
/* MAIN SLIDER */
.main-slider{
    position: relative;
    width: 100%;
    overflow: hidden;
}        
        .main-slider .carousel-item { height: 720px; position: relative; }
        .main-slider .slide-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-size: cover; background-position: center center; background-repeat: no-repeat; filter: brightness(0.45); }
        .main-slider .slide-content { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 0 100px; max-width: 700px; }
        .main-slider .slide-tag { display: inline-block; background: #d4a017; color: #0f1c33; font-size: 12px; font-weight: 700; padding: 5px 16px; border-radius: 20px; margin-bottom: 18px; letter-spacing: 1px; text-transform: uppercase; width: fit-content; }
        .main-slider .slide-title { font-size: 50px; font-weight: 900; color: white; line-height: 1.2; margin-bottom: 18px; }
        .main-slider .slide-title span { color: #f0c040; }
        .main-slider .slide-desc { font-size: 16px; color: #cbd5e1; line-height: 1.8; margin-bottom: 30px; max-width: 560px; }
        .main-slider .slide-btns { display: flex; gap: 16px; flex-wrap: wrap; }
        .main-slider .btn-primary-slide { background: #d4a017; color: #0f1c33; font-weight: 700; padding: 13px 32px; border-radius: 8px; border: none; font-size: 15px; text-decoration: none; transition: 0.3s; }
        .main-slider .btn-primary-slide:hover { background: #f0c040; transform: translateY(-2px); }
        .main-slider .btn-outline-slide { background: transparent; color: white; font-weight: 600; padding: 13px 32px; border-radius: 8px; border: 2px solid white; font-size: 15px; text-decoration: none; transition: 0.3s; }
        .main-slider .btn-outline-slide:hover { background: white; color: #0f1c33; }
        .main-slider .carousel-control-prev,
        .main-slider .carousel-control-next { width: 50px; height: 50px; top: 50%; transform: translateY(-50%); background: rgba(212,160,23,0.85); border-radius: 50%; opacity: 1; margin: 0 20px; position: absolute; }
        .main-slider .carousel-control-prev { left: 10px; }
        .main-slider .carousel-control-next { right: 10px; }
        .main-slider .carousel-indicators { bottom: 20px; }
        .main-slider .carousel-indicators [data-bs-target] { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.5); border: none; margin: 0 5px; }
        .main-slider .carousel-indicators .active { background: #d4a017; width: 28px; border-radius: 5px; }

        /* FEATURE CARDS */
        .card { border: none; border-radius: 12px; transition: 0.3s; border-top: 3px solid var(--gold); height: 100%; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(212,160,23,0.15); }
        .features-row { align-items: stretch; }

.modules-section{
    background:#f5f6f7;
    padding:80px 0;
    text-align:center;
}

.modules-title{
    font-size:42px;
    font-weight:700;
    color:#0b2c3d;
}

.modules-title span{
    color:#49c33c;
}

.modules-desc{
    max-width:900px;
    margin:15px auto 60px;
    color:#555;
    line-height:1.6;
}

.modules-wrapper{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
}

.module-item{
    position:relative;
    width:140px;
}

.module-item.up{
    transform:translateY(-40px);
}

.module-item.down{
    transform:translateY(40px);
}

.module-circle{
    width:90px;
    height:90px;
    margin:auto;
    border-radius:50%;
    border:2px dashed #49c33c;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#fff;
    overflow: hidden;
    padding: 10px;
}

.module-circle img{
    width:100%;
    height:100%;
    object-fit: cover;
    border-radius: 50%;
}

.module-item h4{
    margin-top:10px;
    font-size:16px;
    font-weight:600;
}

.module-line{
    width:120px;
    border-top:2px dashed #49c33c;
    margin:0 10px;
}

@media(max-width:768px){

    .modules-wrapper{
        flex-direction:column;
    }

    .module-line{
        display:none;
    }

    .module-item.up,
    .module-item.down{
        transform:none;
        margin-bottom:30px;
    }
}


        /* FAQ */
        .accordion-button:not(.collapsed) { background: var(--gold-pale); color: var(--navy-dark); box-shadow: none; }
        .accordion-button:focus { box-shadow: none; }

        /* SECTION HEADINGS */
        .section-heading .gold { color: var(--gold); border-bottom: 3px solid var(--gold-light); padding-bottom: 5px; }
        .section-heading .dark { color: var(--navy-dark); }

        /* ACCOUNTING */
        .accounting-section { background: #f0f2f8; padding: 70px 0; }
        .accounting-section .icon-circle { width:90px; height:90px; border-radius:50%; border: 2px solid #c8b96e; margin:auto; display:flex; align-items:center; justify-content:center; overflow:hidden; padding:10px; background:#fffdf0; }
        .accounting-section .icon-circle img { width:100%; height:100%; object-fit: cover; border-radius:50%; }
        .accounting-row { align-items: stretch; }
        .accounting-col { display: flex; flex-direction: column; align-items: center; padding: 20px 30px; }

        /* FINANCE SLIDER */
        .finance-section { background: #eaecf2; padding: 60px 0; }
        .finance-card-bg { background: #dde0eb; border-radius: 16px; padding: 28px 30px; position: relative; }
        .finance-title-bar { background: var(--navy-dark); color: var(--gold-light); padding: 13px 22px; border-radius: 0 0 22px 22px; display: inline-block; font-weight: 600; font-size: 16px; margin-bottom: 18px; }
        .finance-dot { width:10px; height:10px; background: var(--gold); border-radius:50%; margin-top:7px; margin-right:12px; flex-shrink: 0; }
        .finance-center-line { position:absolute; top:28px; bottom:28px; left:calc(50% - 1px); width:2px; background: var(--gold); z-index:0; }
        .finance-row { align-items: stretch; }
        .finance-col { display:flex; flex-direction:column; padding: 0 15px; }
        #financeCarousel { position: relative; padding: 0 30px; }
        #financeCarousel .carousel-control-prev, #financeCarousel .carousel-control-next { width:40px; height:40px; top:50%; transform:translateY(-50%); background: var(--navy); border-radius:50%; opacity:1; }
        #financeCarousel .carousel-control-prev { left: 0; }
        #financeCarousel .carousel-control-next { right: 0; }
        #financeCarousel .carousel-control-prev-icon, #financeCarousel .carousel-control-next-icon { width:16px; height:16px; }

        /* HR */
        .hr-section { background: #eaecf2; padding: 55px 0; }
        .hr-icon-circle { width:52px; height:52px; border-radius:50%; background: var(--gold-pale); border:2px solid #c8b96e; display:flex; align-items:center; justify-content:center; z-index:2; flex-shrink:0; overflow: hidden; padding: 6px; }
        .hr-icon-circle img { width: 100%; height: 100%; object-fit: cover; border-radius:50%; }
        .hr-timeline-line { position:absolute; left:26px; top:0; bottom:0; border-left: 2px dotted var(--gold); }

        /* LEADS */
        .leads-section { background: #eaecf2; padding: 70px 0; }
        .leads-box { border: 2px solid var(--gold); border-radius: 60px; background: white; margin-bottom: 20px; padding: 22px 30px; }
        .leads-icon-circle { width: 90px; height: 90px; border-radius: 50%; border: 2px solid #c8b96e; display: flex; align-items: center; justify-content: center; margin: auto; background: #fffdf0; overflow: hidden; padding: 10px; }
        .leads-icon-circle img { width: 100%; height: 100%; object-fit: cover; border-radius:50%; }
        .leads-divider { height: 60px; border-left: 3px solid var(--gold); margin: auto; }

        /* TESTIMONIALS */
        .testimonial-section { background: #eaecf2; padding: 90px 0; }
        .testimonial-card { border: 2px solid var(--gold); border-radius: 15px; padding: 30px; background: white; height: 100%; }
        .testimonial-card .quote-icon { font-size:50px; color: var(--gold); line-height:1; }
        .testimonial-card .bottom-bar { height:6px; background: var(--gold); border-radius:5px; margin-top:20px; }

        /* CONTACT */
        .contact-section { background: var(--bg-light); padding: 70px 0; }
        .contact-left { background: linear-gradient(to bottom right, var(--navy-dark), var(--navy)); color: white; padding: 45px 40px; }
        .contact-left h6 { color: var(--gold-light); font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
        .contact-left p { color: #cbd5e1; font-size: 14px; margin-bottom: 0; }
        .contact-left a { color: var(--gold-light); text-decoration: none; }
        .contact-left a:hover { text-decoration: underline; }
        .contact-form .form-control { border: 1px solid #dee2e6; border-radius: 6px; padding: 10px 14px; font-size: 14px; background: #fff; transition: border-color 0.2s; }
        .contact-form .form-control:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,160,23,0.12); }
        .contact-form label { font-size: 13px; font-weight: 600; color: var(--navy-dark); margin-bottom: 5px; }
        .contact-form .required-star { color: #e53e3e; }
        .contact-btn { background: var(--gold); color: var(--navy-dark); font-weight: 700; font-size: 15px; border: none; border-radius: 8px; padding: 12px 40px; transition: 0.3s; cursor: pointer; }
        .contact-btn:hover { background: var(--gold-light); transform: translateY(-1px); }

        /* FOOTER */
        .footer-link { color: #64748b; text-decoration: none; font-size: 14px; display: block; text-align: left; transition: 0.2s; padding: 2px 0; }
        .footer-link:hover { color: #d4a017; padding-left: 6px; }
        .footer-social { transition: transform 0.2s; display:inline-flex; }
        .footer-social:hover { transform: translateY(-3px); }
        .footer-heading { color: #0f1c33; font-weight: 800; font-size: 16px; margin-bottom: 0; text-align: left; }
        .footer-gold-line { width: 40px; height: 3px; background: #d4a017; border-radius: 2px; margin-top: 8px; margin-bottom: 22px; }

        /* PREMIUM BAR */
        .premium-bar { background:#0b3b44; padding:35px 0; }
        .premium-wrapper { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; }
        .premium-item { flex:1; text-align:center; color:#fff; position:relative; padding:10px 15px; }
        .premium-item:not(:last-child)::after { content:""; position:absolute; right:0; top:25%; height:50%; width:2px; background:#19c37d; }
        .premium-icon { width:70px; height:70px; border-radius:50%; background:#0f4a54; display:flex; align-items:center; justify-content:center; margin:auto; margin-bottom:10px; }
        .premium-icon img { width:35px; }
        .premium-item h5 { font-size:17px; font-weight:600; margin:0; }

