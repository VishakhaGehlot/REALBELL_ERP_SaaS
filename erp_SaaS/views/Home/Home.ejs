    </div>
</div>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light bg-white px-5 shadow-sm">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/images/companylogo.jpg" alt="REALERP Logo" style="height:55px; width:auto; object-fit:contain; max-width:80px;">
        <div style="line-height:1.2;">
            <span style="font-size:18px; font-weight:800; color:var(--gold); letter-spacing:0.5px;">REAL</span><span style="font-size:18px; font-weight:800; color:var(--navy-dark); letter-spacing:0.5px;">ERP</span>
            <div style="font-size:10px; color:#94a3b8; letter-spacing:1.5px; font-weight:500;">SAAS PLATFORM</div>
