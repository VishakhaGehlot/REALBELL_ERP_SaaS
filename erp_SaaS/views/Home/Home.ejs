        </div>
    </div>
</nav>
<!-- ANNOUNCEMENT TICKER -->
<div class="announcement-bar">
    <div class="announcement-label">🔔 ANNOUNCEMENT</div>
    <div class="ticker-wrapper">
        <div class="ticker-track">
            <span class="ticker-item">🚀 <strong>REALERP v2.0 Is Here!</strong> &nbsp; New modules added — POS, Payroll & Advanced Reports. Upgrade now!</span>
            <span class="ticker-sep">❖</span>
            <span class="ticker-item">🎉 <strong>Limited Time Offer — 30% Off!</strong> &nbsp; Get discount on Annual Plans. Use code REALERP30 at checkout.</span>
            <span class="ticker-sep">❖</span>
            <span class="ticker-item">⭐ <strong>New Feature: Real-Time Analytics Dashboard</strong> &nbsp; Track your business performance with live charts & custom reports.</span>
            <span class="ticker-sep">❖</span>
            <span class="ticker-item">💬 <strong>24/7 Customer Support Now Available</strong> &nbsp; Our expert team is available round the clock — Chat, Email & Call.</span>
            <span class="ticker-sep">❖</span>
            <span class="ticker-item">🔐 <strong>Your Data Is Safe With Us</strong> &nbsp; REALERP uses enterprise-grade encryption to protect your business data.</span>
            <span class="ticker-sep">❖</span>
        </div>
    </div>
</div>

<!-- ===== MAIN IMAGE SLIDER ===== -->
<%
let slideContent = [
    {
        tag: "🚀 All-in-One ERP Platform",
        title: "Run Your Entire <span>Business</span>",
        title2: "From One Place",
        desc: "Manage accounts, HR, inventory, CRM, POS and more — all in a single powerful platform built for modern businesses.",
        btn1: "Get Started Free", btn1link: "/register",
        btn2: "Explore Features", btn2link: "#features"
    },
    {
        tag: "📊 Real-Time Analytics",
        title: "Make Smarter <span>Decisions</span>",
        title2: "With Live Data",
        desc: "Track your business performance with real-time dashboards, custom reports and powerful analytics tools.",
        btn1: "Start Today", btn1link: "/register",
        btn2: "Talk to Us", btn2link: "/contact"
    },
    {
        tag: "👥 HR & Payroll",
        title: "Empower Your <span>Team</span>",
        title2: "Grow Together",
        desc: "From onboarding to payroll, manage your entire workforce effortlessly with REALERP's smart HR module.",
        btn1: "Try For Free", btn1link: "/register",
        btn2: "Contact Sales", btn2link: "/contact"
    }
];
let activeSlides = swiperdata.filter(s => s.status === "Active");
%>

<div id="mainSlider" class="carousel slide main-slider" data-bs-ride="carousel" data-bs-interval="3000" data-bs-pause="false">
    <div class="carousel-indicators">
        <% activeSlides.forEach((val, k) => { %>
            <button type="button" data-bs-target="#mainSlider" data-bs-slide-to="<%=k%>" class="<%=k===0?'active':''%>"></button>
        <% }) %>
    </div>
    <div class="carousel-inner">
        <% activeSlides.forEach((val, k) => {
           let content = slideContent[k % slideContent.length];
        %>
        <div class="carousel-item <%=k===0?'active':''%>">
            <div class="slide-bg" style="background-image: url('/upload/<%=val.img%>');"></div>
            <div class="slide-content">
                <span class="slide-tag"><%- content.tag %></span>
                <h2 class="slide-title"><%- content.title %><br><%- content.title2 %></h2>
                <p class="slide-desc"><%- content.desc %></p>
                <div class="slide-btns">
                    <a href="<%=content.btn1link%>" class="btn-primary-slide"><%=content.btn1%></a>
                    <a href="<%=content.btn2link%>" class="btn-outline-slide"><%=content.btn2%></a>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#mainSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#mainSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var slider = new bootstrap.Carousel(document.getElementById('mainSlider'), {
            interval: 3000,
            ride: true,
            pause: false,
            wrap: true
        });
        slider.cycle();
    });
</script>
<!-- ===== END MAIN SLIDER ===== -->



<section>
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <%featuredata.forEach((val)=>{%>
                    <p><%=val.title%></p>
                    <p><%=val.desc%></p>
                    <img style="margin-top: 60px;margin-left: -180px;" src="/upload/<%=val.img%>" alt="">
                <%})%>
            </div>
        </div>
    </div>
</section>

<!-- PREMIUM FEATURES BAR -->
<section class="premium-bar">
    <div class="container">
        <div class="premium-wrapper">
            <% premiumsdata.forEach((val)=>{ %>
            <div class="premium-item">
                <div class="premium-icon">
                    <img src="/upload/<%=val.img%>" alt="<%=val.title%>">
                </div>
                <h5><%=val.title%></h5>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- FAQ -->
<div class="container py-5">
    <div class="row text-center mb-4">
        <h2 style="color:var(--navy-dark);">Frequently Asked Questions</h2>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="accordion" id="faqAccordion">
                <% faqdata.forEach((val,k)=>{ %>
                <% if(val.status==="Active"){ %>
                <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                    <h2 class="accordion-header" id="heading<%=k%>">
                        <button class="accordion-button collapsed fw-semibold" type="button"
                                data-bs-toggle="collapse" data-bs-target="#collapse<%=k%>">
                            <%= val.title %>
                        </button>
                    </h2>
                    <div id="collapse<%=k%>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted"><%= val.desc %></div>
                    </div>
                </div>
                <% } %>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<!-- ACCOUNTING & BILLING -->
<section class="accounting-section">
    <div class="container">
        <div class="text-center mb-5 section-heading">
            <h1 style="font-weight:600;">
                <span class="gold">Accounting And Billing</span>
                <span class="dark"> Management</span>
            </h1>
        </div>
        <div style="border-top:2px dashed var(--gold); border-bottom:2px dashed var(--gold); padding:40px 0;">
            <div class="row text-center accounting-row">
                <% data.forEach((val,k)=>{ %>
                <div class="col-md-4 accounting-col <% if(k !== data.length - 1){ %>border-end<% } %>">
                    <div class="icon-circle">
                        <img src="/upload/<%= val.img %>" width="45">
                    </div>
                    <h4 class="mt-4 fw-bold" style="color:var(--navy-dark);"><%= val.title %></h4>
                    <p class="mt-3 text-muted" style="font-size:15px; line-height:1.8; flex:1;"><%= val.desc %></p>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</section>

<!-- FINANCE SLIDER -->
<section class="finance-section">
    <div class="container">
        <div class="text-center mb-5 section-heading">
            <h1 style="font-weight:700; font-size:42px;">
                <span class="dark">Get All The Critical Tools To</span>
                <span class="gold"> Manage Business Finances</span>
            </h1>
        </div>
        <div id="financeCarousel" class="carousel slide" data-bs-ride="false" data-bs-wrap="false">
            <div class="carousel-inner">
                <%
                let activeData = financedata.filter(f => f.status==="Active");
                for(let i=0; i<activeData.length; i+=2){
                %>
                <div class="carousel-item <%= i===0 ? 'active' : '' %>">
                    <div class="finance-card-bg">
                        <div class="row finance-row">
                            <% for(let j=i; j<i+2 && j<activeData.length; j++){
                               let val = activeData[j]; %>
                            <div class="col-md-6 finance-col">
                                <div class="finance-title-bar"><%= val.title %></div>
                                <div>
                                    <% [val.desc1,val.desc2,val.desc3,val.desc4].forEach(function(desc){
                                       if(desc && desc.trim() !== '' && desc.trim() !== '...') { %>
                                    <div class="d-flex mb-3">
                                        <div class="finance-dot"></div>
                                        <p style="color:#555; line-height:1.7; margin-bottom:0; font-size:14px;"><%= desc %></p>
                                    </div>
                                    <% } }) %>
                                </div>
                            </div>
                            <% } %>
                        </div>
                        <div class="finance-center-line"></div>
                    </div>
                </div>
                <% } %>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#financeCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#financeCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</section>

<!-- MANAGE HR -->
<section class="hr-section">
    <div class="container">
        <div class="text-center mb-4 section-heading">
            <h1 style="font-weight:600; font-size:36px;">
                <span class="gold">Manage HR</span>
                <span class="dark"> - Business Greatest Assets</span>
            </h1>
        </div>
        <div class="row align-items-center">
            <div class="col-md-5 text-center">
                <div style="background:#eaecf2; border-radius:20px; padding:10px; display:inline-block;">
                    <img src="/images/hr.png" class="img-fluid" style="max-width:100%; display:block; mix-blend-mode: multiply;">
                </div>
            </div>
            <div class="col-md-7 position-relative ps-5">
                <div class="hr-timeline-line"></div>
                <% managedata.forEach((val)=>{ %>
                <div class="d-flex mb-4">
                    <div class="hr-icon-circle">
                        <img src="/upload/<%= val.img %>">
                    </div>
                    <div class="ms-3">
                        <h5 style="font-weight:600; color:var(--navy-dark); margin-bottom:4px;"><%= val.title %></h5>
                        <p style="color:#6c757d; line-height:1.7; font-size:14px; margin-bottom:0;"><%= val.desc %></p>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</section>

<!-- LEADS & DEALS -->
<section class="leads-section">
    <div class="container">
        <div class="text-center mb-5 section-heading">
            <h1 style="font-weight:700; font-size:38px;">
                <span class="dark">Manage</span>
                <span class="gold"> Leads & Deals</span>
            </h1>
        </div>
        <% leadsdata.forEach((val)=>{ %>
        <div class="leads-box">
            <div class="row align-items-center">
                <div class="col-md-2 text-center">
                    <div class="leads-icon-circle">
                        <img src="/upload/<%= val.img %>">
                    </div>
                </div>
                <div class="col-md-3 text-start ps-3">
                    <h5 style="font-weight:700; color:var(--navy-dark); font-size:17px; line-height:1.4; margin:0;"><%= val.title %></h5>
                </div>
                <div class="col-md-1 text-center">
                    <div class="leads-divider"></div>
                </div>
                <div class="col-md-6">
                    <p style="color:#666; font-size:15px; line-height:1.8; margin:0;"><%= val.desc %></p>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</section>

<!-- TESTIMONIALS -->
<section class="testimonial-section">
    <div class="container">
        <div class="text-center mb-4 section-heading">
            <h1 style="font-weight:700; font-size:42px;">
                <span class="dark">What Our Customers Say About</span>
                <span class="gold"> Our Solutions</span>
            </h1>
            <p class="text-muted mt-3">Our clients are at the heart of everything we do. Here's what they have to say.</p>
        </div>
        <div id="solutionCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">
            <div class="carousel-inner">
                <% for(let i=0; i<solutiondata.length; i+=2){ %>
                <div class="carousel-item <%= i===0 ? 'active' : '' %>">
                    <div class="row justify-content-center align-items-stretch">
                        <% for(let j=i; j<i+2 && j<solutiondata.length; j++){
                           let val = solutiondata[j]; %>
                        <div class="col-md-5 mx-3 d-flex">
                            <div class="testimonial-card w-100">
                                <div class="quote-icon">"</div>
                                <p style="color:#555; font-size:16px; line-height:1.8;"><%= val.desc %></p>
                                <div class="d-flex align-items-center mt-4">
                                    <img src="/upload/<%= val.img %>" style="width:55px;height:55px;border-radius:50%;object-fit:cover;">
                                    <div class="ms-3">
                                        <h5 style="margin:0; font-weight:700;"><%= val.title %></h5>
                                        <small class="text-muted"><%= val.mdesc %></small>
                                    </div>
                                </div>
                                <div class="bottom-bar"></div>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<section class="pricing-section">
    <h1 class="pricing-title">Simple & Transparent Pricing</h1>

    <div class="container">
        <div class="row g-4">

            <% Data.forEach((val)=>{ %>
            <div class="col-md-4">
                <div class="pricing-card">

                    <h3><%= val.title %></h3>

                    <div class="price">₹<%= val.price %></div>

                    <ul>
                        <% val.features.forEach(function(f){ %>
                            <li>✔ <%= f %></li>
                        <% }) %>
                    </ul>

                    <!-- FORM -->
                    <a href="/pricingForm?planId=<%= val._id %>" class="btn-plan d-inline-block text-decoration-none">
                        Select Plan
                    </a>

                </div>
            </div>
            <% }) %>

        </div>
    </div>
</section>

