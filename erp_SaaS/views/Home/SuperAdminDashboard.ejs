<%- include('../../partials/admin/header.ejs') %>

<style>
    :root {
        --admin-sidebar-width: 350px;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f5f7fb;
        overflow-x: hidden;
    }

    .main-wrapper {
        display: flex;
        width: 100%;
        min-height: 100vh;
    }

    .content-wrapper {
        flex: 1;
        margin-left: var(--admin-sidebar-width);
        width: calc(100% - var(--admin-sidebar-width));
        padding: 25px;
        background: #f5f7fb;
        min-height: 100vh;
        box-sizing: border-box;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .page-header h2 {
        color: #1e293b;
        font-weight: 700;
        margin: 0;
        font-size: 28px;
    }

    .page-header p {
        color: #64748b;
        margin: 6px 0 0;
    }

    .badge-role {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 20px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid #e2e8f0;
    }

    .stat-card h4 {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .stat-card p {
        margin: 8px 0 0;
        color: #0f172a;
        font-size: 24px;
        font-weight: 700;
    }

    .table-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .table-header {
        padding: 14px 16px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        font-weight: 700;
        color: #1e293b;
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

    th, td {
        padding: 12px 14px;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
        font-size: 14px;
    }

    th {
        color: #64748b;
        background: #f8fafc;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.4px;
    }

    .status {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .status.active {
        background: #dcfce7;
        color: #166534;
    }

    .status.inactive {
        background: #fef3c7;
        color: #92400e;
    }

    .status.suspended {
        background: #fee2e2;
        color: #991b1b;
    }

    @media (max-width: 768px) {
        .content-wrapper {
            margin-left: 0;
            width: 100%;
            padding: 14px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

<div class="main-wrapper">
    <%- include('../../partials/admin/left.ejs') %>

    <div class="content-wrapper">
        <div class="page-header">
            <div>
                <h2>SuperAdmin Dashboard</h2>
                <p>Login user: <strong><%= userName %></strong> (<%= userEmail %>)</p>
                <p style="margin-top:8px;">
                    <a href="/permissions" style="text-decoration:none; font-weight:700; color:#d97706;">Manage Role Permissions</a>
                </p>
            </div>
            <div class="badge-role"><%= userRole %></div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h4>Total Users</h4>
                <p><%= stats.totalUsers %></p>
            </div>
            <div class="stat-card">
                <h4>Active Users</h4>
                <p><%= stats.activeUsers %></p>
            </div>
            <div class="stat-card">
                <h4>Leadership</h4>
                <p><%= stats.leadershipUsers %></p>
            </div>
            <div class="stat-card">
                <h4>Employees</h4>
                <p><%= stats.employeeUsers %></p>
            </div>
        </div>

        <div class="table-card">
            <div class="table-header">Complete User Information</div>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>DOB</th>
                            <th>Role</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (allUsers && allUsers.length) { %>
                            <% allUsers.forEach((u) => { %>
                                <tr>
                                    <td><%= (u.firstName || '') + ' ' + (u.lastName || '') %></td>
                                    <td><%= u.email || '-' %></td>
                                    <td><%= u.mobile || '-' %></td>
                                    <td><%= u.dob || '-' %></td>
                                    <td><%= u.role || 'User' %></td>
                                    <td>
                                        <span class="status <%= (u.status || '').toLowerCase() %>">
                                            <%= u.status || 'Inactive' %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6">No users found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
