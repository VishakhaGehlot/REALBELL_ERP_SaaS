<%- include('../../partials/admin/header.ejs') %>

<style>
    :root {
        --admin-sidebar-width: 350px;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f5f7fb;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
        width: 100%;
    }

    /* Main wrapper - flex layout */
    .main-wrapper {
        display: flex;
        width: 100%;
        min-height: 100vh;
        position: relative;
    }

    /* Sidebar fixed width */
    .main-wrapper .sidebar {
        width: var(--admin-sidebar-width);
        height: 100vh;
        background: white;
        box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
        position: fixed;
        left: 0;
        top: 0;
        overflow-y: auto;
        padding: 0;
        z-index: 100;
    }

    /* Content wrapper - matches sidebar width */
    .content-wrapper {
        flex: 1;
        margin-left: var(--admin-sidebar-width);
        width: calc(100% - var(--admin-sidebar-width));
        min-height: 100vh;
        background: #f5f7fb;
        padding: 25px 30px;
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

    /* Welcome Section */
    .welcome-section {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-radius: 24px;
        padding: 30px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
    }

    .welcome-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(225, 225, 230, 0.15) 0%, transparent 70%);
        animation: pulse 4s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.05); }
    }

    .welcome-content {
        position: relative;
        z-index: 1;
    }

    .welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(99, 102, 241, 0.2);
        backdrop-filter: blur(10px);
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        color: #a5b4fc;
        margin-bottom: 15px;
        border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .welcome-section h1 {
        color: white;
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 10px 0;
    }

    .welcome-section p {
        color: #cbd5e1;
        font-size: 16px;
        margin: 0;
    }

    .date-time {
        position: absolute;
        top: 30px;
        right: 30px;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        padding: 10px 20px;
        border-radius: 12px;
        color: white;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        gap: 15px;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08);
        border: 1px solid #dbeafe;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.08);
    }

    .stat-card:hover::after {
        transform: scaleX(1);
    }

    .stat-icon {
        width: 55px;
        height: 55px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .stat-icon i {
        font-size: 28px;
    }

    .stat-icon.queries { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; }
    .stat-icon.replied { background: linear-gradient(135deg, #10b981, #059669); color: white; }
    .stat-icon.users { background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; }
    .stat-icon.active { background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; }

    .stat-info h3 {
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 8px 0;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 5px 0;
    }

    .stat-trend {
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .stat-trend.up { color: #10b981; }
    .stat-trend.down { color: #ef4444; }

    /* Charts Row */
    .charts-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        margin-bottom: 30px;
    }

    .chart-card {
        background: white;
        border-radius: 20px;
        padding: 24px;
        border: 1px solid #dbeafe;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.06);
        transition: all 0.3s ease;
    }

    .chart-card:hover {
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .chart-header h4 {
        color: #0f172a;
        font-size: 16px;
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chart-header h4 i {
        color: #3b82f6;
    }

    .chart-badge {
        background: #f1f5f9;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        color: #64748b;
        font-weight: 500;
    }

    .chart-container {
        height: 250px;
        position: relative;
    }

    /* Recent Activity Section */
    .activity-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 30px;
    }

    .activity-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #dbeafe;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.06);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .activity-card:hover {
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #eef2f6;
        background: #fafbfc;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header h4 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-header h4 i {
        color: #3b82f6;
    }

    .view-all {
        font-size: 12px;
        color: #3b82f6;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .view-all:hover {
        color: #1d4ed8;
        text-decoration: underline;
    }

    .activity-list {
        padding: 0 24px;
        max-height: 320px;
        overflow-y: auto;
    }

    .activity-list::-webkit-scrollbar {
        width: 4px;
    }

    .activity-list::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .activity-list::-webkit-scrollbar-thumb {
        background: #3b82f6;
        border-radius: 10px;
    }

    .activity-item {
        padding: 16px 0;
        border-bottom: 1px solid #eef2f6;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .activity-item:hover {
        background: #fafbfc;
        padding-left: 8px;
        transform: translateX(5px);
    }

    .activity-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .activity-icon.pending { background: #dbeafe; color: #3b82f6; }
    .activity-icon.replied { background: #dbeafe; color: #3b82f6; }
    .activity-icon.user { background: #dbeafe; color: #3b82f6; }

    .activity-content {
        flex: 1;
    }

    .activity-title {
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 4px;
        font-size: 14px;
    }

    .activity-time {
        font-size: 11px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .activity-status {
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 600;
        white-space: nowrap;
    }

    .activity-status.pending {
        background: #dbeafe;
        color: #92400e;
    }

    .activity-status.replied {
        background: #d1fae5;
        color: #166534;
    }

    /* Quick Actions */
    .quick-actions {
        background: white;
        border-radius: 20px;
        padding: 24px;
        border: 1px solid #eef2f6;
    }

    .quick-actions h4 {
        color: #0f172a;
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 20px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .action-btn {
        background: #f8fafc;
        border: 1px solid #eef2f6;
        padding: 15px;
        border-radius: 16px;
        text-align: center;
        text-decoration: none;
        transition: all 0.3s ease;
        display: block;
    }

    .action-btn:hover {
        background: #eff6ff;
        border-color: #3b82f6;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.15);
    }

    .action-btn i {
        font-size: 24px;
        color: #3b82f6;
        margin-bottom: 8px;
        display: block;
    }

    .action-btn span {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
    }

    /* Bar Chart CSS */
    .bar-chart {
        display: flex;
        align-items: flex-end;
        gap: 20px;
        height: 200px;
        padding-top: 20px;
    }

    .bar-item {
        flex: 1;
        text-align: center;
        cursor: pointer;
    }

    .bar {
        background: linear-gradient(180deg, #3b82f6, #60a5fa);
        border-radius: 8px 8px 0 0;
        transition: all 0.3s ease;
        position: relative;
        min-height: 4px;
    }

    .bar:hover {
        transform: scaleX(1.02);
        filter: brightness(1.05);
    }

    .bar-label {
        margin-top: 12px;
        font-size: 12px;
        color: #64748b;
        font-weight: 500;
    }

    .bar-value {
        font-size: 11px;
        color: #3b82f6;
        font-weight: 600;
        margin-top: 5px;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #94a3b8;
    }

    .empty-state i {
        font-size: 48px;
        margin-bottom: 12px;
        display: block;
        opacity: 0.5;
    }

    .empty-state p {
        font-size: 14px;
        margin: 0;
    }

    /* Page Header for Dashboard */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .page-header h2 {
        color: #1e293b;
        font-weight: 700;
        margin: 0;
        font-size: 28px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-header h2 i {
        color: #3b82f6;
        font-size: 32px;
    }

    .page-header p {
        color: #64748b;
        font-size: 14px;
        margin: 5px 0 0;
    }

    /* Responsive */
    @media (max-width: 1200px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .charts-row {
            grid-template-columns: 1fr;
        }
        .activity-section {
            grid-template-columns: 1fr;
        }
        .actions-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .content-wrapper {
            margin-left: 0;
            width: 100%;
            padding: 15px 20px;
        }
        .main-wrapper .sidebar {
            width: 100%;
            height: auto;
            position: relative;
        }
        .welcome-section h1 {
            font-size: 24px;
        }
        .date-time {
            position: relative;
            top: auto;
            right: auto;
            margin-top: 15px;
            display: inline-flex;
            flex-wrap: wrap;
        }
        .actions-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .bar-chart {
            gap: 10px;
        }
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
    }

    @media (max-width: 480px) {
        .content-wrapper {
            padding: 15px 12px;
        }
        .actions-grid {
            grid-template-columns: 1fr;
        }
        .chart-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .page-header h2 {
            font-size: 24px;
        }
        .stat-card {
            padding: 18px;
        }
        .stat-number {
            font-size: 26px;
        }
    }

    /* Dark mode styles for dashboard */
    [data-theme="dark"] body {
        background: #090f1f !important;
    }

    [data-theme="dark"] .main-wrapper {
        background: #090f1f !important;
    }

    [data-theme="dark"] .main-wrapper .sidebar {
        background: #111a2e !important;
        box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3) !important;
    }

    [data-theme="dark"] .content-wrapper {
        background: #090f1f !important;
    }

    [data-theme="dark"] .page-header h2 {
        color: #e5e7eb !important;
    }

    [data-theme="dark"] .page-header p {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .date-time {
        background: #111a2e !important;
        color: #e5e7eb !important;
    }

    [data-theme="dark"] .stat-card {
        background: #111a2e !important;
        border-color: #253454 !important;
    }

    [data-theme="dark"] .stat-info h3 {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .stat-number {
        color: #e5e7eb !important;
    }

    [data-theme="dark"] .chart-card,
    [data-theme="dark"] .activity-card {
        background: #111a2e !important;
        border-color: #253454 !important;
    }

    [data-theme="dark"] .chart-header h4,
    [data-theme="dark"] .card-header h4 {
        color: #e5e7eb !important;
    }

    [data-theme="dark"] .chart-badge {
        background: #16233d !important;
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .card-header {
        background: #0d1427 !important;
        border-color: #253454 !important;
    }

    [data-theme="dark"] .activity-item {
        border-color: #253454 !important;
    }

    [data-theme="dark"] .activity-item:hover {
        background: #16233d !important;
    }

    [data-theme="dark"] .activity-title {
        color: #e5e7eb !important;
    }

    [data-theme="dark"] .activity-time {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .empty-state {
        color: #9fb0cb !important;
    }

    [data-theme="dark"] .action-btn {
        background: #111a2e !important;
        border-color: #253454 !important;
    }

    [data-theme="dark"] .action-btn:hover {
        background: #16233d !important;
    }

    [data-theme="dark"] .activity-list::-webkit-scrollbar-track {
        background: #0d1427 !important;
    }

    [data-theme="dark"] .activity-list::-webkit-scrollbar-thumb {
        background: #253454 !important;
    }
</style>

<div class="main-wrapper">
    <%
        const hasAccess = (typeof canAccess === 'function') ? canAccess : (() => false);
        const hasAnyPermission = (moduleKey, actions) => {
            const actionList = Array.isArray(actions) && actions.length ? actions : ['view', 'add', 'edit', 'delete'];
            if (typeof canAccessAny === 'function') {
                return canAccessAny(moduleKey, actionList);
            }
            return actionList.some((action) => hasAccess(moduleKey, action));
        };
    %>
    <%- include('../../partials/admin/left.ejs') %>

    <div class="content-wrapper">
        <div class="container-fluid" style="padding: 0; width: 100%; max-width: 100%;">
            <!-- Page Header -->
            <div class="page-header">
                <div>
                    <h2>
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </h2>
                    <p>Welcome to your ERP dashboard - Overview of your system</p>
                </div>
                <div class="date-time" style="position: relative; top: auto; right: auto; background: #f1f5f9; color: #1e293b; margin: 0; padding: 10px 18px;">
                    <i class="bi bi-calendar" style="color: #3b82f6;"></i>
                    <span id="currentDate"></span>
                    <i class="bi bi-clock" style="color: #3b82f6;"></i>
                    <span id="currentTime"></span>
                </div>
            </div>

            <!-- Welcome Section -->
            <div class="welcome-section">
                <div class="welcome-content">
                    <div class="welcome-badge">
                        <i class="bi bi-stars"></i> Welcome Back!
                    </div>
                    <h1>Hello, <%= userName || 'User' %></h1>
                    <p>Here's what's happening with your ERP system today.</p>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="stats-grid">
                <% 
                    const summaryCards = Array.isArray(dashboardStats) ? dashboardStats : [];
                    const statIcons = ['queries', 'replied', 'users', 'active'];
                    const statIconNames = ['bi-grid', 'bi-database-check', 'bi-bell', 'bi-clock-history'];
                    for (let i = 0; i < 4; i += 1) {
                        const card = summaryCards[i] || { label: 'Metric', value: 0, helpText: 'No data available yet' };
                %>
                <div class="stat-card">
                    <div class="stat-icon <%= statIcons[i] %>">
                        <i class="bi <%= statIconNames[i] %>"></i>
                    </div>
                    <div class="stat-info">
                        <h3><%= card.label %></h3>
                        <div class="stat-number"><%= Number(card.value || 0).toLocaleString('en-IN') %></div>
                        <div class="stat-trend up">
                            <i class="bi bi-info-circle"></i> <%= card.helpText %>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>

            <!-- Charts Row -->
            <div class="charts-row">
                <div class="chart-card">
                    <div class="chart-header">
                        <h4><i class="bi bi-grid-1x2"></i> Module Overview</h4>
                        <span class="chart-badge"><%= (dashboardData && dashboardData.moduleCards ? dashboardData.moduleCards.length : 0) %> modules</span>
                    </div>
                    <div id="moduleOverviewGrid" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;"></div>
                </div>

                <div class="chart-card">
                    <div class="chart-header">
                        <h4><i class="bi bi-exclamation-triangle"></i> Priority Focus</h4>
                        <span class="chart-badge">Attention queue</span>
                    </div>
                    <div class="activity-list" id="priorityFocusList" style="padding:0; max-height:250px;"></div>
                </div>
            </div>

            <!-- Recent Activity Section -->
            <div class="activity-section">
                <div class="activity-card">
                    <div class="card-header">
                        <h4><i class="bi bi-activity"></i> Recent Activity</h4>
                        <span class="view-all">Live from your modules</span>
                    </div>
                    <div class="activity-list" id="recentActivityList"></div>
                </div>

                <div class="activity-card">
                    <div class="card-header">
                        <h4><i class="bi bi-folder2-open"></i> Access Summary</h4>
                        <span class="view-all">Role-based modules</span>
                    </div>
                    <div class="activity-list" id="accessSummaryList"></div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions">
                <h4><i class="bi bi-lightning-charge"></i> Quick Actions</h4>
                <div class="actions-grid">
                    <% if (hasAnyPermission('subscription', ['view', 'edit', 'delete'])) { %><a href="/plan" class="action-btn"><i class="bi bi-tags"></i><span>Plans</span></a><% } %>
                    <% if (hasAccess('subscription', 'add')) { %><a href="/addplan" class="action-btn"><i class="bi bi-plus-square"></i><span>Create Plan</span></a><% } %>
                    <% if (hasAccess('subscription', 'edit')) { %><a href="/subscription/settings" class="action-btn"><i class="bi bi-gear"></i><span>Payment Settings</span></a><% } %>
                    <% if (hasAccess('crm', 'view')) { %><a href="/addcontacttable" class="action-btn"><i class="bi bi-people"></i><span>All Contacts</span></a><% } %>
                    <% if (hasAccess('crm', 'add')) { %><a href="/addcontactform" class="action-btn"><i class="bi bi-person-plus"></i><span>Add Contact</span></a><% } %>
                    <% if (hasAccess('leadManagement', 'view')) { %><a href="/crm/leads" class="action-btn"><i class="bi bi-funnel"></i><span>View Leads</span></a><% } %>
                    <% if (hasAccess('leadManagement', 'add')) { %><a href="/crm/leads" class="action-btn" onclick="event.preventDefault(); window.location.href='/crm/leads?action=add'"><i class="bi bi-person-plus"></i><span>Add Lead</span></a><% } %>
                    <% if (hasAccess('dealManagement', 'view')) { %><a href="/crm/deals" class="action-btn"><i class="bi bi-kanban"></i><span>Deal Pipeline</span></a><% } %>
                    <% if (hasAccess('dealManagement', 'add')) { %><a href="/crm/deals" class="action-btn" onclick="event.preventDefault(); window.location.href='/crm/deals?action=add'"><i class="bi bi-plus-circle"></i><span>Add Deal</span></a><% } %>
                    <% if (hasAccess('hrm', 'view')) { %><a href="/employees" class="action-btn"><i class="bi bi-person-badge"></i><span>Employees</span></a><% } %>
                    <% if (hasAccess('hrm', 'add')) { %><a href="/AddNewEmployee" class="action-btn"><i class="bi bi-person-plus-fill"></i><span>Add Employee</span></a><% } %>
                    <% if (hasAccess('queryManagement', 'view')) { %><a href="/querytable" class="action-btn"><i class="bi bi-chat-dots"></i><span>View Queries</span></a><% } %>
                    <% if (hasAnyPermission('frontendManagement')) { %><a href="/faqtable" class="action-btn"><i class="bi bi-window"></i><span>Frontend CMS</span></a><% } %>
                    <% if (hasAnyPermission('productManagement', ['view', 'edit', 'delete'])) { %><a href="/producttable" class="action-btn"><i class="bi bi-box-seam"></i><span>Products</span></a><% } %>
                    <% if (hasAccess('productManagement', 'add')) { %><a href="/addproduct" class="action-btn"><i class="bi bi-plus-circle"></i><span>Add Product</span></a><% } %>
                    <% if (currentUserRole === 'SuperAdmin') { %><a href="/permissions" class="action-btn"><i class="bi bi-shield-check"></i><span>Permissions</span></a><% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Current Date and Time
    function updateDateTime() {
        const now = new Date();
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        const dateElement = document.getElementById('currentDate');
        const timeElement = document.getElementById('currentTime');
        if (dateElement) dateElement.textContent = now.toLocaleDateString('en-US', options);
        if (timeElement) timeElement.textContent = now.toLocaleTimeString('en-US');
    }
    updateDateTime();
    setInterval(updateDateTime, 1000);

    const dashboardData = <%- JSON.stringify(dashboardData || { moduleCards: [], recentActivity: [] }) %>;

    // Escape HTML helper
    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    function toTimeAgo(dateValue) {
        if (!dateValue) return 'Just now';
        const then = new Date(dateValue);
        if (Number.isNaN(then.getTime())) return 'Just now';

        const seconds = Math.floor((Date.now() - then.getTime()) / 1000);
        if (seconds < 60) return `${seconds} sec ago`;

        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes} min ago`;

        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`;

        const days = Math.floor(hours / 24);
        if (days < 7) return `${days} day${days > 1 ? 's' : ''} ago`;

        return then.toLocaleDateString('en-US');
    }

    const moduleOverviewGrid = document.getElementById('moduleOverviewGrid');
    const priorityFocusList = document.getElementById('priorityFocusList');
    const recentActivityList = document.getElementById('recentActivityList');
    const accessSummaryList = document.getElementById('accessSummaryList');
    const moduleCards = Array.isArray(dashboardData.moduleCards) ? dashboardData.moduleCards : [];
    const recentActivity = Array.isArray(dashboardData.recentActivity) ? dashboardData.recentActivity : [];

    if (moduleOverviewGrid) {
        if (moduleCards.length) {
            moduleCards.forEach((card) => {
                const cardNode = document.createElement('a');
                cardNode.href = card.link || '/dashboard';
                cardNode.className = 'action-btn';
                cardNode.style.textAlign = 'left';
                cardNode.innerHTML = `
                    <i class="bi ${escapeHtml(card.icon || 'bi-grid')}"></i>
                    <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:6px;">${escapeHtml(card.label || 'Module')}</div>
                    <div style="font-size:24px;font-weight:800;color:#111827;">${Number(card.total || 0).toLocaleString('en-IN')}</div>
                    <div style="font-size:12px;color:#475569;margin-top:8px;">${escapeHtml(card.primaryText || '')}</div>
                    <div style="font-size:11px;color:#94a3b8;margin-top:4px;">${escapeHtml(card.secondaryText || '')}</div>
                `;
                moduleOverviewGrid.appendChild(cardNode);
            });
        } else {
            moduleOverviewGrid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;"><i class="bi bi-shield-lock"></i><p>No modules are assigned to this role yet.</p></div>`;
        }
    }

    if (priorityFocusList) {
        const focusItems = moduleCards.filter(card => Number(card.alertCount || 0) > 0).slice(0, 5);
        if (focusItems.length) {
            focusItems.forEach((card) => {
                const item = document.createElement('a');
                item.href = card.link || '/dashboard';
                item.className = 'activity-item';
                item.style.textDecoration = 'none';
                item.innerHTML = `
                    <div class="activity-icon pending"><i class="bi bi-exclamation-circle"></i></div>
                    <div class="activity-content">
                        <div class="activity-title">${escapeHtml(card.label)}</div>
                        <div class="activity-time"><i class="bi bi-flag"></i> ${escapeHtml(card.secondaryText || card.primaryText || '')}</div>
                    </div>
                    <div class="activity-status pending">${Number(card.alertCount || 0)}</div>
                `;
                priorityFocusList.appendChild(item);
            });
        } else {
            priorityFocusList.innerHTML = `<div class="empty-state"><i class="bi bi-check2-circle"></i><p>No urgent follow-ups right now.</p></div>`;
        }
    }

    if (recentActivityList) {
        if (recentActivity.length) {
            recentActivity.forEach((entry) => {
                const item = document.createElement(entry.link ? 'a' : 'div');
                if (entry.link) item.href = entry.link;
                item.className = 'activity-item';
                item.style.textDecoration = 'none';
                item.innerHTML = `
                    <div class="activity-icon user"><i class="bi bi-lightning-charge"></i></div>
                    <div class="activity-content">
                        <div class="activity-title">${escapeHtml(entry.title || 'Update')}</div>
                        <div class="activity-time"><i class="bi bi-info-circle"></i> ${escapeHtml(entry.subtitle || '')}</div>
                        <div class="activity-time"><i class="bi bi-clock"></i> ${escapeHtml(toTimeAgo(entry.createdAt))}</div>
                    </div>
                    <div class="activity-status replied">${escapeHtml(entry.status || 'Updated')}</div>
                `;
                recentActivityList.appendChild(item);
            });
        } else {
            recentActivityList.innerHTML = `<div class="empty-state"><i class="bi bi-activity"></i><p>No recent activity found yet.</p></div>`;
        }
    }

    if (accessSummaryList) {
        if (moduleCards.length) {
            moduleCards.forEach((card) => {
                const item = document.createElement('div');
                item.className = 'activity-item';
                item.innerHTML = `
                    <div class="activity-icon replied"><i class="bi ${escapeHtml(card.icon || 'bi-grid')}"></i></div>
                    <div class="activity-content">
                        <div class="activity-title">${escapeHtml(card.label || 'Module')}</div>
                        <div class="activity-time"><i class="bi bi-bar-chart"></i> ${escapeHtml(card.primaryText || '')}</div>
                    </div>
                    <div class="activity-status replied">${Number(card.total || 0).toLocaleString('en-IN')}</div>
                `;
                accessSummaryList.appendChild(item);
            });
        } else {
            accessSummaryList.innerHTML = `<div class="empty-state"><i class="bi bi-folder-x"></i><p>Ask SuperAdmin to assign module permissions for this role.</p></div>`;
        }
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
