<%- include('../../partials/admin/header.ejs') %>

<style>
    body {
        margin: 0;
        padding: 0;
        background: #f5f7fb;
    }
    .main-wrapper {
        display: flex;
        min-height: 100vh;
    }
    .content-wrapper {
        flex: 1;
        margin-left: 280px;
        padding: 24px;
    }
    .card {
        max-width: 720px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
        margin: 20px auto;
    }
    .card h2 {
        margin: 0 0 10px;
        color: #991b1b;
        font-size: 24px;
    }
    .card p {
        margin: 6px 0;
        color: #334155;
    }
    .btn-row {
        margin-top: 18px;
        display: flex;
        gap: 12px;
    }
    .btn {
        text-decoration: none;
        border-radius: 8px;
        padding: 10px 14px;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        color: #1e293b;
    }
    .btn.primary {
        background: #3b82f6;
        color: #fff;
        border-color: #3b82f6;
    }
    @media (max-width: 768px) {
        .content-wrapper {
            margin-left: 0;
            padding: 14px;
        }
    }
</style>

<div class="main-wrapper">
    <%- include('../../partials/admin/left.ejs') %>
    <div class="content-wrapper">
        <div class="card">
            <h2>Access Not Allowed</h2>
            <p><strong>Module:</strong> <%= moduleName %></p>
            <p><strong>Action:</strong> <%= actionName %></p>
            <p>Access Denied. Please contact your administrator to request permission for this action.</p>
            <div class="btn-row">
                <a href="/dashboard" class="btn primary">Go to Dashboard</a>
                <a href="javascript:history.back()" class="btn">Go Back</a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
