<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | REAL ERP SaaS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --navy:      #1a2b4a;
            --navy-dark: #0f1c33;
            --gold:      #d4a017;
            --gold-light:#f0c040;
        }
        body { background: #f4f6f9; font-family: 'Segoe UI', sans-serif; margin:0; }

        /* TICKER */
        .announcement-bar { background: linear-gradient(to right, #0f1c33, #1a2b4a); display: flex; align-items: center; height: 40px; overflow: hidden; border-bottom: 2px solid #d4a017; }
        .announcement-label { background: #d4a017; color: #0f1c33; font-weight: 800; font-size: 12px; padding: 0 16px; height: 100%; display: flex; align-items: center; white-space: nowrap; flex-shrink: 0; }
        .ticker-wrapper { flex: 1; overflow: hidden; position: relative; }
        .ticker-wrapper::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 30px; background: linear-gradient(to right, #0f1c33, transparent); z-index: 1; }
        .ticker-track { display: inline-flex; white-space: nowrap; animation: ticker-move 40s linear infinite; padding-left: 100%; }
        .ticker-item { font-size: 13px; color: #e2e8f0; margin-right: 20px; display: inline-flex; align-items: center; gap: 7px; }
        .ticker-sep { color: #d4a017; margin: 0 20px; font-size: 10px; }
        @keyframes ticker-move { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }

        /* TOP BAR */
        .top-bar { background: var(--navy-dark); }

        /* NAVBAR */
        .navbar { border-bottom: 2px solid var(--gold); }
        .navbar .nav-link:hover { color: var(--gold) !important; }
        .btn-login { background-color: var(--navy) !important; border-radius: 10px; color: white !important; transition: 0.3s; }
        .btn-login:hover { background-color: var(--gold) !important; color: var(--navy) !important; }
        .badge-cart { background: var(--gold) !important; color: var(--navy) !important; }

        /* CONTACT PAGE */
        .contact-page { padding: 60px 0 80px; }
        .section-heading .gold { color: var(--gold); border-bottom: 3px solid var(--gold-light); padding-bottom: 5px; }
        .section-heading .dark { color: var(--navy-dark); }

        .contact-left {
            background: linear-gradient(to bottom right, var(--navy-dark), var(--navy));
            color: white;
            padding: 45px 40px;
            border-radius: 16px 0 0 16px;
        }
        .contact-left h6 { color: var(--gold-light); font-size: 13px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
        .contact-left p { color: #cbd5e1; font-size: 14px; margin-bottom: 0; }
        .contact-left a { color: var(--gold-light); text-decoration: none; }

        .contact-form .form-control {
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 14px;
            background: #fff;
            transition: border-color 0.2s;
            height: 46px;
        }
        .contact-form textarea.form-control { height: 140px; resize: vertical; }
        .contact-form .form-control:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,160,23,0.12); }
        .contact-form label { font-size: 13px; font-weight: 600; color: var(--navy-dark); margin-bottom: 5px; }
        .required-star { color: #e53e3e; }
        .contact-btn { background: var(--gold); color: var(--navy-dark); font-weight: 700; font-size: 15px; border: none; border-radius: 8px; padding: 12px 40px; transition: 0.3s; cursor: pointer; }
        .contact-btn:hover { background: var(--gold-light); transform: translateY(-1px); }

        /* FOOTER */
        .footer-link { color: #64748b; text-decoration: none; font-size: 14px; display: block; text-align: left; transition: 0.2s; padding: 2px 0; }
        .footer-link:hover { color: #d4a017; padding-left: 6px; }
        .footer-social { transition: transform 0.2s; display:inline-flex; }
        .footer-social:hover { transform: translateY(-3px); }
        .footer-heading { color: #0f1c33; font-weight: 800; font-size: 16px; margin-bottom: 0; text-align: left; }
        .footer-gold-line { width: 40px; height: 3px; background: #d4a017; border-radius: 2px; margin-top: 8px; margin-bottom: 22px; }
    </style>
</head>
<body>

<!-- ANNOUNCEMENT TICKER -->
<div class="announcement-bar">
    <div class="announcement-label">🔔 ANNOUNCEMENT</div>
    <div class="ticker-wrapper">
        <div class="ticker-track">
            <span class="ticker-item">🚀 <strong>REALERP v2.0 Is Here!</strong> &nbsp; New modules added — POS, Payroll & Advanced Reports.</span>
            <span class="ticker-sep">❖</span>
            <span class="ticker-item">🎉 <strong>Limited Time Offer — 30% Off!</strong> &nbsp; Use code REALERP30 at checkout.</span>
            <span class="ticker-sep">❖</span>
            <span class="ticker-item">💬 <strong>24/7 Support Available</strong> &nbsp; Our expert team is available round the clock.</span>
            <span class="ticker-sep">❖</span>
        </div>
    </div>
</div>

<!-- TOP BAR -->
<div class="top-bar text-white py-2 px-5 d-flex justify-content-between align-items-center">
    <div class="fw-semibold">
        <span style="color:#f0c040; font-size:15px;">REALBELL</span>
        <span style="color:white; font-size:15px;"> TECHNOLOGIES</span>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span style="color:#94a3b8; font-size:13px;">Enterprise ERP Solutions</span>
        <a href="/register" class="btn btn-sm px-3 fw-bold" style="background:var(--gold); color:var(--navy-dark); border:none;">Get Started</a>
    </div>
</div>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-light bg-white px-5 shadow-sm">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/images/companylogo.jpg" alt="logo" style="height:55px; width:auto; object-fit:contain; max-width:80px;">
        <div style="line-height:1.2;">
            <span style="font-size:18px; font-weight:800; color:var(--gold);">REAL</span><span style="font-size:18px; font-weight:800; color:var(--navy-dark);">ERP</span>
            <div style="font-size:10px; color:#94a3b8; letter-spacing:1.5px;">SAAS PLATFORM</div>
        </div>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContact">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navContact">
        <ul class="navbar-nav mx-auto fw-semibold align-items-center gap-3">
            <li class="nav-item"><a class="nav-link text-dark" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link text-dark" href="#">Products</a></li>
            <li class="nav-item"><a class="nav-link text-dark" href="#">Add-Ons</a></li>
            <li class="nav-item"><a class="nav-link text-dark" href="#">Bulk Discount</a></li>
            <li class="nav-item"><a class="nav-link text-dark" href="#">Development</a></li>
            <li class="nav-item"><a class="nav-link fw-bold" style="color:var(--gold);" href="/contact">Contact Us</a></li>
        </ul>
        <div class="d-flex align-items-center gap-4">
            <div class="position-relative">
                <i class="bi bi-cart3 fs-5 text-dark"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill badge-cart">0</span>
            </div>
            <a href="/login" class="btn btn-login px-4">Login</a>
        </div>
    </div>
</nav>

<!-- CONTACT SECTION -->
<section class="contact-page">
    <div class="container">

        <!-- Heading -->
        <div class="text-center mb-5 section-heading">
            <h1 style="font-weight:700; font-size:38px;">
                <span class="gold">Contact</span>
                <span class="dark"> Us</span>
            </h1>
            <p class="text-muted mt-2" style="font-size:15px;">Have questions? We would love to hear from you.</p>
        </div>

        <!-- Form Card -->
        <div class="row shadow-lg rounded-4 overflow-hidden mx-auto" style="max-width:1000px;">

            <!-- LEFT panel -->
            <div class="col-md-4 contact-left d-flex flex-column justify-content-between">
                <div>
                    <h3 class="fw-bold mb-3" style="color:white; font-size:26px;">Let's Talk</h3>
                    <p style="color:#94a3b8; font-size:14px; line-height:1.7; margin-bottom:28px;">
                        Fill out the form and our team will get back to you within 24 hours.
                    </p>
                    <div class="mb-4">
                        <h6>Email</h6>
                        <p><a href="mailto:vishakhagehlot1@gmail.com" style="color:var(--gold-light);">vishakhagehlot1@gmail.com</a></p>
                    </div>
                    <div class="mb-4">
                        <h6>Phone</h6>
                        <p>+91 8005778286</p>
                    </div>
                    <div class="mb-2">
                        <h6>Address</h6>
                        <p>Jaipur, Rajasthan, India</p>
                    </div>
                </div>
                <!-- SVG illustration -->
                <div class="text-center mt-4">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" style="width:100%; max-width:220px; opacity:0.75;">
                        <circle cx="200" cy="60" r="35" fill="#d4a017" opacity="0.8"/>
                        <rect x="165" y="90" width="70" height="90" rx="15" fill="#1e3a5f"/>
                        <rect x="130" y="95" width="40" height="12" rx="6" fill="#d4a017" opacity="0.7"/>
                        <rect x="230" y="95" width="40" height="12" rx="6" fill="#d4a017" opacity="0.7"/>
                        <rect x="155" y="175" width="25" height="60" rx="8" fill="#1e3a5f"/>
                        <rect x="220" y="175" width="25" height="60" rx="8" fill="#1e3a5f"/>
                        <rect x="80" y="230" width="240" height="12" rx="6" fill="#d4a017" opacity="0.6"/>
                        <rect x="140" y="175" width="120" height="55" rx="5" fill="#0f1c33"/>
                        <rect x="145" y="180" width="110" height="45" rx="3" fill="#243354"/>
                        <rect x="120" y="228" width="160" height="6" rx="3" fill="#0f1c33"/>
                        <circle cx="320" cy="100" r="22" fill="#d4a017" opacity="0.85"/>
                        <rect x="308" y="91" width="24" height="18" rx="3" fill="white"/>
                        <polyline points="308,91 320,102 332,91" fill="none" stroke="#d4a017" stroke-width="2"/>
                        <rect x="55" y="120" width="60" height="40" rx="10" fill="#d4a017" opacity="0.7"/>
                        <polygon points="80,160 75,175 95,160" fill="#d4a017" opacity="0.7"/>
                        <circle cx="75" cy="140" r="4" fill="white"/>
                        <circle cx="85" cy="140" r="4" fill="white"/>
                        <circle cx="95" cy="140" r="4" fill="white"/>
                    </svg>
                </div>
            </div>

            <!-- RIGHT form panel -->
            <div class="col-md-8 bg-white p-5">
                <% if (typeof success !== 'undefined') { %>
                <div class="alert alert-success"><%= success %></div>
                <% } %>

                <form method="post" action="/contact" class="contact-form">
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label>First Name <span class="required-star">*</span></label>
                            <input type="text" class="form-control" name="fname" required>
                        </div>
                        <div class="col-md-6">
                            <label>Last Name</label>
                            <input type="text" class="form-control" name="lname">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label>Email <span class="required-star">*</span></label>
                            <input type="email" class="form-control" name="email" required>
                        </div>
                        <div class="col-md-6">
                            <label>Phone</label>
                            <input type="text" class="form-control" name="phone">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label>Message</label>
                        <textarea class="form-control" name="moreDesc" rows="5"></textarea>
                    </div>
                    <button type="submit" class="contact-btn">Send Message</button>
                </form>
            </div>

        </div>
    </div>
</section>

<!-- FOOTER -->
