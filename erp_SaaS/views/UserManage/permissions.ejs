<%- include('../../partials/admin/header.ejs') %>

<style>
    :root {
        --admin-sidebar-width: 350px;
    }

    body { margin: 0; background: #f4f7fb; }
    .main-wrapper { display: flex; min-height: 100vh; }
    .content-wrapper {
        flex: 1;
        margin-left: var(--admin-sidebar-width);
        width: calc(100% - var(--admin-sidebar-width));
        padding: 24px;
    }
    .page-title h2 { margin: 0; color: #0f172a; font-size: 28px; }
    .page-title p { margin: 6px 0 0; color: #64748b; }
    .page-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
    }
    .save-btn {
        border: 0;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        color: #fff;
        font-weight: 700;
        border-radius: 10px;
        padding: 10px 18px;
    }
    .msg {
        margin-bottom: 14px;
        color: #166534;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
        padding: 10px 12px;
        border-radius: 10px;
    }
    .role-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }
    .role-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
    }
    .role-head {
        padding: 14px 16px;
        background: #fff7ed;
        border-bottom: 1px solid #fed7aa;
        color: #9a3412;
        font-weight: 700;
    }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
    th { background: #f8fafc; font-size: 12px; text-transform: uppercase; color: #64748b; }
    td.center, th.center { text-align: center; }
    .module-label { font-weight: 600; color: #1e293b; }
    @media (max-width: 992px) {
        .role-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
        .content-wrapper {
            margin-left: 0;
            width: 100%;
            padding: 14px;
        }
    }
</style>

<div class="main-wrapper">
    <%- include('../../partials/admin/left.ejs') %>
    <div class="content-wrapper">
        <form method="POST" action="/permissions">
            <div class="page-top">
                <div class="page-title">
                    <h2>Role Permission Matrix</h2>
                    <p>SuperAdmin yahan se decide karega kaun sa role kya View/Add/Edit/Delete kar sakta hai.</p>
                </div>
                <button class="save-btn" type="submit">
                    <i class="bi bi-check2-circle"></i> Save Permissions
                </button>
            </div>

            <% if (message) { %>
                <div class="msg"><%= message %></div>
            <% } %>

            <div class="role-grid">
                <% roles.forEach((role) => { %>
                    <div class="role-card">
                        <div class="role-head">Role: <%= role %></div>
                        <div style="overflow-x:auto;">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Module</th>
                                        <% actionKeys.forEach((action) => { %>
                                            <th class="center"><%= action.charAt(0).toUpperCase() + action.slice(1) %></th>
                                        <% }) %>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% permissionKeys.forEach((moduleKey) => { %>
                                        <tr>
                                            <td class="module-label"><%= moduleLabels[moduleKey] %></td>
                                            <% actionKeys.forEach((action) => { %>
                                                <td class="center">
                                                    <input
                                                        type="checkbox"
                                                        name="permissions[<%= role %>][<%= moduleKey %>][<%= action %>]"
                                                        <%= permissionsByRole[role][moduleKey][action] ? 'checked' : '' %>
                                                    />
                                                </td>
                                            <% }) %>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% }) %>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
