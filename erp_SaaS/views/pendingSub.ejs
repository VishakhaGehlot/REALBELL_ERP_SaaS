<%- include('../partials/admin/header.ejs') %>

<section id="dashboard">

  <!-- Sidebar -->
  <%- include('../partials/admin/left.ejs') %>

  <!-- Main Content -->
  <div class="main-content">

    <!-- Heading -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold">Subscription Management</h4>
    </div>

    <!-- Table Box -->
    <div class="table-box">
      <div class="table-responsive">

        <table class="table table-hover align-middle text-center">

          <thead>
            <tr>
              <th>Sr no.</th>
              <th>FirstName</th>
              <th>Email</th>
              <th>Plan</th>
              <th>Business Name</th>
              <th>Business Email</th>
              <th>Phone</th>
              <th>Payment</th>
              <th>Subscription</th>
            </tr>
          </thead>
          <tbody>

            <% if (userDetails.length) { %>
              <% userDetails.forEach((val, k) => { %>
                <tr>
                  <td><%= k + 1 %></td>
                  <td><%= val.name %></td>
                  <td><%= val.email %></td>
                  <td><%= val.planName || 'N/A' %> <br><small class="text-muted">Rs. <%= val.planPrice || 0 %></small></td>
                  <td><%= val.businessName %></td>
                  <td><%= val.businessEmail %></td>
                  <td><%= val.phone %></td>
                  <td>
                    <button class="btn <%= val.paymentStatus === 'Paid' ? 'btn-success' : (val.paymentStatus === 'Failed' ? 'btn-danger' : 'btn-warning') %>">
                      <%= val.paymentStatus %>
                    </button>
                  </td>
                  <td>
                    <button class="btn <%= val.subscriptionStatus === 'Active' ? 'btn-primary' : (val.subscriptionStatus === 'Cancelled' ? 'btn-danger' : 'btn-warning') %>">
                      <%= val.subscriptionStatus || 'Pending' %>
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" class="py-4 text-muted">No subscription requests found yet.</td>
              </tr>
            <% } %>
          </tbody>

        </table>

      </div>
    </div>

  </div>

</section>


<style>
/* ===== DASHBOARD LAYOUT ===== */

body{
  margin:0;
  background:#f4f6fb;
}

/* Sidebar */

.sidebar{
  width:260px;
  min-height:100vh;
  position:fixed;
  left:0;
  top:0;
}

/* Main content */

.main-content{
  margin-left:260px;
  padding:30px;
  min-height:100vh;
}

/* Table box */

.table-box{
  background:#fff;
  padding:20px;
  border-radius:12px;
  box-shadow:0 5px 20px rgba(0,0,0,0.05);
}

/* Table header */

.table thead{
  background:#f1f3f8;
}
</style>

</body>
</html>