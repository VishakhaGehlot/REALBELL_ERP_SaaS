<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PO <%= purchaseOrder.poNumber %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #fff; color: #1e293b; line-height: 1.6; }
        .po-container { max-width: 800px; margin: 0 auto; padding: 40px; }
        .po-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; padding-bottom: 20px; border-bottom: 3px solid #3b82f6; }
        .company-info h1 { color: #3b82f6; font-size: 32px; margin: 0; }
        .company-info p { color: #64748b; margin: 5px 0; }
        .po-details { text-align: right; }
        .po-details h2 { color: #1e293b; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 10px; }
        .po-number { font-size: 24px; font-weight: 700; color: #3b82f6; }
        .po-meta { margin-top: 10px; font-size: 14px; color: #64748b; }
        .billing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 40px; }
        .billing-block h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin: 0 0 10px; }
        .billing-block p { margin: 4px 0; font-size: 14px; }
        .billing-block .name { font-size: 18px; font-weight: 700; color: #1e293b; }
        .items-table { width: 100%; border-collapse: collapse; margin: 30px 0; }
        .items-table thead { background: #f8fafc; }
        .items-table th { padding: 12px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; border-bottom: 2px solid #e2e8f0; }
        .items-table td { padding: 14px 12px; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
        .items-table td:last-child, .items-table th:last-child { text-align: right; }
        .product-name { font-weight: 600; }
        .product-desc { font-size: 12px; color: #64748b; }
        .summary-section { width: 300px; margin-left: auto; margin-top: 30px; }
        .summary-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; }
        .summary-row.total { border-top: 2px solid #3b82f6; padding-top: 12px; margin-top: 8px; font-size: 20px; font-weight: 700; color: #3b82f6; }
        .status-badge { display: inline-block; padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
        .footer { margin-top: 60px; text-align: center; padding-top: 20px; border-top: 1px solid #e2e8f0; font-size: 12px; color: #94a3b8; }
        .print-actions { position: fixed; top: 20px; right: 20px; display: flex; gap: 10px; }
        .btn { padding: 12px 24px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
        .btn-print { background: #3b82f6; color: white; }
        .btn-close { background: #f1f5f9; color: #475569; }
        @media print {
            body { background: #fff; }
            .no-print { display: none; }
            .po-container { padding: 20px; }
        }
    </style>
</head>
<body>
    <div class="print-actions no-print">
        <button class="btn btn-print" onclick="window.print()">
            <i class="bi bi-printer"></i> Print PO
        </button>
        <button class="btn btn-close" onclick="window.close()">
            <i class="bi bi-x-lg"></i> Close
        </button>
    </div>
    
    <div class="po-container">
        <div class="po-header">
            <div class="company-info">
                <h1>REAL ERP</h1>
                <p>Enterprise Resource Planning</p>
                <p style="margin-top: 10px; font-size: 13px;">
                    <i class="bi bi-geo-alt"></i> Your Company Address<br>
                    <i class="bi bi-envelope"></i> info@realerp.com<br>
                    <i class="bi bi-telephone"></i> +91 98765 43210
                </p>
            </div>
            <div class="po-details">
                <h2>Purchase Order</h2>
                <div class="po-number"><%= purchaseOrder.poNumber %></div>
                <div class="po-meta">
                    <strong>Date:</strong> <%= purchaseOrder.poDate ? new Date(purchaseOrder.poDate).toLocaleDateString('en-IN') : '-' %><br>
                    <strong>Expected Delivery:</strong> <%= purchaseOrder.expectedDeliveryDate ? new Date(purchaseOrder.expectedDeliveryDate).toLocaleDateString('en-IN') : '-' %>
                </div>
                <div style="margin-top: 15px;">
                    <span class="status-badge" style="background: <%= purchaseOrder.status === 'Received' ? '#dcfce7' : purchaseOrder.status === 'Cancelled' ? '#fee2e2' : '#eff6ff' %>; color: <%= purchaseOrder.status === 'Received' ? '#166534' : purchaseOrder.status === 'Cancelled' ? '#991b1b' : '#3b82f6' %>;">
                        <%= purchaseOrder.status %>
                    </span>
                </div>
            </div>
        </div>
        
        <div class="billing-grid">
            <div class="billing-block">
                <h3>Vendor</h3>
                <p class="name"><%= purchaseOrder.vendorName %></p>
                <% if (purchaseOrder.vendorAddress) { %><p><%= purchaseOrder.vendorAddress %></p><% } %>
                <% if (purchaseOrder.vendorEmail) { %><p><i class="bi bi-envelope"></i> <%= purchaseOrder.vendorEmail %></p><% } %>
                <% if (purchaseOrder.vendorPhone) { %><p><i class="bi bi-telephone"></i> <%= purchaseOrder.vendorPhone %></p><% } %>
                <% if (purchaseOrder.vendorGstNumber) { %><p style="margin-top: 10px;"><strong>GSTIN:</strong> <%= purchaseOrder.vendorGstNumber %></p><% } %>
            </div>
            <div class="billing-block">
                <h3>Order Details</h3>
                <p><strong>Payment Terms:</strong> <%= purchaseOrder.paymentTerms || 'Net 30' %></p>
                <p><strong>Delivery Status:</strong> <%= purchaseOrder.deliveryStatus %></p>
                <p><strong>Payment Status:</strong> <%= purchaseOrder.paymentStatus %></p>
            </div>
        </div>
        
        <table class="items-table">
            <thead>
                <tr>
                    <th style="width: 40%;">Item Description</th>
                    <th class="text-center">Qty</th>
                    <th class="text-right">Unit Price</th>
                    <th class="text-right">Discount</th>
                    <th class="text-right">Tax</th>
                    <th class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                <% purchaseOrder.items.forEach((item, index) => { %>
                    <tr>
                        <td>
                            <div class="product-name"><%= index + 1 %>. <%= item.name %></div>
                            <% if (item.description) { %><div class="product-desc"><%= item.description %></div><% } %>
                        </td>
                        <td class="text-center"><%= item.quantity %></td>
                        <td class="text-right">₹<%= item.unitPrice.toLocaleString() %></td>
                        <td class="text-right"><%= item.discount %>%</td>
                        <td class="text-right"><%= item.taxPercent %>%</td>
                        <td class="text-right"><strong>₹<%= item.total.toLocaleString() %></strong></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        
        <div class="summary-section">
            <div class="summary-row">
                <span>Subtotal</span>
                <span>₹<%= purchaseOrder.subtotal.toLocaleString() %></span>
            </div>
            <div class="summary-row">
                <span>Total Discount</span>
                <span>- ₹<%= purchaseOrder.totalDiscount.toLocaleString() %></span>
            </div>
            <div class="summary-row">
                <span>Total Tax</span>
                <span>+ ₹<%= purchaseOrder.totalTax.toLocaleString() %></span>
            </div>
            <div class="summary-row total">
                <span>Total Amount</span>
                <span>₹<%= purchaseOrder.totalAmount.toLocaleString() %></span>
            </div>
        </div>
        
        <% if (purchaseOrder.notes || purchaseOrder.termsAndConditions) { %>
            <div style="margin-top: 40px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
                <% if (purchaseOrder.notes) { %>
                    <h4 style="font-size: 14px; margin: 0 0 10px;">Notes</h4>
                    <p style="font-size: 13px; color: #64748b; margin: 0;"><%= purchaseOrder.notes %></p>
                <% } %>
                <% if (purchaseOrder.termsAndConditions) { %>
                    <h4 style="font-size: 14px; margin: 20px 0 10px;">Terms & Conditions</h4>
                    <p style="font-size: 13px; color: #64748b; margin: 0;"><%= purchaseOrder.termsAndConditions %></p>
                <% } %>
            </div>
        <% } %>
        
        <div class="footer">
            <p>This is a computer-generated purchase order.</p>
            <p style="margin-top: 10px;">REAL ERP - Enterprise Resource Planning System</p>
        </div>
    </div>
</body>
</html>
