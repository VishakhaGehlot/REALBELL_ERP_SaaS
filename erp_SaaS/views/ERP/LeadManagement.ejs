<%- include('../../partials/admin/header.ejs') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Lead Management</title>
    <script>
        (function applySavedTheme() {
            try {
                const savedTheme = localStorage.getItem("erp-theme");
                if (savedTheme === "dark" || savedTheme === "light") {
                    document.documentElement.setAttribute("data-theme", savedTheme);
                }
            } catch (themeReadError) {}
        })();
    </script>
    <style>
        :root {
            --page-bg-start: #f8fafc;
            --page-bg-end: #eef2ff;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --card-bg: #ffffff;
            --card-border: #e2e8f0;
            --card-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
            --primary-bg-start: #2563eb;
            --primary-bg-end: #1d4ed8;
            --secondary-bg: #e0e7ff;
            --secondary-text: #3730a3;
            --success-bg: #dcfce7;
            --success-text: #166534;
            --warning-bg: #fef3c7;
            --warning-text: #92400e;
            --danger-bg: #fee2e2;
            --danger-text: #b91c1c;
            --input-bg: #ffffff;
            --input-border: #cbd5e1;
            --input-placeholder: #94a3b8;
            --focus-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
            --muted: #64748b;
        }

        [data-theme="dark"] {
            --page-bg-start: #0f172a;
            --page-bg-end: #1e293b;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --card-bg: #1e293b;
            --card-border: #334155;
            --card-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
            --input-bg: #334155;
            --input-border: #475569;
            --input-placeholder: #64748b;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, var(--page-bg-start), var(--page-bg-end));
            color: var(--text-primary);
            min-height: 100vh;
        }

        .main-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .content-wrapper {
            flex: 1;
            padding: 24px 32px;
            margin-left: 350px;
            max-width: calc(100% - 350px);
            box-sizing: border-box;
        }

        /* Hero Section */
        .hero {
            margin-bottom: 24px;
        }

        .hero h1 {
            font-size: 28px;
            font-weight: 800;
            margin: 0 0 8px;
            color: var(--text-primary);
        }

        .hero p {
            color: var(--text-secondary);
            margin: 0;
            font-size: 15px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 24px;
            box-shadow: var(--card-shadow);
            border: 1px solid var(--card-border);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        .stat-icon.blue { background: #dbeafe; }
        .stat-icon.green { background: #dcfce7; }
        .stat-icon.orange { background: #ffedd5; }
        .stat-icon.red { background: #fee2e2; }
        .stat-icon.purple { background: #f3e8ff; }

        .stat-content { flex: 1; }
        .stat-label { font-size: 13px; color: var(--text-secondary); margin-bottom: 4px; }
        .stat-value { font-size: 28px; font-weight: 800; color: var(--text-primary); }

        /* Cards */
        .card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 24px;
            box-shadow: var(--card-shadow);
            border: 1px solid var(--card-border);
            margin-bottom: 24px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-bg-start), var(--primary-bg-end));
            color: #fff;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
        }

        .btn-success {
            background: var(--success-bg);
            color: var(--success-text);
        }

        .btn-danger {
            background: var(--danger-bg);
            color: var(--danger-text);
        }

        /* Search Box */
        .search-box {
            position: relative;
            margin-bottom: 20px;
        }

        .search-box input {
            width: 100%;
            padding: 14px 18px 14px 46px;
            border: 1px solid var(--input-border);
            border-radius: 14px;
            background: var(--input-bg);
            font-size: 15px;
            color: var(--text-primary);
            box-sizing: border-box;
        }

        .search-box::before {
            content: "🔍";
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 18px;
        }

        /* Leads Grid */
        .leads-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .lead-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 20px;
            border: 1px solid var(--card-border);
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .lead-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
        }

        .lead-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .lead-avatar {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary-bg-start), var(--primary-bg-end));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #fff;
            font-weight: 700;
        }

        .lead-score {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .lead-score.hot { background: var(--danger-bg); color: var(--danger-text); }
        .lead-score.warm { background: var(--warning-bg); color: var(--warning-text); }
        .lead-score.cold { background: #dbeafe; color: #1d4ed8; }

        .lead-name {
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 4px;
            color: var(--text-primary);
        }

        .lead-company {
            font-size: 14px;
            color: var(--text-secondary);
            margin-bottom: 12px;
        }

        .lead-details {
            display: grid;
            gap: 8px;
            margin-bottom: 16px;
        }

        .lead-detail {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .lead-actions {
            display: flex;
            gap: 8px;
        }

        .lead-actions .btn {
            padding: 8px 14px;
            font-size: 13px;
        }

        /* Badges */
        .badge {
            display: inline-flex;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-new { background: #dbeafe; color: #1d4ed8; }
        .badge-qualified { background: #dcfce7; color: #166534; }
        .badge-proposal { background: #fef3c7; color: #92400e; }
        .badge-negotiation { background: #f3e8ff; color: #7c3aed; }
        .badge-won { background: var(--success-bg); color: var(--success-text); }
        .badge-lost { background: var(--danger-bg); color: var(--danger-text); }

        .badge-open { background: #dbeafe; color: #1d4ed8; }
        .badge-contacted { background: #fef3c7; color: #92400e; }
        .badge-converted { background: var(--success-bg); color: var(--success-text); }
        .badge-dormant { background: #e2e8f0; color: #475569; }

        /* Form Grid */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px 14px;
            border: 1px solid var(--input-border);
            border-radius: 12px;
            background: var(--input-bg);
            font-size: 14px;
            color: var(--text-primary);
            font-family: inherit;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-bg-start);
            box-shadow: var(--focus-shadow);
        }

        /* Score Visualization */
        .score-bar {
            height: 8px;
            background: #e2e8f0;
            border-radius: 4px;
            overflow: hidden;
            margin-top: 8px;
        }

        .score-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        .score-fill.hot { background: #ef4444; }
        .score-fill.warm { background: #f59e0b; }
        .score-fill.cold { background: #3b82f6; }

        /* Lead Score List */
        .score-list {
            display: grid;
            gap: 12px;
        }

        .score-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px;
            background: var(--card-bg);
            border-radius: 14px;
            border: 1px solid var(--card-border);
        }

        .score-rank {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .score-rank.gold { background: #fef3c7; color: #92400e; }
        .score-rank.silver { background: #e2e8f0; color: #475569; }
        .score-rank.bronze { background: #ffedd5; color: #9a3412; }
        .score-rank.normal { background: #f1f5f9; color: #64748b; }

        .score-info { flex: 1; }
        .score-info h4 { margin: 0 0 4px; font-size: 15px; }
        .score-info p { margin: 0; font-size: 13px; color: var(--text-secondary); }

        .score-value {
            font-size: 24px;
            font-weight: 800;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-state-icon {
            font-size: 64px;
            margin-bottom: 16px;
        }

        .empty-state h3 {
            font-size: 20px;
            margin: 0 0 8px;
            color: var(--text-primary);
        }

        .empty-state p {
            color: var(--text-secondary);
            margin: 0;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.active { display: flex; }

        .modal-content {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 28px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-header h3 { margin: 0; font-size: 20px; }

        .modal-close {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--text-secondary);
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid var(--card-border);
        }

        .detail-row:last-child { border-bottom: none; }

        .detail-label { color: var(--text-secondary); font-size: 14px; }
        .detail-value { font-weight: 600; font-size: 14px; }

        /* Error/Success Messages */
        .alert {
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background: var(--success-bg);
            color: var(--success-text);
            border: 1px solid #86efac;
        }

        .alert-error {
            background: var(--danger-bg);
            color: var(--danger-text);
            border: 1px solid #fca5a5;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: 1fr; }
            .leads-grid { grid-template-columns: 1fr; }
            .form-grid { grid-template-columns: 1fr; }
            .content-wrapper {
                padding: 16px;
                margin-left: 0;
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
<div class="main-wrapper">
    <%- include('../../partials/admin/left.ejs') %>
    <div class="content-wrapper">
        <%
            const leadRows = Array.isArray(leads) ? leads : [];
            const hotLeads = leadRows.filter((lead) => Number(lead.score || 0) >= 80).length;
            const warmLeads = leadRows.filter((lead) => Number(lead.score || 0) >= 50 && Number(lead.score || 0) < 80).length;
            const openLeads = leadRows.filter((lead) => lead.status === 'Open').length;
            const contactedLeads = leadRows.filter((lead) => lead.status === 'Contacted').length;
            const convertedLeads = leadRows.filter((lead) => lead.status === 'Converted').length;
            const totalPipeline = leadRows.reduce((sum, lead) => sum + (Number(lead.estimatedValue) || 0), 0);
            const currentTab = typeof activeTab !== 'undefined' ? activeTab : 'leads';
        %>

        <div class="hero">
            <h1><%= pageTitle %></h1>
            <p>Manage your sales pipeline, capture new leads, and track lead scores.</p>
        </div>

        <!-- Stats Row -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">👥</div>
                <div class="stat-content">
                    <div class="stat-label">Total Leads</div>
                    <div class="stat-value"><%= leadRows.length %></div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">💰</div>
                <div class="stat-content">
                    <div class="stat-label">Pipeline Value</div>
                    <div class="stat-value">₹<%= totalPipeline.toLocaleString('en-IN') %></div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">🔥</div>
                <div class="stat-content">
                    <div class="stat-label">Hot Leads (80+)</div>
                    <div class="stat-value"><%= hotLeads %></div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon purple">✅</div>
                <div class="stat-content">
                    <div class="stat-label">Converted</div>
                    <div class="stat-value"><%= convertedLeads %></div>
                </div>
            </div>
        </div>

        <!-- Messages -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <!-- ALL LEADS VIEW -->
        <% if (currentTab === 'leads') { %>
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Lead Pipeline</h2>
                    <a href="/lead-capture" class="btn btn-primary">+ Add Lead</a>
                </div>

                <div class="search-box">
                    <input type="text" id="leadSearch" placeholder="Search leads by name, company, or email..." onkeyup="filterLeads()">
                </div>

                <% if (leadRows.length) { %>
                    <div class="leads-grid" id="leadsGrid">
                        <% leadRows.forEach((lead) => { 
                            const score = Number(lead.score || 0);
                            const scoreClass = score >= 80 ? 'hot' : score >= 50 ? 'warm' : 'cold';
                            const stageClass = (lead.stage || 'New').toLowerCase();
                        %>
                            <div class="lead-card" data-name="<%= (lead.name || '').toLowerCase().replace(/"/g, '&quot;') %>" data-company="<%= (lead.company || '').toLowerCase().replace(/"/g, '&quot;') %>" data-email="<%= (lead.email || '').toLowerCase().replace(/"/g, '&quot;') %>">
                                <div class="lead-header">
                                    <div class="lead-avatar"><%= (lead.name || 'U').charAt(0).toUpperCase() %></div>
                                    <span class="lead-score <%= scoreClass %>">Score: <%= score %></span>
                                </div>
                                <h3 class="lead-name"><%= lead.name || 'Unnamed Lead' %></h3>
                                <p class="lead-company"><%= lead.company || 'No Company' %></p>
                                
                                <div class="lead-details">
                                    <div class="lead-detail">📧 <%= lead.email || 'No Email' %></div>
                                    <div class="lead-detail">📱 <%= lead.phone || 'No Phone' %></div>
                                    <div class="lead-detail">📊 <span class="badge badge-<%= stageClass %>"><%= lead.stage || 'New' %></span></div>
                                    <div class="lead-detail">💰 ₹<%= Number(lead.estimatedValue || 0).toLocaleString('en-IN') %></div>
                                </div>

                                <div class="score-bar">
                                    <div class="score-fill <%= scoreClass %>" style="width: <%= score %>%"></div>
                                </div>

                                <div class="lead-actions">
                                    <button class="btn btn-success" onclick="viewLead('<%= lead._id %>')">View</button>
                                    <a href="/lead-edit/<%= lead._id %>" class="btn" style="background: var(--secondary-bg); color: var(--secondary-text);">Edit</a>
                                    <form method="POST" action="/lead-delete/<%= lead._id %>" style="display: inline;" onsubmit="return confirm('Delete this lead?');">
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">👥</div>
                        <h3>No Leads Found</h3>
                        <p>Start capturing leads to build your pipeline.</p>
                        <a href="/lead-capture" class="btn btn-primary" style="margin-top: 16px;">Capture First Lead</a>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- LEAD CAPTURE VIEW -->
        <% if (currentTab === 'capture') { %>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">Capture New Lead</h2>
                    </div>
                    <form method="POST" action="/lead-capture">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Lead Name *</label>
                                <input type="text" name="name" placeholder="Enter lead name" required>
                            </div>
                            <div class="form-group">
                                <label>Company</label>
                                <input type="text" name="company" placeholder="Company name">
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" name="email" placeholder="email@example.com">
                            </div>
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" name="phone" placeholder="Phone number">
                            </div>
                            <div class="form-group">
                                <label>Source</label>
                                <select name="source">
                                    <option value="Website">Website</option>
                                    <option value="Campaign">Campaign</option>
                                    <option value="Referral">Referral</option>
                                    <option value="Cold Call">Cold Call</option>
                                    <option value="Social Media">Social Media</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Stage</label>
                                <select name="stage">
                                    <option value="New">New</option>
                                    <option value="Qualified">Qualified</option>
                                    <option value="Proposal">Proposal</option>
                                    <option value="Negotiation">Negotiation</option>
                                    <option value="Won">Won</option>
                                    <option value="Lost">Lost</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Lead Score (0-100)</label>
                                <input type="number" name="score" min="0" max="100" placeholder="50" value="50">
                            </div>
                            <div class="form-group">
                                <label>Estimated Value (₹)</label>
                                <input type="number" name="estimatedValue" min="0" placeholder="0">
                            </div>
                            <div class="form-group">
                                <label>Assigned To</label>
                                <input type="text" name="assignedTo" placeholder="Team member name">
                            </div>
                            <div class="form-group">
                                <label>Next Follow-up</label>
                                <input type="date" name="nextFollowUp">
                            </div>
                            <div class="form-group">
                                <label>Status</label>
                                <select name="status">
                                    <option value="Open">Open</option>
                                    <option value="Contacted">Contacted</option>
                                    <option value="Converted">Converted</option>
                                    <option value="Dormant">Dormant</option>
                                </select>
                            </div>
                            <div class="form-group full">
                                <label>Notes</label>
                                <textarea name="notes" rows="4" placeholder="Add any additional notes about this lead..."></textarea>
                            </div>
                            <div class="form-group full">
                                <button type="submit" class="btn btn-primary" style="width: 100%;">💾 Save Lead</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div>
                    <div class="card">
                        <h2 class="card-title" style="margin-bottom: 16px;">Recent Leads</h2>
                        <% if (typeof recentLeads !== 'undefined' && recentLeads.length) { %>
                            <div class="score-list">
                                <% recentLeads.forEach((lead) => { %>
                                    <div class="score-item" style="padding: 12px;">
                                        <div class="lead-avatar" style="width: 36px; height: 36px; font-size: 14px;"><%= (lead.name || 'U').charAt(0).toUpperCase() %></div>
                                        <div class="score-info">
                                            <h4 style="font-size: 14px;"><%= lead.name %></h4>
                                            <p><span class="badge badge-<%= (lead.stage || 'New').toLowerCase() %>"><%= lead.stage %></span></p>
                                        </div>
                                        <div style="font-weight: 700; color: var(--primary-bg-start);"><%= lead.score || 0 %></div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p style="color: var(--text-secondary); text-align: center;">No recent leads</p>
                        <% } %>
                    </div>

                    <div class="card" style="margin-top: 20px;">
                        <h2 class="card-title" style="margin-bottom: 16px;">Quick Tips</h2>
                        <div style="font-size: 13px; color: var(--text-secondary); line-height: 1.6;">
                            <p>• Score leads based on engagement (80+ = Hot)</p>
                            <p>• Set follow-up dates to stay on track</p>
                            <p>• Update stage as lead progresses</p>
                            <p>• Add estimated value for pipeline tracking</p>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- LEAD SCORING VIEW -->
        <% if (currentTab === 'score') { %>
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Lead Scoreboard</h2>
                    <span style="color: var(--text-secondary); font-size: 14px;">Ranked by engagement score</span>
                </div>

                <% if (leadRows.length) { %>
                    <div class="score-list">
                        <% leadRows.forEach((lead, index) => { 
                            const score = Number(lead.score || 0);
                            let rankClass = 'normal';
                            if (index === 0) rankClass = 'gold';
                            else if (index === 1) rankClass = 'silver';
                            else if (index === 2) rankClass = 'bronze';
                        %>
                            <div class="score-item">
                                <div class="score-rank <%= rankClass %>"><%= index + 1 %></div>
                                <div class="lead-avatar" style="width: 44px; height: 44px; font-size: 16px;"><%= (lead.name || 'U').charAt(0).toUpperCase() %></div>
                                <div class="score-info">
                                    <h4><%= lead.name || 'Unnamed Lead' %></h4>
                                    <p><%= lead.company || 'No Company' %> • <%= lead.assignedTo || 'Unassigned' %> • <span class="badge badge-<%= (lead.status || 'Open').toLowerCase() %>"><%= lead.status %></span></p>
                                </div>
                                <div style="flex: 1; max-width: 200px;">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                                        <span style="font-size: 12px; color: var(--text-secondary);">Engagement</span>
                                        <span style="font-size: 12px; font-weight: 700;"><%= score %>/100</span>
                                    </div>
                                    <div class="score-bar">
                                        <div class="score-fill <%= score >= 80 ? 'hot' : score >= 50 ? 'warm' : 'cold' %>" style="width: <%= score %>%"></div>
                                    </div>
                                </div>
                                <div class="score-value" style="color: <%= score >= 80 ? '#ef4444' : score >= 50 ? '#f59e0b' : '#3b82f6' %>;"><%= score %></div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div class="empty-state-icon">🏆</div>
                        <h3>No Leads to Score</h3>
                        <p>Capture leads to see them ranked by score.</p>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- EDIT LEAD VIEW -->
        <% if (currentTab === 'edit' && typeof leadToEdit !== 'undefined') { %>
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title">Edit Lead</h2>
                    </div>
                    <form method="POST" action="/lead-edit/<%= leadToEdit._id %>">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Lead Name *</label>
                                <input type="text" name="name" value="<%= leadToEdit.name %>" placeholder="Enter lead name" required>
                            </div>
                            <div class="form-group">
                                <label>Company</label>
                                <input type="text" name="company" value="<%= leadToEdit.company || '' %>" placeholder="Company name">
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" name="email" value="<%= leadToEdit.email || '' %>" placeholder="email@example.com">
                            </div>
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" name="phone" value="<%= leadToEdit.phone || '' %>" placeholder="Phone number">
                            </div>
                            <div class="form-group">
                                <label>Source</label>
                                <select name="source">
                                    <option value="Website" <%= (leadToEdit.source || '') === 'Website' ? 'selected' : '' %>>Website</option>
                                    <option value="Campaign" <%= (leadToEdit.source || '') === 'Campaign' ? 'selected' : '' %>>Campaign</option>
                                    <option value="Referral" <%= (leadToEdit.source || '') === 'Referral' ? 'selected' : '' %>>Referral</option>
                                    <option value="Cold Call" <%= (leadToEdit.source || '') === 'Cold Call' ? 'selected' : '' %>>Cold Call</option>
                                    <option value="Social Media" <%= (leadToEdit.source || '') === 'Social Media' ? 'selected' : '' %>>Social Media</option>
                                    <option value="Other" <%= (leadToEdit.source || '') === 'Other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Stage</label>
                                <select name="stage">
                                    <option value="New" <%= (leadToEdit.stage || '') === 'New' ? 'selected' : '' %>>New</option>
                                    <option value="Qualified" <%= (leadToEdit.stage || '') === 'Qualified' ? 'selected' : '' %>>Qualified</option>
                                    <option value="Proposal" <%= (leadToEdit.stage || '') === 'Proposal' ? 'selected' : '' %>>Proposal</option>
                                    <option value="Negotiation" <%= (leadToEdit.stage || '') === 'Negotiation' ? 'selected' : '' %>>Negotiation</option>
                                    <option value="Won" <%= (leadToEdit.stage || '') === 'Won' ? 'selected' : '' %>>Won</option>
                                    <option value="Lost" <%= (leadToEdit.stage || '') === 'Lost' ? 'selected' : '' %>>Lost</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Lead Score (0-100)</label>
                                <input type="number" name="score" min="0" max="100" value="<%= leadToEdit.score || 50 %>">
                            </div>
                            <div class="form-group">
                                <label>Estimated Value (₹)</label>
                                <input type="number" name="estimatedValue" min="0" value="<%= leadToEdit.estimatedValue || 0 %>">
                            </div>
                            <div class="form-group">
                                <label>Assigned To</label>
                                <input type="text" name="assignedTo" value="<%= leadToEdit.assignedTo || '' %>" placeholder="Team member name">
                            </div>
                            <div class="form-group">
                                <label>Next Follow-up</label>
                                <input type="date" name="nextFollowUp" value="<%= leadToEdit.nextFollowUp ? new Date(leadToEdit.nextFollowUp).toISOString().split('T')[0] : '' %>">
                            </div>
                            <div class="form-group">
                                <label>Status</label>
                                <select name="status">
                                    <option value="Open" <%= (leadToEdit.status || '') === 'Open' ? 'selected' : '' %>>Open</option>
                                    <option value="Contacted" <%= (leadToEdit.status || '') === 'Contacted' ? 'selected' : '' %>>Contacted</option>
                                    <option value="Converted" <%= (leadToEdit.status || '') === 'Converted' ? 'selected' : '' %>>Converted</option>
                                    <option value="Dormant" <%= (leadToEdit.status || '') === 'Dormant' ? 'selected' : '' %>>Dormant</option>
                                </select>
                            </div>
                            <div class="form-group full">
                                <label>Notes</label>
                                <textarea name="notes" rows="4" placeholder="Add any additional notes about this lead..."><%= leadToEdit.notes || '' %></textarea>
                            </div>
                            <div class="form-group full" style="display: flex; gap: 12px;">
                                <button type="submit" class="btn btn-primary" style="flex: 1;">💾 Update Lead</button>
                                <a href="/leads" class="btn" style="background: #e2e8f0; color: #475569;">Cancel</a>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="card">
                    <h2 class="card-title" style="margin-bottom: 16px;">Lead Summary</h2>
                    <div style="display: grid; gap: 16px;">
                        <div style="padding: 16px; background: #f8fafc; border-radius: 12px;">
                            <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">Created</div>
                            <div style="font-weight: 600;"><%= leadToEdit.createdAt ? new Date(leadToEdit.createdAt).toLocaleDateString() : '-' %></div>
                        </div>
                        <div style="padding: 16px; background: #f8fafc; border-radius: 12px;">
                            <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">Last Updated</div>
                            <div style="font-weight: 600;"><%= leadToEdit.updatedAt ? new Date(leadToEdit.updatedAt).toLocaleDateString() : '-' %></div>
                        </div>
                        <div style="padding: 16px; background: #f8fafc; border-radius: 12px;">
                            <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 4px;">Created By</div>
                            <div style="font-weight: 600;"><%= leadToEdit.createdBy || '-' %></div>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>

<!-- Lead Detail Modal -->
<div class="modal" id="leadModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Lead Details</h3>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div id="leadDetails"></div>
    </div>
</div>

<script>
    const leadsData = JSON.parse(`<%- JSON.stringify(leadRows).replace(/\\/g, '\\\\').replace(/`/g, '\\`') %>`);

    function filterLeads() {
        const searchTerm = document.getElementById('leadSearch').value.toLowerCase();
        const cards = document.querySelectorAll('.lead-card');
        
        cards.forEach(card => {
            const name = card.getAttribute('data-name') || '';
            const company = card.getAttribute('data-company') || '';
            const email = card.getAttribute('data-email') || '';
            
            if (name.includes(searchTerm) || company.includes(searchTerm) || email.includes(searchTerm)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function viewLead(leadId) {
        const lead = leadsData.find(l => l._id === leadId);
        if (!lead) return;

        const modal = document.getElementById('leadModal');
        const details = document.getElementById('leadDetails');
        
        details.innerHTML = `
            <div class="detail-row">
                <span class="detail-label">Name</span>
                <span class="detail-value">${lead.name || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Company</span>
                <span class="detail-value">${lead.company || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Email</span>
                <span class="detail-value">${lead.email || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Phone</span>
                <span class="detail-value">${lead.phone || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Source</span>
                <span class="detail-value">${lead.source || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Stage</span>
                <span class="detail-value">${lead.stage || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Score</span>
                <span class="detail-value">${lead.score || 0}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Estimated Value</span>
                <span class="detail-value">₹${Number(lead.estimatedValue || 0).toLocaleString('en-IN')}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Assigned To</span>
                <span class="detail-value">${lead.assignedTo || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Status</span>
                <span class="detail-value">${lead.status || '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Next Follow-up</span>
                <span class="detail-value">${lead.nextFollowUp ? new Date(lead.nextFollowUp).toLocaleDateString() : '-'}</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Notes</span>
                <span class="detail-value">${lead.notes || '-'}</span>
            </div>
        `;
        
        modal.classList.add('active');
    }

    function closeModal() {
        document.getElementById('leadModal').classList.remove('active');
    }

    document.getElementById('leadModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
</script>
</body>
</html>
