<%- include('../partials/admin/header.ejs') %>
<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f5f7fb;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    overflow-x: hidden;
    width: 100%;
}

.main-wrapper {
    display: flex;
    width: 100%;
    min-height: 100vh;
    position: relative;
}

.main-wrapper .sidebar {
    width: 280px;
    height: 100vh;
    background: white;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
    position: fixed;
    left: 0;
    top: 0;
    overflow-y: auto;
    padding: 0;
    z-index: 100;
}

.content-wrapper {
    flex: 1;
    margin-left: 280px;
    width: calc(100% - 280px);
    min-height: 100vh;
    background: #f5f7fb;
    padding: 25px;
    box-sizing: border-box;
}

.page-shell {
    max-width: 1360px;
    margin: 0 auto;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 14px;
}

.page-title h2 {
    color: #1e293b;
    font-weight: 800;
    margin: 0;
    font-size: 30px;
    display: flex;
    align-items: center;
    gap: 11px;
}

.page-title h2 i {
    color: #f59e0b;
    font-size: 32px;
}

.page-title p {
    color: #64748b;
    font-size: 14px;
    margin: 6px 0 0;
}

.btn-nav {
    background: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    padding: 10px 16px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
}

.btn-nav:hover {
    border-color: #f59e0b;
    color: #f59e0b;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
}

.stat-card,
.card-panel {
    background: #ffffff;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
}

.stat-card {
    padding: 16px;
    border-left: 4px solid transparent;
}

.stat-card.total { border-left-color: #8b5cf6; }
.stat-card.shown { border-left-color: #0f766e; }
.stat-card.revenue { border-left-color: #f59e0b; }
.stat-card.pending { border-left-color: #ef4444; }
.stat-card.active { border-left-color: #2563eb; }

.stat-label {
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    margin: 0;
}

.stat-value {
    margin: 8px 0 0;
    color: #1e293b;
    font-size: 26px;
    font-weight: 800;
}

.filter-panel {
    margin-bottom: 20px;
}

.filter-body {
    padding: 18px;
}

.filter-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr auto;
    gap: 12px;
    align-items: end;
}

.form-label {
    display: block;
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    margin-bottom: 7px;
}

.form-control,
.form-select {
    width: 100%;
    min-height: 44px;
    border-radius: 10px;
    border: 1px solid #dbe3ee;
    box-shadow: none !important;
    font-size: 14px;
}

.form-control:focus,
.form-select:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.12) !important;
}

.filter-actions {
    display: flex;
    gap: 8px;
}

.filter-actions .btn {
    min-height: 44px;
    border-radius: 10px;
    font-weight: 700;
}

.table-head {
    padding: 18px 20px;
    border-bottom: 1px solid #e2e8f0;
    background: #f8fafc;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.table-head .title {
    color: #1e293b;
    font-size: 16px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 9px;
}

.table-head .title i {
    color: #f59e0b;
}

.table-wrap {
    overflow: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1180px;
}

.data-table th {
    background: #f8fafc;
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

.data-table td {
    padding: 14px;
    border-bottom: 1px solid #eef2f7;
    color: #1e293b;
    font-size: 14px;
    vertical-align: top;
}

.invoice-no {
    font-weight: 800;
    color: #0f172a;
}

.meta-sub {
    display: block;
    margin-top: 4px;
    color: #64748b;
    font-size: 12px;
}

.amount-text {
    font-weight: 800;
}

.badge-soft {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
}

.badge-pending { background: #fef3c7; color: #92400e; }
.badge-active { background: #dcfce7; color: #166534; }
.badge-cancelled { background: #fee2e2; color: #991b1b; }

.empty-state {
    text-align: center;
    padding: 52px 20px;
    color: #64748b;
}

.empty-state i {
    font-size: 46px;
    display: block;
    margin-bottom: 12px;
    opacity: 0.45;
}

@media (max-width: 1200px) {
    .stats-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 992px) {
    .main-wrapper {
        flex-direction: column;
    }

    .main-wrapper .sidebar {
        width: 100%;
        height: auto;
        position: relative;
    }

    .content-wrapper {
        margin-left: 0;
        width: 100%;
        padding: 16px;
    }

    .filter-grid {
        grid-template-columns: 1fr;
    }

    .filter-actions {
        width: 100%;
    }

    .filter-actions .btn {
        flex: 1;
    }
}

@media (max-width: 680px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="main-wrapper">
    <%- include('../partials/admin/left.ejs') %>

    <main class="content-wrapper">
        <div class="page-shell">
            <div class="page-header">
                <div class="page-title">
                    <h2><i class="bi bi-receipt"></i> Invoice Center</h2>
                    <p>Professional invoice register for all paid subscriptions with customer, amount, and status visibility.</p>
                </div>
                <a href="/payment-history" class="btn-nav"><i class="bi bi-clock-history"></i> Payment History</a>
            </div>

            <div class="stats-grid">
                <div class="stat-card total"><p class="stat-label">Total Invoices</p><h3 class="stat-value"><%= stats.totalInvoices %></h3></div>
                <div class="stat-card shown"><p class="stat-label">Showing</p><h3 class="stat-value"><%= stats.shownInvoices %></h3></div>
                <div class="stat-card revenue"><p class="stat-label">Total Revenue</p><h3 class="stat-value">Rs. <%= Number(stats.totalRevenue || 0).toFixed(2) %></h3></div>
                <div class="stat-card pending"><p class="stat-label">Pending Activation</p><h3 class="stat-value"><%= stats.pendingActivation %></h3></div>
                <div class="stat-card active"><p class="stat-label">Active Subs</p><h3 class="stat-value"><%= stats.activeSubscriptions %></h3></div>
            </div>

            <section class="card-panel filter-panel">
                <div class="filter-body">
                    <form method="GET" action="/invoices" class="filter-grid">
                        <div>
                            <label class="form-label">Search</label>
                            <input type="text" class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Invoice no, customer, plan, payment ID">
                        </div>
                        <div>
                            <label class="form-label">Subscription Status</label>
                            <select class="form-select" name="status">
                                <option value="">All Status</option>
                                <% (statusOptions || []).forEach(function(status) { %>
                                    <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="filter-actions">
                            <button class="btn btn-warning" type="submit">Apply</button>
                            <a href="/invoices" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </form>
                </div>
            </section>

            <section class="card-panel">
                <div class="table-head">
                    <span class="title"><i class="bi bi-table"></i> Invoice Register</span>
                    <small class="text-muted">Paid subscriptions only</small>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Invoice No</th>
                                <th>Issue Date</th>
                                <th>Customer</th>
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Subscription</th>
                                <th>Transaction ID</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (invoices.length) { %>
                                <% invoices.forEach(function(invoice) { %>
                                    <tr>
                                        <td>
                                            <span class="invoice-no"><%= invoice.invoiceNo %></span>
                                            <span class="meta-sub">Ref: <%= invoice.razorpayOrderId || 'N/A' %></span>
                                        </td>
                                        <td><%= new Date(invoice.issuedAt).toLocaleDateString('en-IN') %></td>
                                        <td>
                                            <strong><%= invoice.customerName %></strong>
                                            <span class="meta-sub"><%= invoice.customerEmail || 'No email' %></span>
                                        </td>
                                        <td>
                                            <strong><%= invoice.planName || 'N/A' %></strong>
                                            <span class="meta-sub">Plan ID: <%= invoice.planId || 'N/A' %></span>
                                        </td>
                                        <td class="amount-text">Rs. <%= Number(invoice.amount || 0).toFixed(2) %></td>
                                        <td><%= invoice.paymentMethod || 'Not specified' %></td>
                                        <td>
                                            <span class="badge-soft <%= invoice.subscriptionStatus === 'Active' ? 'badge-active' : (invoice.subscriptionStatus === 'Cancelled' ? 'badge-cancelled' : 'badge-pending') %>">
                                                <i class="bi <%= invoice.subscriptionStatus === 'Active' ? 'bi-check-circle' : (invoice.subscriptionStatus === 'Cancelled' ? 'bi-x-circle' : 'bi-hourglass-split') %>"></i>
                                                <%= invoice.subscriptionStatus || 'Pending' %>
                                            </span>
                                        </td>
                                        <td><%= invoice.transactionId %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="bi bi-receipt-cutoff"></i>
                                            <h5>No invoices found</h5>
                                            <p>Try changing filters or complete a payment to generate invoices.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
</div>