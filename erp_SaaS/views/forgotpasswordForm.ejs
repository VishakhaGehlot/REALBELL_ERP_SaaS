<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | REAL ERP</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #667eea, #764ba2);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI';
        }

        .forgot-container {
            max-width: 450px;
            width: 100%;
        }

        .forgot-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .forgot-header {
            background: linear-gradient(135deg,#0f1c33,#1a2b4a);
            padding: 30px;
            text-align: center;
            border-bottom: 3px solid #d4a017;
        }

        .forgot-header h2 {
            color: white;
            font-size: 24px;
        }

        .forgot-body {
            padding: 35px;
        }

        .form-control {
            padding: 12px 12px 12px 40px;
            border-radius: 10px;
        }

        .input-group {
            position: relative;
            margin-bottom: 20px;
        }

        .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4a017;
        }

        .btn-send {
            width: 100%;
            background: #d4a017;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
        }

        .btn-send:hover {
            background: #f0c040;
        }

        .alert {
            border-radius: 10px;
        }
    </style>
</head>

<body>

<div class="forgot-container">
<div class="forgot-card">

<div class="forgot-header">
    <i class="bi bi-key-fill" style="font-size:40px;color:#d4a017;"></i>
    <h2>Reset Password</h2>
</div>

<div class="forgot-body">

<!-- MESSAGE -->
<% if(mess){ %>
<div class="alert alert-info text-center"><%= mess %></div>
<% } %>

<form method="post">

<!-- ================= STEP 1 EMAIL ================= -->
<% if(step === "email"){ %>

<div class="input-group">
    <i class="bi bi-envelope-fill input-icon"></i>
    <input type="email" name="email" class="form-control" placeholder="Enter Email" required>
</div>

<button class="btn-send">Send OTP</button>

<% } %>


<!-- ================= STEP 2 OTP ================= -->
<% if(step === "otp"){ %>

<input type="hidden" name="email" value="<%= email %>">

<div class="input-group">
    <i class="bi bi-shield-lock-fill input-icon"></i>
    <input type="text" name="otp" class="form-control" placeholder="Enter OTP" required>
</div>

<button class="btn-send">Verify OTP</button>

<% } %>


<!-- ================= STEP 3 RESET ================= -->
<% if(step === "reset"){ %>

<input type="hidden" name="email" value="<%= email %>">

<div class="input-group">
    <i class="bi bi-lock-fill input-icon"></i>
    <input type="password" name="newpassword" class="form-control" placeholder="New Password" required>
</div>

<button class="btn-send">Update Password</button>

<% } %>

</form>

<div class="text-center mt-3">
    <a href="/login">Back to Login</a>
</div>

</div>
</div>
</div>

</body>
</html>