<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Account</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <section class="mt-5">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-4"></div>

                <div class="col-md-4">
                    <h2 class="mb-3">Find Your Account</h2>
                    <% if (mess) { %>
                     <div class="alert alert-info text-center">
                         <%= mess %>
                     </div>
                    <% } %>
                   <form method="post">
                     <label class="form-label">Email</label>
                    <input type="email" class="form-control mb-3" placeholder="Enter Your Email-id/Username" name="email" required/>

                    <!-- Buttons Row -->
                    <div class="d-flex justify-content-between">
                        <button type="reset" class="btn btn-danger form-control ">Cancel</button>
                        <button type="submit" class="btn btn-success form-control ms-3">Send</button>
                    </div>
                   </form>

                </div>

                <div class="col-md-4"></div>
            </div>
        </div>
    </section>
</body>
</html>