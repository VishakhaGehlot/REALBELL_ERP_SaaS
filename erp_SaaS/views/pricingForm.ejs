<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Subscribe | REAL ERP SaaS</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<style>
    :root{
        --navy:#0f1c33;
        --navy-soft:#1f3358;
        --gold:#d4a017;
        --gold-soft:#f3c654;
        --mist:#eef2f7;
        --ink:#1f2937;
        --muted:#6b7280;
        --success:#166534;
        --danger:#b91c1c;
    }

    *{
        box-sizing:border-box;
    }

    body{
        margin:0;
        min-height:100vh;
        font-family:'Segoe UI',sans-serif;
        background:
            radial-gradient(circle at top left, rgba(212,160,23,0.20), transparent 32%),
            linear-gradient(135deg, #f8fafc 0%, #edf2f7 52%, #e5ebf3 100%);
        color:var(--ink);
    }

    .page-wrap{
        padding:48px 16px;
    }

    .shell{
        max-width:1200px;
        margin:0 auto;
    }

    .hero-bar{
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:16px;
        margin-bottom:28px;
        flex-wrap:wrap;
    }

    .brand{
        color:var(--navy);
        text-decoration:none;
        font-weight:800;
        letter-spacing:0.06em;
    }

    .hero-copy h1{
        margin:0 0 8px;
        font-size:clamp(2rem, 4vw, 3.1rem);
        font-weight:800;
        color:var(--navy);
    }

    .hero-copy p{
        margin:0;
        color:var(--muted);
        max-width:700px;
    }

    .content-grid{
        display:grid;
        grid-template-columns:1.1fr 0.9fr;
        gap:24px;
        align-items:start;
    }

    .panel{
        background:#fff;
        border-radius:28px;
        box-shadow:0 24px 60px rgba(15,28,51,0.08);
        border:1px solid rgba(15,28,51,0.06);
    }

    .form-panel{
        padding:32px;
    }

    .summary-panel{
        padding:28px;
        position:sticky;
        top:24px;
        overflow:hidden;
    }

    .summary-panel::before{
        content:"";
        position:absolute;
        inset:0;
        background:linear-gradient(180deg, rgba(212,160,23,0.14), transparent 35%);
        pointer-events:none;
    }

    .eyebrow{
        display:inline-flex;
        align-items:center;
        gap:8px;
        background:rgba(212,160,23,0.12);
        color:#9a6700;
        border-radius:999px;
        padding:8px 14px;
        font-size:0.84rem;
        font-weight:700;
        margin-bottom:16px;
    }

    .section-title{
        margin:0 0 8px;
        font-size:1.55rem;
        font-weight:800;
        color:var(--navy);
    }

    .section-subtitle{
        margin:0 0 24px;
        color:var(--muted);
    }

    .alert-banner{
        border:none;
        border-radius:16px;
        padding:14px 16px;
        margin-bottom:18px;
        font-weight:600;
    }

    .form-label{
        font-weight:700;
        color:var(--navy);
        margin-bottom:8px;
    }

    .form-control,.form-select{
        border-radius:14px;
        min-height:50px;
        border:1px solid #d7dee8;
        padding:12px 14px;
        box-shadow:none !important;
    }

    textarea.form-control{
        min-height:120px;
    }

    .field-hint{
        color:var(--muted);
        font-size:0.86rem;
        margin-top:6px;
    }

    .plan-box{
        border:1px solid #e5e7eb;
        border-radius:22px;
        padding:20px;
        background:linear-gradient(180deg, #fff, #fafbfd);
        margin-bottom:18px;
    }

    .plan-box h3{
        margin:0;
        font-size:1.35rem;
        font-weight:800;
        color:var(--navy);
    }

    .price-tag{
        font-size:2.2rem;
        font-weight:900;
        color:var(--gold);
        margin:10px 0 4px;
    }

    .price-tag span{
        font-size:1rem;
        color:var(--muted);
        font-weight:600;
    }

    .feature-list{
        list-style:none;
        padding:0;
        margin:18px 0 0;
    }

    .feature-list li{
        display:flex;
        gap:10px;
        align-items:flex-start;
        color:#334155;
        margin-bottom:10px;
    }

    .feature-list i{
        color:var(--success);
    }

    .summary-stat{
        display:flex;
        justify-content:space-between;
        gap:12px;
        align-items:center;
        padding:14px 0;
        border-bottom:1px solid #edf2f7;
        position:relative;
        z-index:1;
    }

    .summary-stat:last-child{
        border-bottom:none;
    }

    .summary-stat small{
        display:block;
        color:var(--muted);
        margin-bottom:4px;
    }

    .summary-stat strong{
        color:var(--navy);
        font-size:1rem;
    }

    .secure-box{
        margin-top:18px;
        border-radius:18px;
        background:var(--navy);
        color:#fff;
        padding:18px;
        position:relative;
        z-index:1;
    }

    .secure-box p{
        margin:0;
        color:#c9d5ea;
        font-size:0.92rem;
    }

    .submit-btn{
        min-height:56px;
        border:none;
        border-radius:16px;
        background:linear-gradient(90deg, var(--gold), var(--gold-soft));
        color:var(--navy);
        font-size:1rem;
        font-weight:800;
        width:100%;
        transition:transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow:0 14px 30px rgba(212,160,23,0.28);
    }

    .submit-btn:hover{
        transform:translateY(-1px);
    }

    .submit-btn:disabled{
        opacity:0.7;
        cursor:not-allowed;
        transform:none;
    }

    .status-message{
        margin-top:14px;
        min-height:24px;
        font-weight:600;
    }

    .status-message.error{
        color:var(--danger);
    }

    .status-message.success{
        color:var(--success);
    }

    @media (max-width: 991px){
        .content-grid{
            grid-template-columns:1fr;
        }

        .summary-panel{
            position:static;
        }
    }
</style>
</head>
<body>
<div class="page-wrap">
    <div class="shell">
        <div class="hero-bar">
            <div class="hero-copy">
                <a href="/" class="brand">REAL ERP SAAS</a>
                <h1>Step 1: Complete your registration details</h1>
                <p>Fill your business details first. The payment review page will open in the next step before Razorpay checkout.</p>
            </div>
            <a href="/" class="btn btn-outline-dark rounded-pill px-4 py-2">Back to Home</a>
        </div>

        <div class="content-grid">
            <div class="panel form-panel">
                <div class="eyebrow"><i class="bi bi-lightning-charge-fill"></i> Live subscription checkout</div>
                <h2 class="section-title">Business registration form</h2>
                <p class="section-subtitle">Submit this form to open the payment review step. Razorpay checkout will open from the next page.</p>

                <% if (success) { %>
                    <div class="alert alert-success alert-banner">
                        Payment successful. Your subscription request has been saved and is now waiting for admin approval.
                    </div>
                <% } %>

                <% if (error) { %>
                    <div class="alert alert-danger alert-banner">
                        <%= error %>
                    </div>
                <% } %>

                <% if (!razorpayConfigured && selectedPlan) { %>
                    <div class="alert alert-warning alert-banner">
                        Razorpay is not configured yet. Please ask the admin to save the Razorpay Key ID and Key Secret in Subscription Payment Settings.
                    </div>
                <% } %>

                <% if (!selectedPlan) { %>
                    <div class="alert alert-warning alert-banner mb-0">
                        No active subscription plan found. Please create and activate a plan first.
                    </div>
                <% } else { %>
                    <form id="subscriptionForm" method="POST" action="/subscription/checkout" novalidate>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Selected plan</label>
                                <select class="form-select" name="planId" id="planId" required>
                                    <% plans.forEach(function(plan) { %>
                                        <option
                                            value="<%= plan._id %>"
                                            data-title="<%= plan.title %>"
                                            data-price="<%= Number(plan.price || 0) %>"
                                            data-features="<%= encodeURIComponent(JSON.stringify(plan.features || [])) %>"
                                            <%= String(plan._id) === String(selectedPlan._id) ? 'selected' : '' %>>
                                            <%= plan.title %> - ₹ <%= plan.price %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Full name</label>
                                <input type="text" class="form-control" name="name" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" name="email" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <input type="text" class="form-control" name="phone" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Business name</label>
                                <input type="text" class="form-control" name="businessName" required>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Business address</label>
                                <textarea class="form-control" name="address" required></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Business type</label>
                                <input type="text" class="form-control" name="businessType" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Business email</label>
                                <input type="email" class="form-control" name="businessEmail" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Business phone</label>
                                <input type="text" class="form-control" name="businessPhone" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control" name="password" minlength="6" required>
                                <div class="field-hint">This password is stored securely after successful payment.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Confirm password</label>
                                <input type="password" class="form-control" name="confirmPassword" minlength="6" required>
                            </div>
                        </div>

                        <button type="submit" class="submit-btn mt-4" id="payButton" <%= razorpayConfigured ? '' : 'disabled' %>>
                            Continue to Razorpay Payment
                        </button>
                        <div class="status-message" id="statusMessage"></div>
                    </form>
                <% } %>
            </div>

            <div class="panel summary-panel">
                <% if (selectedPlan) { %>
                    <div class="plan-box">
                        <small class="text-uppercase fw-bold text-muted">Current selection</small>
                        <h3 id="summaryPlanName"><%= selectedPlan.title %></h3>
                        <div class="price-tag">₹ <span id="summaryPlanPrice"><%= selectedPlan.price %></span> <span>/ plan</span></div>
                        <ul class="feature-list" id="summaryFeatureList">
                            <% if (selectedPlan.features && selectedPlan.features.length) { %>
                                <% selectedPlan.features.forEach(function(feature) { %>
                                    <li><i class="bi bi-check-circle-fill"></i><span><%= feature %></span></li>
                                <% }) %>
                            <% } else { %>
                                <li><i class="bi bi-check-circle-fill"></i><span>Premium access enabled for this subscription.</span></li>
                            <% } %>
                        </ul>
                    </div>

                    <div class="summary-stat">
                        <div>
                            <small>Payment gateway</small>
                            <strong>Step 2: Payment Review</strong>
                        </div>
                        <i class="bi bi-shield-lock fs-4 text-success"></i>
                    </div>

                    <div class="summary-stat">
                        <div>
                            <small>After payment</small>
                            <strong>Open review page, then pay via Razorpay or UPI apps (PhonePe/GPay/Paytm)</strong>
                        </div>
                        <i class="bi bi-clock-history fs-4 text-warning"></i>
                    </div>

                    <div class="summary-stat">
                        <div>
                            <small>Records saved</small>
                            <strong>Saved only after successful payment</strong>
                        </div>
                        <i class="bi bi-database-check fs-4 text-primary"></i>
                    </div>

                    <div class="secure-box">
                        <h5 class="mb-2">Server setup note</h5>
                        <p>Admin must save Razorpay API Key ID and Key Secret in Subscription Payment Settings. Frontend key is loaded automatically from server settings.</p>
                    </div>
                <% } else { %>
                    <h3 class="section-title mb-0">Plan not available</h3>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById('subscriptionForm');
    const planSelect = document.getElementById('planId');
    const payButton = document.getElementById('payButton');
    const statusMessage = document.getElementById('statusMessage');
    const planNameNode = document.getElementById('summaryPlanName');
    const planPriceNode = document.getElementById('summaryPlanPrice');
    const featureListNode = document.getElementById('summaryFeatureList');

    function setStatus(message, type) {
        if (!statusMessage) return;
        statusMessage.textContent = message || '';
        statusMessage.className = 'status-message' + (type ? ' ' + type : '');
    }

    function getSelectedPlanMeta() {
        if (!planSelect) return null;
        const option = planSelect.options[planSelect.selectedIndex];
        if (!option) return null;

        let features = [];
        try {
            features = JSON.parse(decodeURIComponent(option.dataset.features || '[]'));
        } catch (error) {
            features = [];
        }

        return {
            id: option.value,
            title: option.dataset.title || option.textContent,
            price: option.dataset.price || '0',
            features
        };
    }

    function renderPlanSummary() {
        const plan = getSelectedPlanMeta();
        if (!plan) return;

        if (planNameNode) planNameNode.textContent = plan.title;
        if (planPriceNode) planPriceNode.textContent = plan.price;

        if (featureListNode) {
            const items = plan.features.length ? plan.features : ['Premium access enabled for this subscription.'];
            featureListNode.innerHTML = items.map((item) => `
                <li><i class="bi bi-check-circle-fill"></i><span>${item}</span></li>
            `).join('');
        }
    }

    if (planSelect) {
        planSelect.addEventListener('change', renderPlanSummary);
        renderPlanSummary();
    }

    if (form) {
        form.addEventListener('submit', function(event) {
            setStatus('', '');

            if (!form.reportValidity()) {
                event.preventDefault();
                return;
            }

            const formData = Object.fromEntries(new FormData(form).entries());
            const selectedPlan = getSelectedPlanMeta();

            if (!selectedPlan) {
                event.preventDefault();
                setStatus('Please select a valid plan.', 'error');
                return;
            }

            if (formData.password !== formData.confirmPassword) {
                event.preventDefault();
                setStatus('Password and confirm password must match.', 'error');
                return;
            }

            payButton.disabled = true;
            setStatus('Opening payment review page...', 'success');
        });
    }
</script>
</body>
</html>