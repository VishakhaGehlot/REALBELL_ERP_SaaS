<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>Register | Business Plan Signup</title>
  <!-- Bootstrap 5.3 CSS + Icons + Google Fonts for a modern, polished look -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Google Fonts: Inter for clean modern typography -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: linear-gradient(145deg, #f4f7fc 0%, #eef2f5 100%);
      font-family: 'Inter', sans-serif;
      padding: 2rem 1rem;
    }

    /* modern card with soft shadow and rounded corners */
    .form-card {
      max-width: 1100px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 36px;
      box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.2), 0 4px 12px rgba(0, 0, 0, 0.05);
      overflow: hidden;
      transition: transform 0.2s ease;
    }

    /* header section with gradient accent */
    .form-header {
      background: linear-gradient(135deg, #1a2a3a 0%, #0f1a24 100%);
      padding: 1.8rem 2rem;
      color: white;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .form-header h3 {
      font-weight: 700;
      margin: 0;
      font-size: 1.9rem;
      letter-spacing: -0.3px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .form-header h3 i {
      font-size: 2rem;
      background: rgba(255,255,255,0.15);
      padding: 8px;
      border-radius: 50%;
    }

    .form-header p {
      margin-top: 8px;
      margin-bottom: 0;
      opacity: 0.85;
      font-weight: 400;
      font-size: 0.95rem;
    }

    /* form body padding */
    .form-body {
      padding: 2rem 2rem 2rem 2rem;
    }

    /* labels modern style */
    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      color: #2c3e4e;
      margin-bottom: 6px;
    }

    .form-control, .form-select {
      border: 1.5px solid #e2e8f0;
      border-radius: 16px;
      padding: 0.7rem 1rem;
      font-size: 0.95rem;
      transition: all 0.2s;
      background-color: #fefefe;
    }

    .form-control:focus, .form-select:focus {
      border-color: #2c6e9e;
      box-shadow: 0 0 0 4px rgba(44, 110, 158, 0.15);
      outline: none;
    }

    textarea.form-control {
      resize: vertical;
      min-height: 90px;
    }

    /* row spacing */
    .row.gap-row {
      row-gap: 1.2rem;
    }

    /* button premium style */
    .btn-submit {
      background: #0f212f;
      border: none;
      padding: 0.9rem 1.8rem;
      font-weight: 700;
      font-size: 1.1rem;
      border-radius: 50px;
      color: white;
      transition: all 0.25s;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      justify-content: center;
      width: 100%;
      letter-spacing: 0.3px;
      box-shadow: 0 8px 18px rgba(15,33,47,0.2);
    }

    .btn-submit:hover {
      background: #1e3a4d;
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.15);
    }

    .btn-submit:active {
      transform: translateY(1px);
    }

    /* plan badge / hidden plan hint (styling for visual clarity) */
    .plan-badge {
      background: #eef2ff;
      padding: 0.5rem 1rem;
      border-radius: 100px;
      font-size: 0.85rem;
      font-weight: 600;
      color: #1e4a76;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 1rem;
    }

    .plan-badge i {
      font-size: 1.2rem;
    }

    hr.divider {
      margin: 1.8rem 0 1rem;
      background: #e4edf2;
      height: 2px;
      opacity: 0.6;
    }

    /* responsive touches */
    @media (max-width: 768px) {
      .form-body {
        padding: 1.5rem;
      }
      .form-header h3 {
        font-size: 1.5rem;
      }
      .btn-submit {
        padding: 0.8rem;
      }
    }

    /* field hint or small note */
    .field-note {
      font-size: 0.7rem;
      color: #6c7a89;
      margin-top: 4px;
      margin-left: 6px;
    }

    /* custom invalid style (for demo only, optional) */
    .was-validated .form-control:invalid, 
    .form-control.is-invalid {
      border-color: #e07c7c;
      background-image: none;
    }
  </style>
</head>
<body>

<div class="form-card">
  <div class="form-header">
    <h3>
      <i class="bi bi-journal-bookmark-fill"></i> 
      Register for Business Plan
    </h3>
    <p>Complete the details below to activate your premium subscription • Secure checkout & instant access</p>
  </div>

  <div class="form-body">
    <!-- Visual plan indicator (matches hidden input) – gives user context like the image style -->
    <div class="plan-badge">
      <i class="bi bi-stars"></i> 
      <span>Selected plan: <strong id="selectedPlanLabel">Professional Annual Plan</strong> • <i class="bi bi-credit-card"></i> Secure payment</span>
    </div>

    <!-- Registration form with POST method, includes hidden plan input -->
    <form id="registerForm" method="POST" action="#" novalidate>
      <!-- Hidden plan field - value can be changed dynamically based on selection (preset to 'professional_plan' but matches visual) -->
      <input type="hidden" name="plan" id="planHiddenInput" value="professional_annual">

      <div class="row g-4">
        <!-- LEFT COLUMN (Personal details) -->
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label"><i class="bi bi-person-circle me-1"></i> Full Name</label>
            <input type="text" name="name" class="form-control" placeholder="Johnathan Carter" required>
            <div class="field-note">As per government ID</div>
          </div>

          <div class="mb-3">
            <label class="form-label"><i class="bi bi-envelope"></i> Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="hello@yourcompany.com" required>
          </div>

          <div class="mb-3">
            <label class="form-label"><i class="bi bi-telephone"></i> Phone Number</label>
            <input type="tel" name="phone" class="form-control" placeholder="+91 98765 43210" required>
          </div>

          <div class="mb-3">
            <label class="form-label"><i class="bi bi-building"></i> Business Name</label>
            <input type="text" name="businessName" class="form-control" placeholder="Innovative Solutions LLC" required>
          </div>

          <div class="mb-3">
            <label class="form-label"><i class="bi bi-geo-alt"></i> Address</label>
            <textarea name="address" class="form-control" placeholder="Street, City, State, Postal Code" rows="3" required></textarea>
          </div>
        </div>

        <!-- RIGHT COLUMN (Business & account security) -->
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label"><i class="bi bi-briefcase"></i> Type of Business</label>
            <input type="text" name="businessType" class="form-control" placeholder="E-commerce, SaaS, Retail, Consulting, etc." required>
          </div>

          <div class="mb-3">
            <label class="form-label"><i class="bi bi-envelope-paper"></i> Business Email</label>
            <input type="email" name="businessEmail" class="form-control" placeholder="official@business.com" required>
          </div>

          <div class="mb-3">
            <label class="form-label"><i class="bi bi-phone-flip"></i> Business Phone</label>
            <input type="tel" name="businessPhone" class="form-control" placeholder="+1 (555) 000-9999" required>
          </div>

          <div class="mb-3">
            <label class="form-label"><i class="bi bi-lock"></i> Create Password</label>
            <input type="password" name="password" id="passwordField" class="form-control" placeholder="••••••••" required>
            <div class="field-note">Min. 8 characters with letters & numbers</div>
          </div>

          <div class="mb-4">
            <label class="form-label"><i class="bi bi-check-circle"></i> Confirm Password</label>
            <input type="password" name="confirmPassword" id="confirmPasswordField" class="form-control" placeholder="Confirm password" required>
            <div id="passwordMatchFeedback" class="invalid-feedback" style="font-size:0.75rem;"></div>
          </div>

          <!-- extra plan options: subtle plan switcher (to match any image reference that might show plan selection) 
               but we keep hidden field updatable to simulate plan pick from UI if needed. For perfection: 
               Add plan toggle chips similar to modern designs -->
          <div class="mb-2">
            <label class="form-label"><i class="bi bi-tags"></i> Plan Preference (optional)</label>
            <div class="d-flex flex-wrap gap-2 mt-1">
              <button type="button" class="btn btn-outline-dark rounded-pill btn-sm plan-option" data-plan="starter_monthly" data-plan-name="Starter Monthly">🚀 Starter Monthly</button>
              <button type="button" class="btn btn-dark rounded-pill btn-sm plan-option active-plan" data-plan="professional_annual" data-plan-name="Professional Annual">⭐ Professional Annual</button>
              <button type="button" class="btn btn-outline-dark rounded-pill btn-sm plan-option" data-plan="business_plus" data-plan-name="Business Plus">💎 Business Plus</button>
            </div>
            <div class="field-note">Selected plan will reflect on invoice & features</div>
          </div>
        </div>
      </div>

      <hr class="divider">

      <!-- terms and summary row -->
      <div class="row align-items-center mt-2">
        <div class="col-md-7 mb-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="termsCheckbox" required>
            <label class="form-check-label" for="termsCheckbox">
              I agree to the <a href="#" class="text-decoration-none">Terms of Service</a> and <a href="#" class="text-decoration-none">Privacy Policy</a>.
            </label>
          </div>
          <small class="text-muted"><i class="bi bi-shield-check"></i> Your data is encrypted & secure</small>
        </div>
        <div class="col-md-5 mb-3">
          <button type="submit" class="btn-submit" id="submitBtn">
            <i class="bi bi-credit-card-2-front"></i> Submit & Pay 
            <i class="bi bi-arrow-right-short"></i>
          </button>
        </div>
      </div>
    </form>

    <!-- additional note: payment methods visual (like image style sometimes shows card icons) -->
    <div class="text-center mt-3 pt-1">
      <span class="badge bg-light text-dark px-3 py-2 rounded-pill"><i class="bi bi-credit-card"></i> Visa • Mastercard • PayPal • UPI</span>
      <span class="badge bg-light text-dark px-3 py-2 rounded-pill ms-2"><i class="bi bi-lock-fill"></i> 256-bit SSL Secure</span>
    </div>
  </div>
</div>

<!-- Bootstrap JS bundle for proper form validation and interactions -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
  (function() {
    // DOM elements
    const form = document.getElementById('registerForm');
    const password = document.getElementById('passwordField');
    const confirmPassword = document.getElementById('confirmPasswordField');
    const passwordMatchFeedback = document.getElementById('passwordMatchFeedback');
    const termsCheckbox = document.getElementById('termsCheckbox');
    const hiddenPlanInput = document.getElementById('planHiddenInput');
    const selectedPlanLabelSpan = document.getElementById('selectedPlanLabel');
    
    // Plan option buttons (dynamic plan selection)
    const planButtons = document.querySelectorAll('.plan-option');
    
    // Function to update hidden plan value and UI badge
    function updateSelectedPlan(planValue, planDisplayName) {
      if (hiddenPlanInput) hiddenPlanInput.value = planValue;
      if (selectedPlanLabelSpan) selectedPlanLabelSpan.innerText = planDisplayName;
      
      // Update active visual styling on buttons
      planButtons.forEach(btn => {
        const btnPlan = btn.getAttribute('data-plan');
        if (btnPlan === planValue) {
          btn.classList.remove('btn-outline-dark');
          btn.classList.add('btn-dark', 'active-plan');
        } else {
          btn.classList.remove('btn-dark', 'active-plan');
          btn.classList.add('btn-outline-dark');
        }
      });
    }
    
    // Attach click handlers to plan option buttons
    planButtons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const planVal = this.getAttribute('data-plan');
        const planName = this.getAttribute('data-plan-name');
        if (planVal && planName) {
          updateSelectedPlan(planVal, planName);
        } else {
          // fallback values in case attributes missing (just safety)
          updateSelectedPlan('professional_annual', 'Professional Annual Plan');
        }
      });
    });
    
    // Real-time password match validation (for better UX)
    function validatePasswordMatch() {
      const passVal = password.value;
      const confirmVal = confirmPassword.value;
      
      if (confirmVal === "") {
        confirmPassword.classList.remove('is-invalid');
        passwordMatchFeedback.style.display = 'none';
        return true;
      }
      
      if (passVal === confirmVal && passVal.length > 0) {
        confirmPassword.classList.remove('is-invalid');
        passwordMatchFeedback.style.display = 'none';
        return true;
      } else {
        confirmPassword.classList.add('is-invalid');
        passwordMatchFeedback.innerText = "Passwords do not match. Please re-enter.";
        passwordMatchFeedback.style.display = 'block';
        return false;
      }
    }
    
    // Also check when password field changes
    password.addEventListener('input', function() {
      if (confirmPassword.value.length > 0) validatePasswordMatch();
    });
    confirmPassword.addEventListener('input', validatePasswordMatch);
    
    // Additional password strength note not required but keeps consistent.
    
    // Bootstrap custom validation: handle form submission with checks & show error messages
    form.addEventListener('submit', function(event) {
      // Prevent default submission for demonstration & validation
      event.preventDefault();
      
      // reset any previous custom validity messages
      let isValid = true;
      
      // 1) validate required fields (HTML5 required will be caught by browser validation, but we double-check manually for better UX)
      const allInputs = form.querySelectorAll('input[required], textarea[required]');
      for (let input of allInputs) {
        if (!input.value.trim()) {
          input.classList.add('is-invalid');
          isValid = false;
          // add custom styling feedback for empty fields
          if (!input.nextElementSibling?.classList?.contains('invalid-feedback-custom')) {
            // but we rely on bootstrap :invalid but we also trigger manually
          }
        } else {
          input.classList.remove('is-invalid');
        }
      }
      
      // special email format validation (quick)
      const emailFields = ['input[name="email"]', 'input[name="businessEmail"]'];
      emailFields.forEach(selector => {
        const field = form.querySelector(selector);
        if (field && field.value.trim() !== "") {
          const emailPattern = /^[^\s@]+@([^\s@]+\.)+[^\s@]+$/;
          if (!emailPattern.test(field.value.trim())) {
            field.classList.add('is-invalid');
            isValid = false;
          } else {
            field.classList.remove('is-invalid');
          }
        } else if (field && field.hasAttribute('required') && !field.value.trim()) {
          field.classList.add('is-invalid');
          isValid = false;
        }
      });
      
      // password match validation
      const matchOk = validatePasswordMatch();
      if (!matchOk) {
        isValid = false;
      } else {
        // if passwords are non-empty and match but length may be <8 (optional custom rule)
        if (password.value.length > 0 && password.value.length < 8) {
          password.classList.add('is-invalid');
          // Add custom feedback if needed
          let feedback = password.parentNode.querySelector('.invalid-feedback');
          if (!feedback) {
            feedback = document.createElement('div');
            feedback.className = 'invalid-feedback';
            feedback.innerText = 'Password must be at least 8 characters.';
            password.parentNode.appendChild(feedback);
          } else {
            feedback.innerText = 'Password must be at least 8 characters.';
          }
          feedback.style.display = 'block';
          isValid = false;
        } else {
          password.classList.remove('is-invalid');
          const existingFeedback = password.parentNode.querySelector('.invalid-feedback');
          if (existingFeedback) existingFeedback.style.display = 'none';
        }
      }
      
      // terms checkbox validation
      if (!termsCheckbox.checked) {
        termsCheckbox.classList.add('is-invalid');
        // show error if not checked
        let termsFeedback = document.getElementById('termsFeedback');
        if (!termsFeedback) {
          termsFeedback = document.createElement('div');
          termsFeedback.id = 'termsFeedback';
          termsFeedback.className = 'invalid-feedback';
          termsFeedback.style.display = 'block';
          termsFeedback.innerText = 'You must agree to the terms before submitting.';
          termsCheckbox.parentNode.appendChild(termsFeedback);
        } else {
          termsFeedback.style.display = 'block';
        }
        isValid = false;
      } else {
        termsCheckbox.classList.remove('is-invalid');
        const termsFeedback = document.getElementById('termsFeedback');
        if (termsFeedback) termsFeedback.style.display = 'none';
      }
      
      // Additional check for phone fields: allow any but if empty required fields we already did
      const phoneField = form.querySelector('input[name="phone"]');
      if (phoneField && phoneField.value.trim() === "" && phoneField.required) {
        phoneField.classList.add('is-invalid');
        isValid = false;
      } else if (phoneField) {
        phoneField.classList.remove('is-invalid');
      }
      
      const businessPhoneField = form.querySelector('input[name="businessPhone"]');
      if (businessPhoneField && businessPhoneField.value.trim() === "" && businessPhoneField.required) {
        businessPhoneField.classList.add('is-invalid');
        isValid = false;
      } else if (businessPhoneField) {
        businessPhoneField.classList.remove('is-invalid');
      }
      
      // Final check: if all fields are valid, show success message and simulate payment/redirect (like in modern registration)
      if (isValid) {
        // gather plan info for console / user notification (just like successful register)
        const selectedPlan = hiddenPlanInput.value;
        const planDisplay = selectedPlanLabelSpan ? selectedPlanLabelSpan.innerText : "Business Plan";
        // In real scenario, form would POST to server. For demo we show a beautiful toast / alert but perfectly match 'Submit & Pay' action.
        // Since the requirement is perfect registration form with similar image style, we show success simulation and also could log.
        // We also display alert (non-intrusive style) but to keep user informed:
        const formDataObj = {};
        const formInputs = form.querySelectorAll('input, textarea');
        formInputs.forEach(field => {
          if (field.name) formDataObj[field.name] = field.value;
        });
        
        // Sweet success simulation (professional)
        const successModalHtml = `
          <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-body text-center p-4">
                  <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                  <h4 class="mt-3 fw-bold">Registration & Payment Initiated</h4>
                  <p class="text-muted">Thank you, ${formDataObj.name || 'Valued Customer'}! Your <strong>${planDisplay}</strong> plan registration is successful.<br>Redirecting to secure payment gateway...</p>
                  <div class="spinner-border text-primary mt-2" role="status"></div>
                </div>
              </div>
            </div>
          </div>
        `;
        // append modal dynamically if not exists
        if (!document.getElementById('successModal')) {
          const modalDiv = document.createElement('div');
          modalDiv.innerHTML = successModalHtml;
          document.body.appendChild(modalDiv);
        }
        const myModal = new bootstrap.Modal(document.getElementById('successModal'), { backdrop: 'static', keyboard: false });
        myModal.show();
        
        // optional: log to console and after 3 sec, we could redirect but we keep as per form requirement.
        setTimeout(() => {
          myModal.hide();
          // optional: you could submit actual POST, but we demonstrate by showing alert 
          // Since requirement: perfect form like image, we won't auto-submit to server but can reset or keep.
          // Uncomment below line if you need actual POST to backend (but action is '#')
          // form.submit();
          console.log("✅ Registration data ready for backend:", formDataObj, "Plan:", selectedPlan);
        }, 2000);
        
        // prevent actual native submit
        return false;
      } else {
        // Scroll to first invalid field for user convenience
        const firstInvalid = form.querySelector('.is-invalid');
        if (firstInvalid) {
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalid.focus();
        }
        // show generic warning (subtle)
        const warningToast = document.createElement('div');
        warningToast.className = 'alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3 shadow rounded-pill';
        warningToast.style.zIndex = '9999';
        warningToast.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i> Please fill all required fields correctly and match passwords / accept terms.';
        document.body.appendChild(warningToast);
        setTimeout(() => warningToast.remove(), 3000);
      }
    });
    
    // Remove is-invalid class on input when user starts typing again
    const allReqFields = form.querySelectorAll('input, textarea');
    allReqFields.forEach(field => {
      field.addEventListener('input', function() {
        this.classList.remove('is-invalid');
        if (this.id === 'confirmPasswordField') validatePasswordMatch();
        if (this.type === 'checkbox') this.classList.remove('is-invalid');
      });
    });
    
    // init: ensure hidden plan value matches default active button (Professional Annual)
    updateSelectedPlan('professional_annual', 'Professional Annual Plan');
  })();
</script>

</body>
</html>