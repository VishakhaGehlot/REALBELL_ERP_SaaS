<%- include('../../partials/admin/header.ejs') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Razorpay Settings | Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f5f7fb;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            overflow-x: hidden;
            width: 100%;
        }

        .main-wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            position: relative;
        }

        .main-wrapper .sidebar {
            width: 280px;
            height: 100vh;
            background: white;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
            position: fixed;
            left: 0;
            top: 0;
            overflow-y: auto;
            padding: 0;
            z-index: 100;
            margin-top: 0;
        }

        .content-wrapper {
            flex: 1;
            margin-left: 280px;
            width: calc(100% - 280px);
            min-height: 100vh;
            background: #f5f7fb;
            padding: 25px;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .page-shell {
            max-width: 1180px;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

        .page-title h1 {
            margin: 0 0 8px;
            font-size: 2rem;
            color: #0f172a;
            font-weight: 800;
        }

        .page-title p {
            margin: 0;
            color: #64748b;
        }

        .settings-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 22px;
        }

        .card-panel {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
            padding: 28px;
        }

        .panel-title {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }

        .panel-title .icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: linear-gradient(135deg, #2563eb, #0f172a);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .panel-title h2 {
            margin: 0;
            font-size: 1.3rem;
            color: #0f172a;
            font-weight: 800;
        }

        .panel-title p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 0.94rem;
        }

        .alert-strip {
            border: none;
            border-radius: 16px;
            padding: 14px 16px;
            margin-bottom: 18px;
            font-weight: 600;
        }

        .form-label {
            color: #0f172a;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .form-control {
            min-height: 52px;
            border-radius: 14px;
            border: 1px solid #cbd5e1;
            padding: 12px 14px;
            box-shadow: none !important;
        }

        .field-note {
            margin-top: 8px;
            color: #64748b;
            font-size: 0.88rem;
        }

        .save-btn {
            min-height: 54px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(90deg, #3b82f6, #facc15);
            color: #0f172a;
            font-weight: 800;
            padding: 0 24px;
            box-shadow: 0 16px 32px rgba(59, 130, 246, 0.28);
        }

        .summary-list {
            display: grid;
            gap: 14px;
        }

        .summary-item {
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            padding: 16px 18px;
            background: #f8fafc;
        }

        .summary-item small {
            display: block;
            color: #64748b;
            margin-bottom: 6px;
        }

        .summary-item strong {
            color: #0f172a;
            font-size: 1rem;
            word-break: break-word;
        }

        .status-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 0.86rem;
            font-weight: 700;
        }

        .status-chip.ok {
            background: #dcfce7;
            color: #166534;
        }

        .status-chip.warn {
            background: #dbeafe;
            color: #92400e;
        }

        .steps {
            margin: 18px 0 0;
            padding-left: 18px;
            color: #475569;
        }

        .steps li {
            margin-bottom: 10px;
        }

        @media (max-width: 991px) {
            .main-wrapper {
                flex-direction: column;
            }

            .main-wrapper .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .content-wrapper {
                margin-left: 0;
                width: 100%;
                padding: 18px;
            }

            .settings-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="main-wrapper">
        <%- include('../../partials/admin/left.ejs') %>

        <main class="content-wrapper">
            <div class="page-shell">
                <div class="page-header">
                    <div class="page-title">
                        <h1>Razorpay Payment Settings</h1>
                    </div>
                    <a href="/plan" class="btn btn-outline-dark rounded-pill px-4 py-2">Back to Plans</a>
                </div>

                <div class="settings-grid">
                    <section class="card-panel">
                        <div class="panel-title">
                            <div class="icon"><i class="bi bi-credit-card-2-front"></i></div>
                            <div>
                                <h2>Gateway Credentials</h2>
                            </div>
                        </div>

                        <% if (success) { %>
                            <div class="alert alert-success alert-strip">
                                Razorpay settings saved successfully.
                            </div>
                        <% } %>

                        <% if (error) { %>
                            <div class="alert alert-danger alert-strip">
                                <%= error %>
                            </div>
                        <% } %>

                        <form action="/subscription/settings" method="POST">
                            <div class="mb-4">
                                <label class="form-label">Razorpay Key ID</label>
                                <input type="text" class="form-control" name="keyId" value="<%= config.keyId || '' %>" placeholder="rzp_live_xxxxx or rzp_test_xxxxx" required>
                                <div class="field-note">Paste only the key value. Do not paste <code>RAZORPAY_KEY_ID=...</code>.</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Razorpay Key Secret</label>
                                <input type="password" class="form-control" name="keySecret" placeholder="<%= config.hasSecret ? 'Leave blank to keep existing secret' : 'Enter Razorpay key secret' %>">
                                <div class="field-note">Use API Key Secret from Razorpay API Keys section, not webhook secret.</div>
                                
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Custom Paytm / UPI QR Payload (Optional)</label>
                                <textarea class="form-control" name="customUpiPayload" rows="3" placeholder="Paste UPI link like upi://pay?pa=merchant@upi&pn=Store&am=1 or any payment link"><%= config.customUpiPayload || '' %></textarea>
                                <div class="field-note">If added, this QR can be shown on checkout for manual scan payment (Paytm/PhonePe/GPay).</div>
                            </div>

                            <button type="submit" class="save-btn">Save Razorpay Settings</button>
                        </form>
                    </section>

                    <aside class="card-panel">
                        <div class="panel-title">
                            <div class="icon" style="background:linear-gradient(135deg,#16a34a,#14532d);"><i class="bi bi-shield-lock"></i></div>
                            <div>
                                <h2>Current Status</h2>
                            </div>
                        </div>

                        <div class="summary-list">
                            <div class="summary-item">
                                <small>Configuration Source</small>
                                <strong><%= config.source === 'database' ? 'Dashboard Database Settings' : 'Not Configured' %></strong>
                            </div>

                            <div class="summary-item">
                                <small>Checkout Status</small>
                                <% if (config.hasSecret && config.keyId) { %>
                                    <span class="status-chip ok"><i class="bi bi-check-circle-fill"></i> Ready for popup and scan payments</span>
                                <% } else { %>
                                    <span class="status-chip warn"><i class="bi bi-exclamation-triangle-fill"></i> Payment setup pending</span>
                                <% } %>
                            </div>

                            <div class="summary-item">
                                <small>Saved Key ID</small>
                                <strong><%= config.keyId || 'Not saved in dashboard yet' %></strong>
                            </div>

                            <div class="summary-item">
                                <small>Saved Secret</small>
                                <strong><%= config.hasSecret ? config.maskedSecret : 'Not saved yet' %></strong>
                            </div>

                            <div class="summary-item">
                                <small>Custom UPI QR</small>
                                <strong><%= config.customUpiPayload ? 'Configured' : 'Not configured' %></strong>
                            </div>

                            <div class="summary-item">
                                <small>Updated By</small>
                                <strong><%= config.updatedBy || 'System' %></strong>
                            </div>

                            <div class="summary-item">
                                <small>Updated At</small>
                                <strong><%= config.updatedAt ? new Date(config.updatedAt).toLocaleString() : 'Not available' %></strong>
                            </div>
                        </div>

                    </aside>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
