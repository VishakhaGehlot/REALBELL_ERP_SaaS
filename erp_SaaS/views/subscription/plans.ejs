<%- include('../../partials/admin/header.ejs') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Subscription Plans | Admin Panel</title>
    <!-- Bootstrap Icons & Fonts -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background: #f5f7fb;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            overflow-x: hidden;
            width: 100%;
        }

        /* Main wrapper - flex layout */
        .main-wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            position: relative;
        }

        /* Sidebar fixed width */
        .main-wrapper .sidebar {
            width: 280px;
            height: 100vh;
            background: white;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
            position: fixed;
            left: 0;
            top: 0;
            overflow-y: auto;
            padding: 0;
            z-index: 100;
        }

        /* Content wrapper - matches sidebar width */
        .content-wrapper {
            flex: 1;
            margin-left: 280px;
            width: calc(100% - 280px);
            min-height: 100vh;
            background: #f5f7fb;
            padding: 25px;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .container-fluid {
            width: 100%;
            padding-right: 15px;
            padding-left: 15px;
            margin-right: auto;
            margin-left: auto;
            box-sizing: border-box;
            max-width: 100%;
        }

        /* Page Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .page-header h2 {
            color: #1e293b;
            font-weight: 700;
            margin: 0;
            font-size: 28px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .page-header h2 i {
            color: #3b82f6;
            font-size: 32px;
        }

        .page-header p {
            color: #64748b;
            font-size: 14px;
            margin: 5px 0 0;
        }

        .btn-add {
            background: #3b82f6;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 6px rgba(59, 130, 246, 0.25);
            transition: all 0.3s ease;
            cursor: pointer;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-add:hover {
            background: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(59, 130, 246, 0.35);
            color: white;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.08);
            border: 1px solid #dbeafe;
            border-left: 4px solid #3b82f6;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(59, 130, 246, 0.15);
        }

        .stat-card.blue { border-left-color: #3b82f6; }
        .stat-card.green { border-left-color: #10b981; }
        .stat-card.orange { border-left-color: #f59e0b; }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-label {
            color: #64748b;
            font-size: 13px;
            font-weight: 500;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            color: #1e293b;
            font-weight: 700;
            margin: 8px 0 0;
            font-size: 28px;
        }

        .stat-icon {
            font-size: 32px;
            opacity: 0.6;
        }

        .stat-icon.blue { color: #3b82f6; }
        .stat-icon.green { color: #3b82f6; }
        .stat-icon.orange { color: #3b82f6; }

        /* Table Card */
        .table-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08);
            border: 1px solid #dbeafe;
            overflow: hidden;
            width: 100%;
            margin-top: 20px;
        }

        .table-header {
            padding: 18px 20px;
            border-bottom: 1px solid #dbeafe;
            background: #eff6ff;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .table-header i {
            color: #3b82f6;
            font-size: 20px;
        }

        .table-header span {
            font-weight: 600;
            color: #1e293b;
            font-size: 16px;
        }

        .table-responsive {
            overflow-x: auto;
            width: 100%;
            -webkit-overflow-scrolling: touch;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        th {
            background: #f8fafc;
            border-bottom: 2px solid #e9ecef;
            padding: 15px 16px;
            text-align: left;
            color: #64748b;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        td {
            padding: 15px 16px;
            border-bottom: 1px solid #e9ecef;
            color: #1e293b;
            font-size: 14px;
            vertical-align: middle;
        }

        tr {
            transition: background-color 0.3s ease;
        }

        tr:hover {
            background-color: #fafbfc;
        }

        /* Features list styling */
        .features-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-width: 280px;
        }
        .feature-badge {
            background: #dbeafe;
            padding: 4px 10px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 500;
            color: #1e40af;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .feature-badge i {
            font-size: 10px;
            color: #3b82f6;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .status-badge.pending {
            background: #fef3c7;
            color: #92400e;
        }
        .status-badge.active {
            background: #dcfce7;
            color: #166534;
        }
        .status-badge.inactive {
            background: #fee2e2;
            color: #991b1b;
        }
        .status-badge:hover {
            filter: brightness(0.95);
            transform: scale(0.98);
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            justify-content: flex-start;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            color: white;
            text-decoration: none;
            background: #e2e8f0;
            color: #1e293b;
        }
        .action-btn.edit {
            background: #3b82f6;
            color: white;
        }
        .action-btn.edit:hover {
            background: #2563eb;
            transform: scale(1.05);
        }
        .action-btn.delete {
            background: #ef4444;
            color: white;
        }
        .action-btn.delete:hover {
            background: #dc2626;
            transform: scale(1.05);
        }
        /* price highlight */
        .price-tag {
            font-weight: 700;
            color: #0f172a;
            font-size: 16px;
        }
        .price-currency {
            font-size: 13px;
            font-weight: 500;
            color: #3b82f6;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: #94a3b8;
        }
        .empty-state i {
            font-size: 60px;
            display: block;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        .empty-state h5 {
            color: #1e293b;
            margin: 0 0 8px;
            font-size: 20px;
        }
        .empty-state p {
            color: #64748b;
            margin: 0;
            font-size: 14px;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .stats-grid { gap: 15px; }
        }
        @media (max-width: 768px) {
            .main-wrapper { flex-direction: column; }
            .main-wrapper .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }
            .content-wrapper {
                margin-left: 0;
                width: 100%;
                padding: 20px 15px;
            }
            .stats-grid { grid-template-columns: 1fr; gap: 15px; }
            .page-header { flex-direction: column; align-items: flex-start; }
            .page-header h2 { font-size: 24px; }
            .btn-add { width: 100%; justify-content: center; }
            .table-card { border-radius: 8px; }
            td, th { padding: 12px; }
        }
        @media (max-width: 480px) {
            .content-wrapper { padding: 15px 12px; }
            .stat-card { padding: 15px; }
            .stat-value { font-size: 24px; }
            .action-btn { width: 32px; height: 32px; }
            .features-list { max-width: 200px; }
        }
        /* Tooltip / small */
        .plan-title {
            font-weight: 600;
            color: #0f172a;
        }
        .badge-icon {
            margin-right: 4px;
        }
        a.status-badge {
            cursor: pointer;
        }

        /* Dark mode styles for this page */
        [data-theme="dark"] body {
            background: #090f1f !important;
        }

        [data-theme="dark"] .main-wrapper {
            background: #090f1f !important;
        }

        [data-theme="dark"] .main-wrapper .sidebar {
            background: #111a2e !important;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3) !important;
        }

        [data-theme="dark"] .content-wrapper {
            background: #090f1f !important;
        }

        [data-theme="dark"] .page-header h2 {
            color: #e5e7eb !important;
        }

        [data-theme="dark"] .page-header p {
            color: #9fb0cb !important;
        }

        [data-theme="dark"] .stat-card {
            background: #111a2e !important;
            border-color: #253454 !important;
        }

        [data-theme="dark"] .stat-label {
            color: #9fb0cb !important;
        }

        [data-theme="dark"] .stat-value {
            color: #e5e7eb !important;
        }

        [data-theme="dark"] .table-card {
            background: #111a2e !important;
            border-color: #253454 !important;
        }

        [data-theme="dark"] .table-header {
            background: #0d1427 !important;
            border-color: #253454 !important;
        }

        [data-theme="dark"] .table-header span {
            color: #e5e7eb !important;
        }

        [data-theme="dark"] th {
            background: #0d1427 !important;
            color: #9fb0cb !important;
            border-color: #253454 !important;
        }

        [data-theme="dark"] td {
            background: #111a2e !important;
            color: #e5e7eb !important;
            border-color: #253454 !important;
        }

        [data-theme="dark"] tr:hover {
            background-color: #16233d !important;
        }

        [data-theme="dark"] tr:hover td {
            background-color: #16233d !important;
        }

        [data-theme="dark"] .feature-badge {
            background: #1e3a8a !important;
            color: #dbeafe !important;
        }

        [data-theme="dark"] .feature-badge i {
            color: #facc15 !important;
        }

        [data-theme="dark"] .status-badge.pending {
            background: #713f12 !important;
            color: #fef3c7 !important;
        }

        [data-theme="dark"] .status-badge.active {
            background: #14532d !important;
            color: #dcfce7 !important;
        }

        [data-theme="dark"] .status-badge.inactive {
            background: #7f1d1d !important;
            color: #fee2e2 !important;
        }

        [data-theme="dark"] .action-btn {
            background: #1e3a8a !important;
            color: #e5e7eb !important;
        }

        [data-theme="dark"] .action-btn.edit {
            background: #eab308 !important;
            color: #0f172a !important;
        }

        [data-theme="dark"] .action-btn.delete {
            background: #ef4444 !important;
            color: white !important;
        }

        [data-theme="dark"] .plan-title {
            color: #e5e7eb !important;
        }

        [data-theme="dark"] .price-tag {
            color: #e5e7eb !important;
        }

        [data-theme="dark"] .price-currency {
            color: #facc15 !important;
        }

        [data-theme="dark"] .empty-state h5 {
            color: #e5e7eb !important;
        }

        [data-theme="dark"] .empty-state p,
        [data-theme="dark"] .empty-state i {
            color: #9fb0cb !important;
        }
    </style>
</head>
<body>
<div class="main-wrapper">
    <!-- Sidebar partial simulation (matching original left.ejs) -->
    <div class="sidebar">
        <!-- this would normally be <%- include('../../partials/admin/left.ejs')%> -->
        <!-- for design preview we inject minimal sidebar UI to match style -->
        <div style="padding: 24px 20px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 32px;">
                <i class="bi bi-grid-1x2-fill" style="font-size: 28px; color: #f59e0b;"></i>
                <span style="font-weight: 700; font-size: 20px; color: #0f172a;">AdminKit</span>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0;">
                <li style="margin-bottom: 8px;"><a href="#" style="display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 10px; background: #fef3c7; color: #f59e0b; text-decoration: none; font-weight: 500;"><i class="bi bi-cpu"></i> Plans</a></li>
                <li style="margin-bottom: 8px;"><a href="#" style="display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 10px; color: #475569; text-decoration: none;"><i class="bi bi-people"></i> Accounts</a></li>
                <li style="margin-bottom: 8px;"><a href="#" style="display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 10px; color: #475569; text-decoration: none;"><i class="bi bi-credit-card"></i> Payments</a></li>
            </ul>
        </div>
    </div>

    <div class="content-wrapper">
        <div class="container-fluid">
            <!-- Page Header -->
            <div class="page-header">
                <div>
                    <h2>
                        <i class="bi bi-tags"></i>
                        Subscription Plans
                    </h2>
                    <p>Manage pricing plans, features, and subscription statuses</p>
                </div>
                <a href="/addplan" class="btn-add">
                    <i class="bi bi-plus-circle"></i>
                    Create New Plan
                </a>
            </div>

            <!-- Stats Cards (dynamic counts from Data) -->
            <div class="stats-grid">
                <div class="stat-card blue">
                    <div class="stat-header">
                        <div>
                            <p class="stat-label">Total Plans</p>
                            <h3 class="stat-value"><%= Data ? Data.length : 0 %></h3>
                        </div>
                        <i class="bi bi-collection stat-icon blue"></i>
                    </div>
                </div>
                <div class="stat-card green">
                    <div class="stat-header">
                        <div>
                            <p class="stat-label">Active Plans</p>
                            <h3 class="stat-value">
                                <%= Data ? Data.filter(p => p.Status === 'Active').length : 0 %>
                            </h3>
                        </div>
                        <i class="bi bi-check2-circle stat-icon green"></i>
                    </div>
                </div>
                <div class="stat-card orange">
                    <div class="stat-header">
                        <div>
                            <p class="stat-label">Pending Plans</p>
                            <h3 class="stat-value">
                                <%= Data ? Data.filter(p => p.Status === 'Pending').length : 0 %>
                            </h3>
                        </div>
                        <i class="bi bi-hourglass-split stat-icon orange"></i>
                    </div>
                </div>
            </div>

            <!-- Plans Table Card -->
            <div class="table-card">
                <div class="table-header">
                    <i class="bi bi-table"></i>
                    <span>All Subscription Plans</span>
                </div>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Plan Title</th>
                                <th>Price</th>
                                <th>Features</th>
                                <th>Status</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(Data && Data.length > 0) { 
                                Data.forEach((plan, index) => { 
                                    // parse features if it's an array, else fallback
                                    let featuresList = [];
                                    if(plan.features && Array.isArray(plan.features)) {
                                        featuresList = plan.features;
                                    } else if(plan.features && typeof plan.features === 'string') {
                                        try {
                                            featuresList = JSON.parse(plan.features);
                                        } catch(e) { featuresList = [plan.features]; }
                                    } else { featuresList = []; }
                            %>
                                <tr>
                                    <td><strong><%= index+1 %></strong></td>
                                    <td class="plan-title"><%= plan.title || 'Untitled' %></td>
                                    <td>
                                        <span class="price-tag"><span class="price-currency">₹</span><%= plan.price || '0' %></span>
                                        <span style="font-size: 11px; color:#64748b;">/ month</span>
                                    </td>
                                    <td>
                                        <div class="features-list">
                                            <% if(featuresList.length) { 
                                                featuresList.forEach(feat => { %>
                                                    <span class="feature-badge"><i class="bi bi-star-fill"></i> <%= feat %></span>
                                            <% }) } else { %>
                                                <span style="color: #94a3b8; font-size:12px;">No features listed</span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/planstatus/<%= plan._id %>/<%= plan.Status %>" class="status-badge <%= plan.Status === 'Active' ? 'active' : (plan.Status === 'Pending' ? 'pending' : 'inactive') %>" style="text-decoration: none;">
                                            <% if(plan.Status === 'Active') { %>
                                                <i class="bi bi-check-circle-fill"></i> Active
                                            <% } else if(plan.Status === 'Pending') { %>
                                                <i class="bi bi-clock-fill"></i> Pending
                                            <% } else { %>
                                                <i class="bi bi-x-circle-fill"></i> <%= plan.Status || 'Inactive' %>
                                            <% } %>
                                        </a>
                                    </td>
                                    <td style="text-align: center;">
                                        <div class="action-buttons">
                                            <!-- Optional edit route - you can link to edit page if needed -->
                                            <a href="/editplan/<%= plan._id %>" class="action-btn edit" title="Edit Plan">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a href="/deleteplan/<%= plan._id %>" class="action-btn delete" onclick="return confirm('Are you sure you want to delete this subscription plan?')" title="Delete Plan">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) 
                            } else { %>
                                <tr>
                                    <td colspan="6">
                                        <div class="empty-state">
                                            <i class="bi bi-journal-x"></i>
                                            <h5>No Subscription Plans Found</h5>
                                            <p>Click "Create New Plan" to add your first pricing plan.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Additional Section: Payment Status Preview (optional but matches original pendingSub.ejs hint) 
                 we embed a second card to show pending user registrations (registerTable) if needed,
                 but to stay consistent with the design style and your routes, we add Payment Status card that shows user plan requests.
                 It matches original requirement: show pending subscriptions from registerTable. -->
            <div style="margin-top: 40px;">
                <div class="table-card">
                    <div class="table-header">
                        <i class="bi bi-credit-card-2-front"></i>
                        <span>Payment & Registration Requests</span>
                    </div>
                    <div class="table-responsive">
                        <table style="min-width: 700px;">
                            <thead>
                                <tr>
                                    <th>Business Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Plan / Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(typeof userDetails !== 'undefined' && userDetails && userDetails.length > 0) { 
                                    userDetails.forEach((user, idx) => { %>
                                    <tr>
                                        <td><strong><%= user.businessName || user.name || 'N/A' %></strong></td>
                                        <td><%= user.email %></td>
                                        <td><%= user.phone || '—' %></td>
                                        <td><%= user.businessType || 'Subscription' %></td>
                                        <td>
                                            <span class="status-badge pending">
                                                <i class="bi bi-hourglass-top"></i> Awaiting Payment
                                            </span>
                                        </td>
                                    </tr>
                                <% }) 
                                } else { %>
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty-state" style="padding: 40px 20px;">
                                                <i class="bi bi-receipt"></i>
                                                <h5>No pending registrations</h5>
                                                <p>All payment requests are up to date.</p>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // optional interactive hover or confirm for status toggle, but handled via href.
    // any extra client-side behavior for consistency.
    document.querySelectorAll('.status-badge').forEach(badge => {
        if(badge.getAttribute('href') && badge.getAttribute('href').includes('/planstatus/')) {
            badge.addEventListener('click', function(e) {
                let confirmMsg = 'Change plan status?';
                if(!confirm(confirmMsg)) e.preventDefault();
            });
        }
    });
</script>
</body>
</html>
