<%- include('../../partials/admin/header.ejs')%>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            background: #f5f7fb;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            overflow-x: hidden;
            width: 100%;
        }

        /* ========= MAIN WRAPPER (flex layout) ========= */
        .main-wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            position: relative;
        }

        /* ========= SIDEBAR (fixed, modern) ========= */
        .main-wrapper .sidebar {
            width: 280px;
            height: 100vh;
            background: linear-gradient(145deg, #ffffff 0%, #fefefe 100%);
            box-shadow: 2px 0 20px rgba(0, 0, 0, 0.03), 1px 0 5px rgba(0, 0, 0, 0.05);
            position: fixed;
            left: 0;
            top: 0;
            overflow-y: auto;
            z-index: 100;
            transition: all 0.3s ease;
            border-right: 1px solid rgba(0,0,0,0.05);
        }

        /* sidebar brand / logo area - Yellow Theme */
        .sidebar-brand {
            padding: 28px 24px;
            border-bottom: 1px solid #edf2f7;
            margin-bottom: 24px;
        }
        .sidebar-brand h3 {
            font-weight: 700;
            font-size: 22px;
            background: linear-gradient(135deg, #3b82f6, #60a5fa);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar-brand h3 i {
            background: none;
            -webkit-background-clip: unset;
            color: #3b82f6;
            font-size: 28px;
        }
        .sidebar-nav {
            list-style: none;
            padding: 0 16px;
        }
        .sidebar-nav li {
            margin-bottom: 8px;
        }
        .sidebar-nav li a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 18px;
            border-radius: 14px;
            color: #334155;
            font-weight: 500;
            font-size: 15px;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .sidebar-nav li a i {
            font-size: 20px;
            width: 26px;
            color: #7e8b9c;
        }
        .sidebar-nav li.active a {
            background: #dbeafe;
            color: #3b82f6;
        }
        .sidebar-nav li.active a i {
            color: #3b82f6;
        }
        .sidebar-nav li a:hover:not(.active) {
            background: #eff6ff;
            color: #2563eb;
        }
        .sidebar-nav li a:hover i {
            color: #3b82f6;
        }

        /* ========= CONTENT WRAPPER ========= */
        .content-wrapper {
            flex: 1;
            margin-left: 280px;
            width: calc(100% - 280px);
            min-height: 100vh;
            background: #f8fafc;
            padding: 0;
            transition: all 0.3s ease;
        }

        /* ========= HEADER (top bar) ========= */
        .top-header {
            background: white;
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eef2f6;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
            flex-wrap: wrap;
            gap: 16px;
        }
        .header-title h1 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }
        .header-title p {
            color: #5b6e8c;
            margin: 4px 0 0;
            font-size: 0.85rem;
        }
        .header-actions {
            display: flex;
            gap: 20px;
            align-items: center;
        }
        .admin-badge {
            background: #f1f5f9;
            padding: 8px 16px;
            border-radius: 40px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
            color: #1e293b;
        }

        /* container */
        .container-fluid {
            padding: 28px 32px;
            max-width: 100%;
        }

        /* Form Card - Yellow Theme */
        .form-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.02);
            border: 1px solid #edf2f7;
            overflow: hidden;
            max-width: 800px;
            margin: 0 auto;
        }
        .form-header {
            padding: 24px 32px;
            border-bottom: 1px solid #eff3f8;
            background: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .form-header i {
            color: #3b82f6;
            font-size: 28px;
        }
        .form-header h2 {
            font-weight: 700;
            font-size: 22px;
            color: #1e293b;
            margin: 0;
        }
        .form-body {
            padding: 32px;
        }
        .form-group {
            margin-bottom: 24px;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            color: #1e293b;
            margin-bottom: 8px;
        }
        .form-group label i {
            color: #3b82f6;
            margin-right: 8px;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            font-size: 14px;
            transition: all 0.2s ease;
            background: #ffffff;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        .form-group input[type="file"] {
            padding: 10px;
            background: #f8fafc;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        /* Star Rating */
        .rating-container {
            display: flex;
            gap: 12px;
            align-items: center;
            padding: 10px 0;
        }
        .star {
            font-size: 32px;
            cursor: pointer;
            color: #cbd5e1;
            transition: all 0.2s ease;
        }
        .star.selected {
            color: #60a5fa;
        }
        .star:hover {
            transform: scale(1.1);
            color: #60a5fa;
        }
        .rating-label {
            margin-left: 16px;
            font-size: 14px;
            color: #64748b;
        }
        .btn-submit {
            width: 100%;
            padding: 14px;
            background: #3b82f6;
            color: white;
            border: none;
            border-radius: 40px;
            font-weight: 600;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s ease;
            margin-top: 16px;
            cursor: pointer;
        }
        .btn-submit:hover {
            background: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(59, 130, 246, 0.25);
        }
        .btn-submit i {
            font-size: 18px;
        }
        .required-star {
            color: #dc2626;
            margin-left: 4px;
        }
        .current-image {
            margin-top: 12px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .current-image img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
        }
        .current-image span {
            font-size: 13px;
            color: #64748b;
        }
        .preview-image {
            margin-top: 12px;
            display: none;
        }
        .preview-image img {
            max-width: 120px;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            padding: 4px;
        }
        .helper-text {
            font-size: 12px;
            color: #94a3b8;
            margin-top: 6px;
        }
        @media (max-width: 768px) {
            .main-wrapper { flex-direction: column; }
            .sidebar { width: 100% !important; height: auto !important; position: relative; margin-bottom: 0; }
            .content-wrapper { margin-left: 0 !important; width: 100%; }
            .container-fluid { padding: 16px; }
            .form-body { padding: 20px; }
            .form-row { grid-template-columns: 1fr; gap: 16px; }
            .top-header { padding: 16px 20px; }
        }
    </style>
</head>
<body>

<div class="main-wrapper">
    <!-- ========== SIDEBAR ========== -->
     <%- include('../../partials/admin/left.ejs')%>

    <!-- ========== CONTENT WRAPPER ========== -->
    <div class="content-wrapper">
        <!-- TOP HEADER -->
        <div class="top-header">
            <div class="header-title">
                <h1><i class="bi bi-pencil-square me-2" style="color:#3b82f6;"></i> Edit Product</h1>
                <p>Update product information in your inventory</p>
            </div>
            <div class="header-actions">
                
                <a href="/producttable" class="admin-badge" style="text-decoration: none;">
                    <i class="bi bi-arrow-left"></i> Back to Products
                </a>
            </div>
        </div>

        <div class="container-fluid">
            <div class="form-card">
                <div class="form-header">
                    <i class="bi bi-pencil-square"></i>
                    <h2>Edit Product Information</h2>
                </div>
                <div class="form-body">
                    <form action="/editproduct/<%= product._id %>" method="POST" enctype="multipart/form-data" id="productForm">
                        <div class="form-row">
                            <div class="form-group">
                                <label><i class="bi bi-tag"></i> Product Name <span class="required-star">*</span></label>
                                <input type="text" name="name" value="<%= product.name %>" required>
                            </div>
                            <div class="form-group">
                                <label><i class="bi bi-currency-dollar"></i> Price <span class="required-star">*</span></label>
                                <input type="number" name="price" step="0.01" value="<%= product.price %>" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label><i class="bi bi-image"></i> Product Image</label>
                                <input type="file" name="img" accept="image/*" onchange="previewImage(this)">
                                <div class="current-image">
                                    <img src="upload/<%= product.image %>" alt="Current Image" onerror="this.src='https://placehold.co/60x60?text=No+Image'">
                                    <span>Current image: <%= product.image %></span>
                                </div>
                                <div class="preview-image" id="imagePreview">
                                    <img id="previewImg" src="#" alt="Preview">
                                    <span class="helper-text">New image preview</span>
                                </div>
                                <div class="helper-text">Leave empty to keep current image</div>
                            </div>
                            <div class="form-group">
                                <label><i class="bi bi-boxes"></i> Stock Quantity</label>
                                <input type="number" name="stock" value="<%= product.stock %>">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label><i class="bi bi-info-circle"></i> Stock Status</label>
                                <select name="status">
                                    <option value="In Stock" <%= product.status === 'In Stock' ? 'selected' : '' %>>In Stock</option>
                                    <option value="Low Stock" <%= product.status === 'Low Stock' ? 'selected' : '' %>>Low Stock</option>
                                    <option value="Out of Stock" <%= product.status === 'Out of Stock' ? 'selected' : '' %>>Out of Stock</option>
                                    <option value="Limited Stock" <%= product.status === 'Limited Stock' ? 'selected' : '' %>>Limited Stock</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label><i class="bi bi-check-circle"></i> Active Status</label>
                                <select name="activeStatus">
                                    <option value="Pending" <%= product.activeStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="Active" <%= product.activeStatus === 'Active' ? 'selected' : '' %>>Active</option>
                                    <option value="Inactive" <%= product.activeStatus === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                                </select>
                                <div class="helper-text">Set product visibility status</div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label><i class="bi bi-chat-text"></i> Number of Reviews</label>
                                <input type="number" name="numReviews" value="<%= product.numReviews %>">
                            </div>
                            <div class="form-group">
                                <label><i class="bi bi-star-fill"></i> Product Rating <span class="required-star">*</span></label>
                                <div class="rating-container" id="rating">
                                    <span class="star" data-value="1">★</span>
                                    <span class="star" data-value="2">★</span>
                                    <span class="star" data-value="3">★</span>
                                    <span class="star" data-value="4">★</span>
                                    <span class="star" data-value="5">★</span>
                                    <span class="rating-label" id="ratingLabel">Click a star to rate</span>
                                </div>
                                <input type="hidden" name="rating" id="ratingValue" value="<%= product.rating %>" required>
                                <div class="helper-text">Select rating from 1 to 5 stars</div>
                            </div>
                        </div>

                        <button type="submit" class="btn-submit">
                            <i class="bi bi-save"></i> Update Product
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const stars = document.querySelectorAll('.star');
    const ratingValue = document.getElementById('ratingValue');
    const ratingLabel = document.getElementById('ratingLabel');
    const currentRating = parseInt(ratingValue.value) || 0;

    function initStars() {
        if(currentRating > 0) {
            const ratingTexts = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
            ratingLabel.innerHTML = ratingTexts[currentRating] + ' (' + currentRating + '/5)';
            ratingLabel.style.color = '#3b82f6';
            ratingLabel.style.fontWeight = 'bold';
            
            stars.forEach((star, index) => {
                if(index < currentRating) {
                    star.classList.add('selected');
                }
            });
        }
    }

    stars.forEach(star => {
        star.addEventListener('click', function() {
            let val = parseInt(this.getAttribute('data-value'));
            ratingValue.value = val;

            const ratingTexts = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
            ratingLabel.innerHTML = ratingTexts[val] + ' (' + val + '/5)';
            ratingLabel.style.color = '#3b82f6';
            ratingLabel.style.fontWeight = 'bold';

            stars.forEach((s, index) => {
                if(index < val) {
                    s.classList.add('selected');
                } else {
                    s.classList.remove('selected');
                }
            });
        });

        star.addEventListener('mouseenter', function() {
            let val = parseInt(this.getAttribute('data-value'));
            stars.forEach((s, index) => {
                if(index < val) {
                    s.style.color = '#60a5fa';
                } else {
                    s.style.color = '#cbd5e1';
                }
            });
        });

        star.addEventListener('mouseleave', function() {
            let currentVal = parseInt(ratingValue.value) || 0;
            stars.forEach((s, index) => {
                if(currentVal > 0 && index < currentVal) {
                    s.style.color = '#60a5fa';
                } else {
                    s.style.color = '#cbd5e1';
                }
            });
        });
    });

    function previewImage(input) {
        const preview = document.getElementById('imagePreview');
        const previewImg = document.getElementById('previewImg');
        
        if(input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                preview.style.display = 'block';
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.style.display = 'none';
            previewImg.src = '#';
        }
    }

    document.getElementById('productForm').addEventListener('submit', function(e) {
        const rating = document.getElementById('ratingValue').value;
        if(!rating || rating === '') {
            e.preventDefault();
            alert('Please select a rating for the product (1-5 stars)');
            return false;
        }
    });

    initStars();
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>